<div class="row" style="justify-content:space-between;padding-top:14px"><span>{{ 'echo.common.subtotal' | t }}</span><span>{% render 'echo-money', price: cart.items_subtotal_price %}</span></div>
{%- for d in cart.cart_level_discount_applications -%}
  <div class="row" style="justify-content:space-between;padding-top:6px">{%- assign d_title = d.title | escape -%}<span>{{ 'echo.cart.discount_named_html' | t: title: d_title }}</span><span>−{% render 'echo-money', price: d.total_allocated_amount %}</span></div>
{%- endfor -%}
<div class="row" style="justify-content:space-between;padding-top:6px"><span>{{ 'echo.sum_rows.delivery' | t }}</span><span>{{ 'echo.sum_rows.free' | t }}</span></div>
<div class="row" style="justify-content:space-between;padding-top:6px;font-weight:600"><span>{{ 'echo.common.total_incl_vat' | t }}</span><span>{% render 'echo-money', price: cart.total_price %}</span></div>
