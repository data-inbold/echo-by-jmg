{%- comment -%} Breadcrumbs. Pass pairs as "Label::url||Label::url||Current". inline: true leaves out the page wrapper {%- endcomment -%}
{%- assign items = list | split: '||' -%}
<nav class="crumbs{% unless inline %} wrap{% endunless %}" aria-label="{{ 'echo.crumbs.breadcrumb' | t | escape }}">
  {%- for it in items -%}
    {%- assign pr = it | split: '::' -%}
    {%- if forloop.last -%}<span>{{ pr[0] }}</span>{%- else -%}<a href="{{ pr[1] }}">{{ pr[0] }}</a><span class="crumb-sep" aria-hidden="true">/</span>{% endif -%}
  {%- endfor -%}
</nav>
