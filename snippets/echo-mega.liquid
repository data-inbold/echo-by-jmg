{%- comment -%}
  Mega dropdown for one header menu item: an Editions column, a Shop by category column with small icons,
  and a "Latest Design" photo card. Params: s (the header section settings), idx (panel number)
{%- endcomment -%}
{%- liquid
  capture u_all
    render 'echo-url', key: 'shop-all'
  endcapture
  capture u_sets
    render 'echo-url', key: 'sets'
  endcapture
  capture u_happy
    render 'echo-url', key: 'happy-habitat'
  endcapture
  capture u_last
    render 'echo-url', key: 'last-pieces'
  endcapture
  capture u_xmas
    render 'echo-url', key: 'xmas'
  endcapture
  capture u_gc
    render 'echo-url', key: 'gift-card'
  endcapture
  assign card_link = s.mega_card_link
  if card_link == blank
    assign card_link = u_all
  endif
-%}
<div class="mega" data-panel="dd-{{ idx }}" hidden>
  <div class="wrap mm">
    <div class="mm-col">
      <h4>{{ 'echo.header.editions' | t }}</h4>
      <a href="{{ u_xmas }}">{{ 'echo.header.xmas' | t }}</a>
      <a href="{{ u_sets }}">{{ 'echo.header.pillow_talk_sets' | t }}</a>
      <a href="{{ u_happy }}">{{ 'echo.header.happy_habitat' | t }}</a>
      {%- comment -%}Last pieces hidden for now{%- endcomment -%}
      <a href="{{ u_gc }}">{{ 'echo.common.gift_card' | t }}</a>
      <a class="mm-all" href="{{ u_all }}">{{ 'echo.common.shop_all' | t }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
    </div>
    <div class="mm-col">
      <h4>{{ 'echo.header.shop_by_category' | t }}</h4>
      {%- assign cat_keys = 'blankets,cushions,bags,accessories' | split: ',' -%}
      {%- for key in cat_keys -%}
        {%- liquid
          case key
            when 'blankets'
              assign col = settings.echo_col_blankets
              assign nm = 'echo.common.blankets' | t
            when 'cushions'
              assign col = settings.echo_col_cushions
              assign nm = 'echo.common.cushion_covers' | t
            when 'bags'
              assign col = settings.echo_col_bags
              assign nm = 'echo.common.bags' | t
            else
              assign col = settings.echo_col_accessories
              assign nm = 'echo.common.accessories' | t
          endcase
          capture curl
            render 'echo-url', key: key
          endcapture
          if col != blank
            assign curl = col.url
            assign nm = col.title
          endif
        -%}
        <a class="mm-cat" href="{{ curl }}" data-k="{{ key }}">
          {%- assign icon_file = 'echo-cat-' | append: key | append: '.svg' -%}<img src="{{ icon_file | asset_url }}" alt="" width="28" height="28" loading="lazy">
          <span>{{ nm }}</span>
        </a>
      {%- endfor -%}
    </div>
    <a class="mm-card" href="{{ card_link }}">
      {%- if s.mega_card_image != blank -%}
        {{ s.mega_card_image | image_url: width: 1440 | image_tag: alt: s.mega_card_title, loading: 'lazy', widths: "480, 960, 1440", sizes: "480px" }}
      {%- else -%}
        <img src="{{ 'echo-fg-hero-knit.jpg' | asset_url }}" alt="{{ s.mega_card_title | escape }}" width="480" height="232" loading="lazy">
      {%- endif -%}
      {%- for key in cat_keys -%}
        {%- liquid
          case key
            when 'blankets'
              assign timg = s.tile_blankets
              assign tfb = 'echo-fg-mega-blankets.jpg'
            when 'cushions'
              assign timg = s.tile_cushions
              assign tfb = 'echo-v2-tile-cushions.jpg'
            when 'bags'
              assign timg = s.tile_bags
              assign tfb = 'echo-v2-tile-bags.jpg'
            else
              assign timg = s.tile_accessories
              assign tfb = 'echo-v2-tile-accessories.jpg'
          endcase
        -%}
        <span class="mm-swap" data-k="{{ key }}" aria-hidden="true">
          {%- if timg != blank -%}{{ timg | image_url: width: 960 | image_tag: alt: '', loading: 'lazy' }}{%- else -%}<img src="{{ tfb | asset_url }}" alt="" width="480" height="232" loading="lazy">{%- endif -%}
        </span>
      {%- endfor -%}
      {%- assign mcl = s.mega_card_label -%}{%- if mcl == blank -%}{%- assign mcl = 'echo.header.latest_design' | t -%}{%- endif -%}
      <span class="mm-card-label">{{ mcl }}</span>
      <span class="mm-card-foot"><span class="mm-card-title">{{ s.mega_card_title }}</span><span class="mm-card-go">{{ 'echo.header.view_products' | t }}</span></span>
    </a>
  </div>
</div>
