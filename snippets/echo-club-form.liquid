{%- comment -%} Cozy Club sign-up (Shopify customer newsletter form). Param: k (unique id) {%- endcomment -%}
{%- assign fid = 'club-form-' | append: k -%}
{%- form 'customer', class: 'inline-form', id: fid -%}
  {%- if form.posted_successfully? -%}
    <div class="ok" role="status" style="color:var(--ink);flex:1 1 100%">{{ 'echo.club_form.welcome_to_the_cozy_club_your_10_code' | t }}</div>
  {%- else -%}
    <input type="hidden" name="contact[tags]" value="newsletter,cozy-club">
    <label class="visually-hidden" for="club-{{ k }}">{{ 'echo.common.email' | t }}</label>
    <input id="club-{{ k }}" type="email" name="contact[email]" required placeholder="{{ 'echo.common.your_email' | t | escape }}" autocomplete="email">
    <button class="btn" type="submit">{{ 'echo.club_form.join' | t }}</button>
    {%- if form.errors -%}<span class="err" style="flex:1 1 100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>{%- endif -%}
  {%- endif -%}
{%- endform -%}
