{%- comment -%} Used by reset password and activate account templates. {%- endcomment -%}
<section class="section tight"><div class="wrap" style="max-width:560px">
  {%- if template.name == 'activate_account' -%}
    {%- form 'activate_customer_password', class: 'stack', style: 'gap:14px' -%}
      <h1 class="h2">Activate your account</h1>
      {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="p1">Password</label><input id="p1" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="p2">Confirm password</label><input id="p2" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn" type="submit" name="activate">Activate account</button>
    {%- endform -%}
  {%- else -%}
    {%- form 'reset_customer_password', class: 'stack', style: 'gap:14px' -%}
      <h1 class="h2">Choose a new password</h1>
      {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="p1">Password</label><input id="p1" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="p2">Confirm password</label><input id="p2" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn" type="submit">Save password</button>
    {%- endform -%}
  {%- endif -%}
</div></section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
