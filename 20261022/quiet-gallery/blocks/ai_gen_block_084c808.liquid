{% doc %}
  @prompt
    Create a custom JavaScript snippet block that implements lazy loading for all HTML5 video elements on the page using the Intersection Observer API. The script should: find all video elements that have a data-src attribute, observe them with IntersectionObserver, and when a video enters the viewport, set its src from data-src and call load(). Also include a fallback that adds loading="lazy" to any video elements with a regular src attribute for browsers that support it natively. The block should have no visible output — it only adds the script to improve mobile page speed by deferring video loading until needed.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-lazy-loader-{{ ai_gen_id }} {
    display: block;
  }
{% endstyle %}

<video-lazy-loader-{{ ai_gen_id }} class="ai-video-lazy-loader-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
</video-lazy-loader-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoLazyLoader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.observerOptions = {
          root: null,
          rootMargin: '{{ block.settings.load_margin }}px',
          threshold: 0
        };
      }

      connectedCallback() {
        if ('IntersectionObserver' in window) {
          this.initIntersectionObserver();
        } else {
          this.loadAllVideos();
        }
        
        this.applyNativeLazyLoading();
      }

      initIntersectionObserver() {
        const videos = document.querySelectorAll('video[data-src]');
        
        if (videos.length === 0) return;

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const video = entry.target;
              this.loadVideo(video);
              obs.unobserve(video);
            }
          });
        }, this.observerOptions);

        videos.forEach(video => {
          observer.observe(video);
        });
      }

      loadVideo(video) {
        const dataSrc = video.getAttribute('data-src');
        
        if (!dataSrc) return;

        const sources = video.querySelectorAll('source[data-src]');
        
        sources.forEach(source => {
          const sourceDataSrc = source.getAttribute('data-src');
          if (sourceDataSrc) {
            source.setAttribute('src', sourceDataSrc);
            source.removeAttribute('data-src');
          }
        });

        if (sources.length === 0) {
          video.setAttribute('src', dataSrc);
        }
        
        video.removeAttribute('data-src');
        video.load();

        if (video.hasAttribute('data-autoplay')) {
          video.play().catch(() => {});
        }
      }

      loadAllVideos() {
        const videos = document.querySelectorAll('video[data-src]');
        videos.forEach(video => this.loadVideo(video));
      }

      applyNativeLazyLoading() {
        if (!('loading' in HTMLVideoElement.prototype)) return;

        const videos = document.querySelectorAll('video[src]:not([loading])');
        
        videos.forEach(video => {
          if (!video.hasAttribute('data-src')) {
            video.setAttribute('loading', 'lazy');
          }
        });
      }
    }

    customElements.define('video-lazy-loader-{{ ai_gen_id }}', VideoLazyLoader{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video lazy loader",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Performance settings"
    },
    {
      "type": "paragraph",
      "content": "This block improves page speed by lazy loading videos. Videos with data-src will load when they enter the viewport. Videos with regular src get native lazy loading if supported."
    },
    {
      "type": "range",
      "id": "load_margin",
      "label": "Load margin",
      "min": 0,
      "max": 500,
      "step": 50,
      "unit": "px",
      "default": 200,
      "info": "Distance before viewport when videos start loading"
    }
  ],
  "presets": [
    {
      "name": "Video lazy loader"
    }
  ]
}
{% endschema %}