{%- comment -%}
  Prints a price the way the design shows it: "DKK 2,150".
  Whole amounts get thousands separators and no decimals; other amounts fall back to the store money format.
{%- endcomment -%}
{%- liquid
  assign cents = price | default: 0
  assign rem = cents | modulo: 100
  if rem != 0
    echo cents | money_with_currency
  else
    assign whole = cents | divided_by: 100
    if whole >= 1000
      assign th = whole | divided_by: 1000
      assign low = whole | modulo: 1000 | prepend: '00' | slice: -3, 3
      assign num = th | append: ',' | append: low
    else
      assign num = whole
    endif
    echo cart.currency.iso_code | append: ' ' | append: num
  endif
-%}
