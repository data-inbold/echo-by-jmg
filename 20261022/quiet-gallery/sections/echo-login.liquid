{%- capture u_home -%}{%- render 'echo-url', key: 'home' -%}{%- endcapture -%}
{%- assign cl = 'Home::' | append: u_home | append: '||Account' -%}
{%- render 'echo-crumbs', list: cl -%}
<section class="section tight"><div class="wrap grid g2" style="align-items:start">
  <div>
    <div id="login-box">
      {%- form 'customer_login', class: 'stack', style: 'gap:14px' -%}
        <h1 class="h2">Log in</h1>
        {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="l-email">Email</label><input id="l-email" type="email" name="customer[email]" required autocomplete="email"></div>
        <div class="field"><label for="l-pw">Password</label><input id="l-pw" type="password" name="customer[password]" required autocomplete="current-password"></div>
        <button class="btn" type="submit">Log in</button>
        <a class="link" style="align-self:flex-start" href="#recover">Forgot your password?</a>
      {%- endform -%}
    </div>
    <div id="recover" style="margin-top:40px">
      {%- form 'recover_customer_password', class: 'stack', style: 'gap:14px' -%}
        <h2 class="h2">Reset your password</h2>
        {%- if form.posted_successfully? -%}
          <div class="ok" role="status">If the email has an account, a reset link is on its way.</div>
        {%- else -%}
          <p class="muted" style="margin:0">We will email you a link to choose a new password.</p>
          {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label for="rs-email">Email</label><input id="rs-email" type="email" name="email" required autocomplete="email"></div>
          <button class="btn" type="submit">Send link</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
  <div class="review stack" style="gap:12px;padding:28px"><h2 class="h3">New here?</h2><p class="muted" style="margin:0">Create an account to see your orders, start returns and keep your Yarn Passports in one place. You can also check out as a guest.</p><div><a class="btn ghost" href="{{ routes.account_register_url }}">Create account</a></div></div>
</div></section>
{% schema %}
{ "name": "Log in", "settings": [] }
{% endschema %}
