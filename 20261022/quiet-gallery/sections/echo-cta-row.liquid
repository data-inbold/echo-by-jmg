{%- capture echo_out -%}
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap row" style="justify-content:space-between">
    <h2 class="h3" style="margin:0">{{ section.settings.heading }}</h2>
    <div class="row">
      {%- if section.settings.btn1_label != blank -%}<a class="btn" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a class="btn ghost" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Call to action row",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Black"}], "default": "paper"},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every edition, open or closed." },
    { "type": "text", "id": "btn1_label", "label": "Button 1", "default": "See open editions" },
    { "type": "text", "id": "btn1_link", "label": "Button 1 link", "default": "echo:open" },
    { "type": "text", "id": "btn2_label", "label": "Button 2", "default": "Rescued yarn tracker" },
    { "type": "text", "id": "btn2_link", "label": "Button 2 link", "default": "echo:tracker" }
  ],
  "presets": [{ "name": "Call to action row" }]
}
{% endschema %}
