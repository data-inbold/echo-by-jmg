{% comment %}
  Yarn Passport block for the Order confirmation email.
  Design: Figma "yarn passport" node 728:3183.
  Replaces the previous passport block in
  Settings > Notifications > Order confirmation > Edit code.

  BEFORE PASTING: upload the 4 PNGs in docs/emails/img (pillow, knit, swirl-top, swirl-bottom) to Shopify > Content > Files (keep the file names).
  PNG is used because Gmail/Outlook do not render SVG.
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400&family=Literata:wght@400&display=swap" rel="stylesheet">
{% assign yp_made_by = 'JM Group knitwear factory' %}

{% for line in line_items %}
  {% if line.product.metafields.custom.yp_batch_id != blank %}
<table class="row section">
  <tr>
    <td class="section__cell">
      <center>
        <table class="container">
          <tr>
            <td align="center" style="padding:24px 0;">

              <!-- beige frame: swirls sit flush against its edges -->
              <table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" bgcolor="#E5DED5" style="max-width:540px;width:100%;background:#E5DED5;">
                <tr><td align="center" style="padding:0;">

              <!-- top: pillow (centre) + blue swirl (right) -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:540px;width:100%;">
                <tr>
                  <td width="30%" style="font-size:0;line-height:0;">&nbsp;</td>
                  <td width="40%" align="center" valign="top" style="padding-top:40px;font-size:0;line-height:0;">
                    <img src="{{ 'yarn-passport-pillow.png' | file_url }}" width="60" height="60" alt="" style="display:block;border:0;margin:0 auto;">
                  </td>
                  <td width="30%" align="right" valign="top" style="font-size:0;line-height:0;">
                    <img src="{{ 'yarn-passport-swirl-top.png' | file_url }}" width="165" alt="" style="display:block;border:0;margin:0 0 0 auto;max-width:100%;height:auto;">
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding:0 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:476px;width:100%;border-collapse:collapse;">
                <tr>
                  <td width="50%" valign="top" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Product</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:20px;line-height:1.2;color:#000000;text-align:left;">{{ line.product.title }}</p>
                  </td>
                  <td width="50%" valign="top" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Color</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:normal;color:#7c7e64;text-align:left;">{{ line.product.metafields.custom.yp_colourway | default: '&nbsp;' }}</p>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Origin</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:normal;color:#7c7e64;text-align:left;">{{ line.product.metafields.custom.yp_origin }}</p>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Fibre</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:normal;color:#7c7e64;text-align:left;">{{ line.product.metafields.custom.yp_fibre }}</p>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Batch</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:normal;color:#7c7e64;text-align:left;">{{ line.product.metafields.custom.yp_batch_id }}{% if line.product.metafields.custom.yp_kg != blank %} - {{ line.product.metafields.custom.yp_kg }} kg rescued{% endif %}</p>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="border:1px solid #380f1c;padding:4px 12px 20px 8px;">
                    <p style="margin:0 0 12px;font-family:Literata,Georgia,'Times New Roman',serif;font-weight:400;font-size:12px;line-height:normal;text-transform:uppercase;color:#380f1c;text-align:left;">Made</p>
                    <p style="margin:0;font-family:Manrope,'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:normal;color:#7c7e64;text-align:left;">{{ yp_made_by }}</p>
                  </td>
                </tr>
              </table>
              </td></tr></table>

              <!-- bottom: blue swirl (left) + knitting icon (centre) -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:540px;width:100%;">
                <tr>
                  <td width="36%" align="left" valign="top" style="font-size:0;line-height:0;">
                    <img src="{{ 'yarn-passport-swirl-bottom.png' | file_url }}" width="195" alt="" style="display:block;border:0;max-width:100%;height:auto;">
                  </td>
                  <td width="28%" align="center" valign="top" style="padding-top:25px;font-size:0;line-height:0;">
                    <img src="{{ 'yarn-passport-knit.png' | file_url }}" width="64" height="68" alt="" style="display:block;border:0;margin:0 auto;">
                  </td>
                  <td width="36%" style="font-size:0;line-height:0;">&nbsp;</td>
                </tr>
              </table>

                </td></tr>
              </table>

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>
  {% endif %}
{% endfor %}
