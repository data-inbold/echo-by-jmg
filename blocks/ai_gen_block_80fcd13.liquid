{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    display: block;
  }

  .ai-hero-banner-desktop-{{ ai_gen_id }} {
    display: none;
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
  }

  .ai-hero-banner-mobile-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: {{ block.settings.mobile_height }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-banner-desktop-{{ ai_gen_id }} {
      display: block;
    }
    .ai-hero-banner-mobile-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-hero-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .ai-hero-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-hero-slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-overlay-desktop-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      {{ block.settings.desktop_gradient_direction }},
      rgba(0, 0, 0, {{ block.settings.desktop_gradient_opacity | divided_by: 100.0 }}),
      transparent
    );
    pointer-events: none;
  }

  .ai-hero-overlay-mobile-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      {{ block.settings.mobile_gradient_direction }},
      rgba(0, 0, 0, {{ block.settings.mobile_gradient_opacity | divided_by: 100.0 }}),
      transparent
    );
    pointer-events: none;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    {% if block.settings.desktop_vertical_alignment == 'top' %}
      justify-content: flex-start;
      padding-top: 40px;
    {% elsif block.settings.desktop_vertical_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
      padding-bottom: 40px;
    {% endif %}
    {% if block.settings.desktop_horizontal_alignment == 'left' %}
      align-items: flex-start;
      text-align: left;
      padding-left: 40px;
    {% elsif block.settings.desktop_horizontal_alignment == 'center' %}
      align-items: center;
      text-align: center;
    {% else %}
      align-items: flex-end;
      text-align: right;
      padding-right: 40px;
    {% endif %}
    padding-left: max(40px, env(safe-area-inset-left));
    padding-right: max(40px, env(safe-area-inset-right));
    z-index: 2;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    max-width: 800px;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    max-width: 600px;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .ai-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-hero-nav-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0;
    z-index: 3;
    background: transparent;
  }

  .ai-hero-nav-arrow-{{ ai_gen_id }} {
    color: #ffffff;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    transition: opacity 0.3s ease;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
  }

  .ai-hero-nav-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-hero-nav-arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: #ffffff;
    stroke-width: 2;
  }

  .ai-hero-nav-page-{{ ai_gen_id }} {
    color: #ffffff;
    background: transparent;
  }

  .ai-hero-mobile-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    {% if block.settings.mobile_vertical_alignment == 'top' %}
      justify-content: flex-start;
      padding-top: 20px;
    {% elsif block.settings.mobile_vertical_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
      padding-bottom: 20px;
    {% endif %}
    {% if block.settings.mobile_horizontal_alignment == 'left' %}
      align-items: flex-start;
      text-align: left;
      padding-left: 20px;
    {% elsif block.settings.mobile_horizontal_alignment == 'center' %}
      align-items: center;
      text-align: center;
    {% else %}
      align-items: flex-end;
      text-align: right;
      padding-right: 20px;
    {% endif %}
    padding-left: max(20px, env(safe-area-inset-left));
    padding-right: max(20px, env(safe-area-inset-right));
    z-index: 2;
  }

  .ai-hero-mobile-heading-{{ ai_gen_id }} {
    color: {{ block.settings.mobile_text_color }};
    margin: 0 0 16px;
  }

  .ai-hero-mobile-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.mobile_text_color }};
    margin: 0 0 24px;
  }

  .ai-hero-mobile-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.mobile_button_background }};
    color: {{ block.settings.mobile_button_text_color }};
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .ai-hero-mobile-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.mobile_button_hover_background }};
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<hero-banner-{{ ai_gen_id }} class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner-desktop-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_image_key = 'slide_' | append: i | append: '_image'
        assign slide_heading_key = 'slide_' | append: i | append: '_heading'
        assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
        assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
        assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign slide_image = block.settings[slide_image_key]
        assign slide_heading = block.settings[slide_heading_key]
        assign slide_subheading = block.settings[slide_subheading_key]
        assign slide_button_text = block.settings[slide_button_text_key]
        assign slide_button_link = block.settings[slide_button_link_key]
      %}

      {% if slide_enabled %}
        <div class="ai-hero-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ i }}">
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-hero-slide-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-hero-slide-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.enable_desktop_gradient %}
            <div class="ai-hero-overlay-desktop-{{ ai_gen_id }}"></div>
          {% endif %}

          <div class="ai-hero-content-{{ ai_gen_id }}">
            {% if slide_heading != blank %}
              <h1 class="ai-hero-heading-{{ ai_gen_id }} {{ block.settings.heading_font }}">
                {{ slide_heading }}
              </h1>
            {% endif %}

            {% if slide_subheading != blank %}
              <p class="ai-hero-subheading-{{ ai_gen_id }} {{ block.settings.subheading_font }}">
                {{ slide_subheading }}
              </p>
            {% endif %}

            {% if slide_button_text != blank and slide_button_link != blank %}
              <a href="{{ slide_button_link }}" class="ai-hero-button-{{ ai_gen_id }} {{ block.settings.button_font }}">
                {{ slide_button_text }}
              </a>
            {% endif %}
          </div>

          {% if forloop.first and slide_image == blank %}
            <div class="ai-hero-empty-state-{{ ai_gen_id }}">
              Add a hero image for slide {{ i }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% assign enabled_slides = 0 %}
    {% for i in (1..3) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        if block.settings[slide_enabled_key]
          assign enabled_slides = enabled_slides | plus: 1
        endif
      %}
    {% endfor %}

    {% if enabled_slides > 1 %}
      <div class="ai-hero-nav-{{ ai_gen_id }}">
        <button class="ai-hero-nav-arrow-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span class="ai-hero-nav-page-{{ ai_gen_id }}"></span>
        </button>
        <button class="ai-hero-nav-arrow-{{ ai_gen_id }}" data-direction="next" aria-label="Next slide">
          <span class="ai-hero-nav-page-{{ ai_gen_id }}"></span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-banner-mobile-{{ ai_gen_id }}">
    {% if block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.mobile_image.width }}"
        height="{{ block.settings.mobile_image.height }}"
        class="ai-hero-slide-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-slide-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.enable_mobile_gradient %}
      <div class="ai-hero-overlay-mobile-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-hero-mobile-content-{{ ai_gen_id }}">
      {% if block.settings.mobile_heading != blank %}
        <h2 class="ai-hero-mobile-heading-{{ ai_gen_id }} {{ block.settings.mobile_heading_font }}">
          {{ block.settings.mobile_heading }}
        </h2>
      {% endif %}

      {% if block.settings.mobile_subheading != blank %}
        <p class="ai-hero-mobile-subheading-{{ ai_gen_id }} {{ block.settings.mobile_subheading_font }}">
          {{ block.settings.mobile_subheading }}
        </p>
      {% endif %}

      {% if block.settings.mobile_button_text != blank and block.settings.mobile_button_link != blank %}
        <a href="{{ block.settings.mobile_button_link }}" class="ai-hero-mobile-button-{{ ai_gen_id }} {{ block.settings.mobile_button_font }}">
          {{ block.settings.mobile_button_text }}
        </a>
      {% endif %}
    </div>

    {% if block.settings.mobile_image == blank %}
      <div class="ai-hero-empty-state-{{ ai_gen_id }}">
        Add a mobile hero image
      </div>
    {% endif %}
  </div>
</hero-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-hero-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        this.pageNumbers = this.querySelectorAll('.ai-hero-nav-page-{{ ai_gen_id }}');

        if (this.slides.length <= 1) return;

        this.updatePageNumbers();

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }

        {% if block.settings.enable_autoplay %}
          this.startAutoplay();
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        {% endif %}
      }

      navigate(direction) {
        this.slides[this.currentSlide].classList.remove('active');

        if (direction === 'next') {
          this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        } else {
          this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        }

        this.slides[this.currentSlide].classList.add('active');
        this.updatePageNumbers();
      }

      updatePageNumbers() {
        const totalSlides = this.slides.length;
        const currentPage = this.currentSlide + 1;
        
        if (this.pageNumbers.length === 2) {
          const prevPage = this.currentSlide === 0 ? totalSlides : this.currentSlide;
          const nextPage = this.currentSlide === totalSlides - 1 ? 1 : this.currentSlide + 2;
          
          this.pageNumbers[0].textContent = prevPage;
          this.pageNumbers[1].textContent = nextPage;
        }
      }

      startAutoplay() {
        if (this.slides.length <= 1) return;
        this.autoplayInterval = setInterval(() => {
          this.navigate('next');
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('hero-banner-{{ ai_gen_id }}', HeroBanner{{ ai_gen_id }});
  })();
</script>

