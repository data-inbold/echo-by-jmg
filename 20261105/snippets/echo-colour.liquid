{%- comment -%}
  Returns "hex|family|Label" for a colour key (handle form, e.g. "vertiver-green").
  Families drive the colour filter chips: green, neutral, blue, black, bright, pink.
  Add new colours here when new editions launch.
{%- endcomment -%}
{%- liquid
  assign k = key | handle
  case k
    when 'oat'
      echo '#D8CCB4|neutral|Oat'
    when 'vertiver-green', 'vetiver-green'
      echo '#6E7559|green|Vetiver green'
    when 'doe'
      echo '#B59C82|neutral|Doe'
    when 'creamy'
      echo '#EDE6D8|neutral|Creamy'
    when 'linen'
      echo '#D9CFC0|neutral|Linen'
    when 'black'
      echo '#2A2826|black|Black'
    when 'cloud'
      echo '#E9E6E1|neutral|Cloud'
    when 'smoky-mauve'
      echo '#B89AA6|pink|Smoky mauve'
    when 'pale-blue'
      echo '#A9C0DA|blue|Pale blue'
    when 'violet-blue', 'blue'
      echo '#4A55A2|blue|Violet blue'
    when 'chiffon'
      echo '#EFE3C8|neutral|Chiffon'
    when 'bottle-green'
      echo '#2F5A44|green|Bottle green'
    when 'dk-royal', 'dark-royal'
      echo '#2F4A8F|blue|Dark royal'
    when 'tomato'
      echo '#D2533C|bright|Tomato'
    when 'egg-yolk'
      echo '#E8B739|bright|Egg yolk'
    when 'pumpkin'
      echo '#D88A4A|bright|Pumpkin'
    when 'blueberry'
      echo '#3E4E86|blue|Blueberry'
    when 'olive'
      echo '#7A7A45|green|Olive'
    when 'seaweed'
      echo '#4E6B57|green|Seaweed'
    when 'ash'
      echo '#9B9790|neutral|Ash'
    when 'forest'
      echo '#2F5A44|green|Forest'
    when 'red'
      echo '#B5352F|bright|Red'
    when 'fennel'
      echo '#A8B07A|green|Fennel'
    when 'candy-pink'
      echo '#E7A9BD|pink|Candy pink'
    when 'after-rain'
      echo '#8FA6B8|blue|After rain'
    when 'before-rain'
      echo '#7C7F86|neutral|Before rain'
    when 'rainbow'
      echo '#E0763C|bright|Rainbow'
    when 'ginger'
      echo '#C7793F|bright|Ginger'
    when 'pale-rose'
      echo '#E3B3AE|pink|Pale rose'
    when 'chestnut'
      echo '#8A5A3C|neutral|Chestnut'
    when 'vintage-blue'
      echo '#5B7A9E|blue|Vintage blue'
    when 'digital', ''
      echo '#D8CCB4|neutral|'
    else
      assign words = k | split: '-'
      assign label = words | join: ' ' | capitalize
      echo '#D8CCB4|neutral|' | append: label | append: '|?'
  endcase
-%}
