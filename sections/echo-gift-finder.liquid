{%- capture echo_out -%}
{%- comment -%} Gift finder: budget chips, occasions, and the product grid they filter. {%- endcomment -%}
<style>
  .gf-sec1{padding:80px 16px 0}
  .gf-sec2{padding:80px 16px {{ section.settings.pad_bottom }}px}
  @media(min-width:720px){.gf-sec1,.gf-sec2{padding-inline:max(80px,calc((100vw - var(--wrap)) / 2 + 80px))}}
  .gf-sec1,.gf-sec2{position:relative}
  .gf-sec1 .wrap,.gf-sec2 .wrap{padding-inline:0;max-width:none}
  .gf-h{margin:0;font:300 clamp(28px,2.8vw,40px)/normal var(--display);color:var(--wine)}
  .gf-chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:40px}
  .gf-chips .chip{min-height:32px;padding:0 16px;border:1px solid #332C2A;border-radius:100px;background:transparent;color:#332C2A;font:400 14px/1.6 var(--body);text-decoration:none}
  .gf-chips .chip[aria-pressed="true"]{background:#332C2A;border-color:#332C2A;color:#F0DFD8}
  .gf-occ-h{margin-top:40px}
  .gf-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px;margin-top:40px}
  @media(min-width:900px){.gf-tiles{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}}
  .gf-tile{display:flex;flex-direction:column;gap:24px;background:none;border:0;padding:0;text-align:left;cursor:pointer;color:#332C2A}
  .gf-tile .ph{aspect-ratio:302/420!important;border:0;min-height:0}
  .gf-tile .gf-lb{display:flex;align-items:center;gap:10px;justify-content:space-between}
  .gf-tile .gf-lb span{font:300 clamp(22px,2.2vw,32px)/normal var(--display);color:#332C2A}
  .gf-tile .gf-lb svg{width:24px;height:24px;flex:none}
  .gf-tile[aria-pressed="true"] .gf-lb span{color:var(--wine);text-decoration:underline;text-underline-offset:6px}
  .gf-grid{margin-top:40px;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px}
  @media(min-width:900px){.gf-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}}
  .gf-grid .card{gap:20px}
  .gf-grid .card .ph.pack{background:#fff;aspect-ratio:302/360}
  .gf-grid .card .ph.pack img{mix-blend-mode:normal;object-fit:contain;padding:6%}
  .gf-grid .card .meta{display:flex;flex-direction:column;gap:8px;padding-top:0}
  .gf-grid .card .name{order:1;font:400 16px/normal var(--body);color:#7C7E64}
  .gf-grid .card .swatches{display:none}
  .gf-grid .card .ed{order:2;font:400 14px/1.6 var(--body);color:#ABA499}
  .gf-grid .card .meta>span:not([class]){order:3;font:600 16px/1.6 var(--body);color:#332C2A}
  .gf-promo{display:flex;flex-direction:column;gap:24px;align-self:start;aspect-ratio:302/360;padding:24px;background:#380F1C;color:#fff}
  .gf-promo b{font:400 24px/1.25 var(--display);color:#fff}
  .gf-promo p{margin:0;font:400 14px/1.6 var(--body);color:#fff}
  .gf-promo a{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid #fff;font:600 12px/1.6 var(--body);letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none}
  .gf-promo a svg{width:24px;height:24px}
  .gf-sec2 .wrap{position:relative;z-index:1}
  @media(max-width:749px){.gf-sec2{padding-top:160px}}
</style>

{%- liquid
  assign col = section.settings.collection
  if col != blank
    assign list = col.products
  else
    assign list = collections.all.products
  endif
  assign pop = ','
  for p in section.settings.popular
    assign pop = pop | append: p.handle | append: ','
  endfor
-%}
<section class="gf-sec1">
  <div class="wrap">
    <h2 class="gf-h">{{ 'echo.gift_finder.by_budget' | t }}</h2>
    <div class="gf-chips">
      <button class="chip" data-budget="u700" aria-pressed="false">{{ 'echo.gift_finder.under_dkk_700' | t }}</button>
      <button class="chip" data-budget="700" aria-pressed="false">{{ 'echo.gift_finder.dkk_700_to_1_000' | t }}</button>
      <button class="chip" data-budget="1000" aria-pressed="false">{{ 'echo.gift_finder.dkk_1_000_to_2_200' | t }}</button>
      <a class="chip" href="{% render 'echo-url', key: 'sets' %}">{{ 'echo.gift_finder.sets' | t }}</a>
      <a class="chip" href="{% render 'echo-url', key: 'gift-card' %}">{{ 'echo.common.gift_card' | t }}</a>
    </div>
    <h2 class="gf-h gf-occ-h">{{ 'echo.gift_finder.by_occasion' | t }}</h2>
    <div class="gf-tiles">
      {%- for b in section.blocks -%}
        {%- capture hs -%}{%- for p in b.settings.products -%}{{ p.handle }}{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endcapture -%}
        <button class="gf-tile" data-occ="{{ b.id }}" data-handles="{{ hs }}" aria-pressed="false" {{ b.shopify_attributes }}>
          {%- render 'echo-pic', image: b.settings.image, asset: b.settings.photo, alt: b.settings.title, label: b.settings.ph, ar: '302/420' -%}
          <span class="gf-lb"><span class="name" data-label="{{ b.settings.title | escape }}">{{ b.settings.title }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>
<section class="gf-sec2">
  {%- if section.settings.show_thread -%}{%- render 'echo-thread', shape: 'swirl', x: -129, y: -75, w: 427, cap: true, mx: -44, my: 6, mw: 116 -%}{%- endif -%}
  <div class="wrap">
    <div class="row" style="justify-content:space-between"><h2 class="gf-h" data-gift-title>{{ 'echo.gift.popular_gifts' | t }}</h2><button class="textbtn" data-clear-gift hidden>{{ 'echo.gift_finder.clear' | t }}</button></div>
    <div class="grid g4 gf-grid" data-gift-grid>
      {%- assign n = 0 -%}
      {%- assign seen = ',' -%}
      {%- assign nsrc = section.blocks.size | plus: 1 -%}
      {%- for si in (0..nsrc) -%}
      {%- if si == 0 -%}{%- assign src = section.settings.popular -%}{%- elsif si == nsrc -%}{%- assign src = list -%}{%- else -%}{%- assign bi = si | minus: 1 -%}{%- assign src = section.blocks[bi].settings.products -%}{%- endif -%}
      {%- for p in src limit: 100 -%}
        {%- if p.gift_card? -%}{%- continue -%}{%- endif -%}
        {%- assign hk = ',' | append: p.handle | append: ',' -%}
        {%- if seen contains hk -%}{%- continue -%}{%- endif -%}
        {%- for s in p.metafields.custom.linked_products.value -%}{%- assign seen = seen | append: s.handle | append: ',' -%}{%- endfor -%}
        {%- assign seen = seen | append: p.handle | append: ',' -%}
        {%- assign is_pop = false -%}
        {%- assign ghit = false -%}
        {%- for s in p.metafields.custom.linked_products.value -%}{%- assign sk = ',' | append: s.handle | append: ',' -%}{%- if pop contains sk -%}{%- assign ghit = true -%}{%- endif -%}{%- endfor -%}
        {%- if pop contains hk or ghit -%}{%- assign is_pop = true -%}{%- elsif section.settings.popular == blank and n < 8 -%}{%- assign is_pop = true -%}{%- endif -%}
        {%- assign n = n | plus: 1 -%}
        {%- capture card -%}{%- render 'echo-card', product: p -%}{%- endcapture -%}
        {%- if is_pop -%}{{ card | replace_first: '<a class="card"', '<a data-popular class="card"' }}{%- else -%}{{ card }}{%- endif -%}
      {%- endfor -%}
      {%- endfor -%}
      {%- if section.settings.show_promo -%}<div class="gf-promo" data-gift-promo><b>{{ section.settings.promo_title }}</b><p>{{ section.settings.promo_text }}</p><a href="{% render 'echo-url', key: 'gift-card' %}">{{ section.settings.promo_link_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></div>{%- endif -%}
    </div>
    <div class="review" data-gift-empty hidden>{{ 'echo.gift_finder.no_gifts_in_this_budget_for_this' | t }} <button class="textbtn" data-clear-gift>{{ 'echo.gift_finder.clear' | t }}</button></div>
  </div>
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Gift finder",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Products to choose from", "info": "Empty = all products" },
    { "type": "product_list", "id": "popular", "label": "Popular gifts (shown before a filter is picked)", "limit": 12 },
    { "type": "checkbox", "id": "show_thread", "label": "Blue thread at the left edge", "default": true },
    { "type": "range", "id": "pad_bottom", "label": "Space below the list", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" },
    { "type": "header", "content": "eGift card tile (last in the list)" },
    { "type": "checkbox", "id": "show_promo", "label": "Show the eGift card tile", "default": true },
    { "type": "text", "id": "promo_title", "label": "Title", "default": "eGift Card" },
    { "type": "textarea", "id": "promo_text", "label": "Text", "default": "Not sure what to get them? Let them pick out their favorites instead. Sent by email, with no expiry date. Available in DKK 100, 250, 500, or 1,000." },
    { "type": "text", "id": "promo_link_label", "label": "Link label", "default": "Buy a gift card" }
  ],
  "blocks": [
    { "type": "occasion", "name": "Occasion", "settings": [
      { "type": "text", "id": "title", "label": "Name", "default": "Housewarming" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "photo", "label": "Bundled image file", "info": "Used when no image is picked. File name in assets." },
      { "type": "text", "id": "ph", "label": "Placeholder text", "default": "new home" },
      { "type": "product_list", "id": "products", "label": "Products for this occasion", "limit": 12 }
    ] }
  ],
  "presets": [{ "name": "Gift finder" }]
}
{% endschema %}
