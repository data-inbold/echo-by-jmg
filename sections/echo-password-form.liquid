{%- comment -%} Used by reset password and activate account templates. {%- endcomment -%}
<section class="section tight"><div class="wrap" style="max-width:560px">
  {%- if template.name == 'activate_account' -%}
    {%- form 'activate_customer_password', class: 'stack', style: 'gap:14px' -%}
      <h1 class="h2">{{ 'echo.password_form.activate_your_account' | t }}</h1>
      {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="p1">{{ 'echo.common.password' | t }}</label><input id="p1" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="p2">{{ 'echo.password_form.confirm_password' | t }}</label><input id="p2" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn" type="submit" name="activate">{{ 'echo.password_form.activate_account' | t }}</button>
    {%- endform -%}
  {%- else -%}
    {%- form 'reset_customer_password', class: 'stack', style: 'gap:14px' -%}
      <h1 class="h2">{{ 'echo.password_form.choose_a_new_password' | t }}</h1>
      {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="p1">{{ 'echo.common.password' | t }}</label><input id="p1" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field"><label for="p2">{{ 'echo.password_form.confirm_password' | t }}</label><input id="p2" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn" type="submit">{{ 'echo.password_form.save_password' | t }}</button>
    {%- endform -%}
  {%- endif -%}
</div></section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
