{%- capture echo_out -%}
{%- comment -%} Text + media side by side. The most used layout in the design. {%- endcomment -%}
{%- capture media -%}
  {%- render 'echo-media', video: section.settings.video, image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: section.settings.label, ar: section.settings.ar, eager: section.settings.heading_tag -%}
{%- endcapture -%}
{%- capture text -%}
  <div class="stack" style="gap:{{ section.settings.gap }}px">
    {%- if section.settings.eyebrow != blank -%}<span class="mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- if section.settings.heading_tag -%}<h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>{%- else -%}<h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.quote != blank -%}<p class="echo-quote" style="margin:0">{{ section.settings.quote }}</p>{%- endif -%}
    {%- if section.settings.lead != blank -%}<p class="lead" style="margin:0">{{ section.settings.lead }}</p>{%- endif -%}
    {%- if section.settings.chips != blank -%}
      <div class="row" style="gap:8px">
        {%- assign chip_lines = section.settings.chips | newline_to_br | strip_newlines | split: '<br />' -%}
        {%- for cl in chip_lines -%}{%- assign cp = cl | split: '::' -%}{%- if cp[0] != blank -%}<a class="chip" href="{{ cp[1] | default: '#' | strip }}">{{ cp[0] | strip }}</a>{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.caption != blank -%}<p class="muted" style="margin:0">{{ section.settings.caption }}</p>{%- endif -%}
    {%- if section.settings.small != blank -%}<p class="muted" style="margin:0;font-size:14px">{{ section.settings.small }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="echo-points{% if section.settings.points_style == 'years' %} years{% endif %}">
        {%- for b in section.blocks -%}
          <div {{ b.shopify_attributes }}><b>{{ b.settings.title }}</b>{% if b.settings.text != blank %}<p class="muted">{{ b.settings.text }}</p>{% endif %}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.stat_text != blank -%}
      {%- liquid
        capture bt
          render 'echo-batch-totals'
        endcapture
        assign bp = bt | strip | split: '|'
        assign kg_html = '<b class="echo-stat-n">' | append: bp[0] | append: '</b>'
        assign n_html = '<b class="echo-stat-n">' | append: bp[1] | append: '</b>'
        assign stat = section.settings.stat_text | replace: '{kg}', kg_html | replace: '{batches}', n_html
      -%}
      <div class="echo-statline"><span>{{ stat }}</span>{% if section.settings.stat_link_label != blank %}<a class="link" href="{{ section.settings.stat_link | default: '#' }}">{{ section.settings.stat_link_label }}</a>{% endif %}</div>
    {%- endif -%}
    {%- if section.settings.badges != blank -%}
      <div class="certrow">{%- assign badge_keys = section.settings.badges | split: ',' -%}{%- for bk in badge_keys -%}{%- assign bk_key = bk | strip -%}{%- render 'echo-cert-logo', k: bk_key, h: 44 -%}{%- endfor -%}</div>
    {%- endif -%}
    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
      <div{% if section.settings.btn1_label != blank and section.settings.btn2_label != blank %} class="row"{% endif %}>
        {%- if section.settings.btn1_label != blank -%}<a class="btn{% if section.settings.btn1_ghost %} ghost{% endif %}" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="btn{% if section.settings.btn2_ghost %} ghost{% endif %}" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}
<style>
  .echo-points{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;border-top:1px solid var(--line,rgba(0,0,0,.15));padding-top:14px}
  .echo-points b{display:block;font-size:14px;margin-bottom:4px}.echo-points p{margin:0;font-size:13px;line-height:1.5}
  .echo-quote{font:500 italic 21px/1.5 var(--display)}
  .echo-statline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;background:var(--soft);padding:10px 12px;font-size:13px}
  .echo-stat-n{font:600 17px/1 var(--display)}
  .echo-points.years{grid-template-columns:1fr 1fr;gap:20px 16px}.echo-points.years b{font:800 24px/1.1 var(--display);margin-bottom:6px}
  @media (max-width:749px){.echo-points{grid-template-columns:1fr}.echo-points.years{grid-template-columns:1fr 1fr}}
</style>
{%- unless section.settings.hide_on_gift and product.gift_card? -%}
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  {%- if section.settings.outer_heading != blank -%}<div class="wrap" style="margin-bottom:28px"><h2 class="h2">{{ section.settings.outer_heading }}</h2></div>{%- endif -%}
  <div class="wrap split{% if section.settings.rev %} rev{% endif %}{% if section.settings.panel != 'none' %} panel panel-{{ section.settings.panel }}{% if section.settings.media_first %} mf{% endif %}{% endif %}"{% if section.settings.top %} style="align-items:start"{% endif %}>
    {%- if section.settings.media_first -%}{{ media }}{{ text }}{%- else -%}{{ text }}{{ media }}{%- endif -%}
  </div>
</section>
{%- endunless -%}
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Text and media",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Black"}], "default": "paper"},
    { "type": "checkbox", "id": "media_first", "label": "Media first (left on desktop)", "default": true },
    { "type": "checkbox", "id": "rev", "label": "Swap columns on desktop", "default": false },
    { "type": "checkbox", "id": "top", "label": "Align to top", "default": false },
    { "type": "range", "id": "gap", "label": "Text spacing", "min": 10, "max": 20, "step": 2, "default": 16, "unit": "px" },
    { "type": "checkbox", "id": "hide_on_gift", "label": "Hide on gift card product", "default": false },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The story behind every stitch" },
    { "type": "checkbox", "id": "heading_tag", "label": "This is the page title (H1)", "default": false },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "h1", "label": "Extra large" }, { "value": "h2", "label": "Large" }, { "value": "h3", "label": "Small" }], "default": "h2" },
    { "type": "textarea", "id": "quote", "label": "Quote (large italic)" },
    { "type": "textarea", "id": "lead", "label": "Intro text" },
    { "type": "textarea", "id": "caption", "label": "Muted text" },
    { "type": "textarea", "id": "small", "label": "Small text" },
    { "type": "text", "id": "outer_heading", "label": "Heading above the section", "info": "Shown above the text and photo, outside the panel." },
    { "type": "select", "id": "panel", "label": "Text panel", "options": [{"value": "none", "label": "None"}, {"value": "blush", "label": "Blush panel"}, {"value": "wine", "label": "Wine panel"}], "default": "none" },
    { "type": "textarea", "id": "chips", "label": "Link chips", "info": "One per line: Label::link. For example: Yarn tracker::/pages/tracker" },
    { "type": "text", "id": "badges", "label": "Certificate badges", "info": "Comma separated: bsci, ocs, rcs" },
    { "type": "select", "id": "points_style", "label": "Point blocks layout", "options": [{"value": "cols3", "label": "Three columns, small titles"}, {"value": "years", "label": "Two columns, large titles (years)"}], "default": "cols3" },
    { "type": "text", "id": "btn1_label", "label": "Button 1" },
    { "type": "text", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "checkbox", "id": "btn1_ghost", "label": "Button 1 outlined", "default": true },
    { "type": "text", "id": "btn2_label", "label": "Button 2" },
    { "type": "text", "id": "btn2_link", "label": "Button 2 link" },
    { "type": "checkbox", "id": "btn2_ghost", "label": "Button 2 outlined", "default": true },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (plays muted, looped)" },
    { "type": "select", "id": "photo", "label": "Bundled photo", "options": [{"value": "none", "label": "None (show placeholder)"}, {"value": "echo-ming-portrait.jpg", "label": "Ming at the factory, portrait"}, {"value": "echo-v2-hero.jpg", "label": "New design: yarn cones hero"}, {"value": "echo-v2-process.jpg", "label": "New design: yarn label process"}, {"value": "echo-v2-tile-blankets.jpg", "label": "New design: blanket on sofa"}, {"value": "echo-v2-tile-cushions.jpg", "label": "New design: cushion on sofa"}, {"value": "echo-v2-tile-bags.jpg", "label": "New design: bag on side table"}, {"value": "echo-v2-tile-accessories.jpg", "label": "New design: beanie, portrait"}, {"value": "echo-v2-story.jpg", "label": "New design: Ming at the factory (b/w)"}, {"value": "echo-v2-review-1.jpg", "label": "New design: customer, blue blanket"}, {"value": "echo-v2-review-2.jpg", "label": "New design: customer, grey blanket"}, {"value": "echo-v2-gift.jpg", "label": "New design: gift box with yarn"}, {"value": "echo-twister-outdoor.jpg", "label": "Twister Rope, outdoor lounger"}, {"value": "echo-twister-doe.jpg", "label": "Twister Rope, doe"}, {"value": "echo-twister-sofa-small.jpg", "label": "Twister Rope, cable close-up"}, {"value": "echo-twister-chair.jpg", "label": "Twister Rope, chair"}, {"value": "echo-hills-valleys-green.jpg", "label": "Hills & Valleys, green"}, {"value": "echo-hv-cushion-oat.jpg", "label": "Hills & Valleys cushion, oat"}, {"value": "echo-cushion-brown.jpg", "label": "Cushion cover on sofa"}, {"value": "echo-carousel-violet.jpg", "label": "Carousel Stripes, violet"}, {"value": "echo-rollercoaster-black.jpg", "label": "Rollercoaster Tracks, black"}, {"value": "echo-happy-sunshine-mauve.jpg", "label": "Happy Sunshine, mauve"}, {"value": "echo-puff-friends.jpg", "label": "Puff Friends cushion"}, {"value": "echo-bag-cable.jpg", "label": "Cable Rope tote"}, {"value": "echo-acc-scarf.jpg", "label": "Rainbow Crossing scarf"}, {"value": "echo-beanie-pink.jpg", "label": "Pompom beanie, pink"}], "default": "none" },
    { "type": "text", "id": "alt", "label": "Image description" },
    { "type": "textarea", "id": "label", "label": "Placeholder text (shown until media is added)", "default": "20 sec loop: Ming and the family on the factory floor, faces visible." },
    { "type": "text", "id": "ar", "label": "Media shape (aspect ratio)", "default": "4/3" },
    { "type": "header", "content": "Yarn stat line" },
    { "type": "text", "id": "stat_text", "label": "Stat text", "info": "Shown above the buttons. {kg} and {batches} are filled from the Yarn batch list. Empty = hidden." },
    { "type": "text", "id": "stat_link_label", "label": "Stat link label" },
    { "type": "url", "id": "stat_link", "label": "Stat link" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Text and media" }]
}
{% endschema %}
