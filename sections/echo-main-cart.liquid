{%- capture u_all -%}{%- render 'echo-url', key: 'shop-all' -%}{%- endcapture -%}
{%- if cart.item_count == 0 -%}
  <section class="section"><div class="wrap stack" style="max-width:640px"><h1 class="h2">{{ 'echo.main_cart.your_bag_is_empty' | t }}</h1><div><a class="btn" href="{{ u_all }}">{{ 'echo.common.shop_the_editions' | t }}</a></div></div></section>
{%- else -%}
  {%- capture u_home -%}{%- render 'echo-url', key: 'home' -%}{%- endcapture -%}
  {%- assign t_home = 'echo.common.home' | t -%}{%- assign t_bag = 'echo.common.bag' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_bag -%}
  {%- render 'echo-crumbs', list: cl -%}
  <section class="section tight">
    <div class="wrap grid g2" style="align-items:start">
      <div class="stack" style="gap:18px">
        <h1 class="h2">{{ 'echo.bag.title' | t: count: cart.item_count }}</h1>
        <div>{%- for item in cart.items -%}{%- render 'echo-line', item: item, line: forloop.index -%}{%- endfor -%}</div>
        <a class="link" style="align-self:flex-start" href="{{ u_all }}">{{ 'echo.main_cart.continue_shopping' | t }}</a>
      </div>
      <form action="{{ routes.cart_url }}" method="post" class="review stack" style="gap:12px">
        <h2 class="h3">{{ 'echo.main_cart.order_summary' | t }}</h2>
        {%- render 'echo-discount-box', k: 'c' -%}
        <div>{%- render 'echo-sum-rows' -%}</div>
        <span class="muted" style="font-size:13px">{{ section.settings.note }}</span>
        <button class="btn block" type="submit" name="checkout">{{ 'echo.common.go_to_checkout' | t }}</button>
        {%- if additional_checkout_buttons and section.settings.express -%}<div class="pdp-buttons">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        <span class="muted" style="font-size:13px">{%- capture u_terms -%}{%- render 'echo-url', key: 'terms' -%}{%- endcapture -%}{%- capture u_privacy -%}{%- render 'echo-url', key: 'privacy' -%}{%- endcapture -%}{{ 'echo.cart.terms_html' | t: terms_url: u_terms, privacy_url: u_privacy }}</span>
      </form>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Bag page",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "Free delivery to your door or a parcel shop. Free 14-day returns." },
    { "type": "checkbox", "id": "express", "label": "Show express checkout buttons", "default": true }
  ]
}
{% endschema %}
