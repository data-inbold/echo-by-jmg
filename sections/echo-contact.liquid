{%- comment -%} Contact page: breadcrumbs, big heading, then an info panel with a photo on the left and the contact form on the right. {%- endcomment -%}
{%- liquid
  capture u_home
    render 'echo-url', key: 'home'
  endcapture
  assign t_home = 'echo.common.home' | t
  assign crumb_list = t_home | append: '::' | append: u_home | append: '||' | append: section.settings.crumb_current
-%}
<style>
  .ct{padding-block:{{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px}
  .ct .crumbs{padding:0 0 20px}
  .ct .wrap>.crumbs{max-width:none;margin:0}
  .ct-h{margin:0;font:300 clamp(34px,3.9vw,56px)/1.36 var(--display);color:var(--wine)}
  .ct-hr{height:0;border:0;border-top:1px solid #ABA499;margin:40px 0}
  .ct-main{display:grid;grid-template-columns:1fr;gap:24px;align-items:start}
  @media(min-width:900px){.ct-main{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .ct-left{display:flex;flex-direction:column;min-width:0}
  .ct-info{background:#E9E2DA;padding:20px 40px;display:flex;flex-direction:column;gap:24px}
  .ct-info h2,.ct-right h2{margin:0;font:300 clamp(28px,2.8vw,40px)/1.6 var(--display);color:var(--wine)}
  .ct-info p{margin:8px 0 0;font:400 16px/1.6 var(--body);color:#332C2A}
  .ct-info hr{height:0;border:0;border-top:1px solid #ABA499;margin:0}
  .ct-qa{display:flex;flex-direction:column;gap:12px;padding-block:8px}
  .ct-row{display:flex;gap:12px;align-items:flex-start;font-size:18px}
  .ct-row dt{flex:none;width:132px;font:400 18px/1.6 var(--nav);color:var(--wine)}
  .ct-row dd{margin:0;flex:1;min-width:0;font:600 18px/normal var(--body);color:#332C2A;overflow-wrap:anywhere}
  .ct-row dd a{color:inherit;text-decoration:none}
  .ct-photo{position:relative;min-height:240px;flex:1;background:#d8d0c6}
  @media(min-width:900px){.ct-photo{min-height:278px}}
  .ct-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focus }}}
  .ct-right{display:flex;flex-direction:column;gap:24px;min-width:0}
  .ct-form{display:flex;flex-direction:column;gap:24px}
  .ct-f{display:flex;flex-direction:column}
  .ct-f label{font:400 18px/normal var(--nav);color:#332C2A}
  .ct-f input,.ct-f textarea{width:100%;border:0;border-bottom:1px solid #332C2A;border-radius:0;background:transparent;padding:8px 0;font:400 18px/28px var(--body);color:#332C2A;outline:0;min-height:0;box-sizing:border-box}
  .ct-f textarea{height:148px;resize:vertical}
  .ct-f input::placeholder,.ct-f textarea::placeholder{color:#ABA499}
  .ct-f input:focus,.ct-f textarea:focus{border-bottom-width:2px;padding-bottom:7px}
  .ct-send{align-self:flex-start;min-width:193px;padding:12px 16px;border:0;background:#380F1C;color:#F0DFD8;font:500 12px/1.6 var(--body);letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
  .ct-send:hover{background:#4d1a2b}
  .ct-ok{padding:20px;background:#E9E2DA;font:400 16px/1.6 var(--body);color:#332C2A}
  .ct-err{padding:12px 16px;background:#F0DFD8;color:#380F1C;font:400 14px/1.6 var(--body)}
</style>
<section class="ct">
  <div class="wrap">
    {%- render 'echo-crumbs', list: crumb_list -%}
    <h1 class="ct-h">{{ section.settings.heading }}</h1>
    <hr class="ct-hr">
    <div class="ct-main">
      <div class="ct-left">
        <div class="ct-info">
          <div><h2>{{ section.settings.info_heading }}</h2><p>{{ section.settings.lead | newline_to_br }}</p></div>
          <hr>
          <dl class="ct-qa" style="margin:0">
            {%- for b in section.blocks -%}
              <div class="ct-row" {{ b.shopify_attributes }}><dt>{{ b.settings.label }}</dt><dd>{% if b.settings.link != blank %}<a href="{{ b.settings.link }}">{{ b.settings.value }}</a>{% else %}{{ b.settings.value }}{% endif %}</dd></div>
            {%- endfor -%}
          </dl>
        </div>
        <div class="ct-photo">
          {%- if section.settings.photo != blank -%}
            {{ section.settings.photo | image_url: width: 1256 | image_tag: alt: section.settings.alt, loading: 'lazy', widths: '628, 942, 1256', sizes: '(min-width: 900px) 628px, 100vw' }}
          {%- elsif section.settings.photo_file != blank -%}
            <img src="{{ section.settings.photo_file | asset_url }}" alt="{{ section.settings.alt | escape }}" width="1400" height="810" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="ct-right">
        <h2>{{ 'echo.contact.send_your_message' | t }}</h2>
        {%- form 'contact', class: 'ct-form', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="ct-ok" role="status">{{ section.settings.ok }}</div>
          {%- else -%}
            {%- if form.errors -%}<div class="ct-err">{{ form.errors | default_errors }}</div>{%- endif -%}
            <input type="hidden" name="contact[Form]" value="Contact">
            <div class="ct-f"><label for="c-name">{{ 'echo.contact.your_name' | t }}</label><input id="c-name" name="contact[name]" required autocomplete="name" placeholder="{{ 'echo.contact.name_placeholder' | t | escape }}"></div>
            <div class="ct-f"><label for="c-email">{{ 'echo.contact.your_email' | t }}</label><input id="c-email" name="contact[email]" type="email" required autocomplete="email" placeholder="{{ 'echo.contact.email_placeholder' | t | escape }}"></div>
            <div class="ct-f"><label for="c-order">{{ 'echo.contact.order_number_optional' | t }}</label><input id="c-order" name="contact[Order number]" placeholder="{{ 'echo.contact.order_placeholder' | t | escape }}"></div>
            <div class="ct-f"><label for="c-msg">{{ 'echo.contact.message' | t }}</label><textarea id="c-msg" name="contact[body]" required placeholder="{{ 'echo.contact.message_placeholder' | t | escape }}"></textarea></div>
            <button class="ct-send" type="submit">{{ 'echo.contact.send_message' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "crumb_current", "label": "Breadcrumb: this page", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "info_heading", "label": "Info panel heading", "default": "Our Information" },
    { "type": "textarea", "id": "lead", "label": "Info panel text", "default": "Questions about a product, an order or a gift.\nWe reply within 24 hours on weekdays." },
    { "type": "text", "id": "ok", "label": "Thank-you message", "default": "Thank you. Your message is with customer support, and we reply within 24 hours." },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "photo", "label": "Photo", "info": "About 1256 x 556 px. Empty = the file named below." },
    { "type": "text", "id": "photo_file", "label": "Photo file in assets", "info": "Stand-in until the real photo is uploaded.", "default": "echo-v2-gift.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A wrapped EchoByJMG parcel with a handwritten card" },
    { "type": "text", "id": "focus", "label": "Photo focus", "default": "50% 50%" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 160, "step": 10, "default": 0, "unit": "px" }
  ],
  "blocks": [
    { "type": "row", "name": "Info row", "limit": 6, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Email" },
      { "type": "text", "id": "value", "label": "Text", "default": "hello@echobyjmg.com" },
      { "type": "url", "id": "link", "label": "Link (optional)", "info": "For example mailto:hello@echobyjmg.com" }
    ] }
  ],
  "presets": [{ "name": "Contact", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
