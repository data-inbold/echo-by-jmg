<section class="section tight"><div class="wrap grid g2" style="align-items:start">
  <div class="stack" style="gap:14px"><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead" style="margin:0">{{ section.settings.lead }}</p>
    <div class="review">{{ section.settings.info }}</div></div>
  {%- form 'contact', class: 'stack', style: 'gap:14px', id: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="ok" role="status">{{ section.settings.ok }}</div>
    {%- else -%}
      {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input type="hidden" name="contact[Form]" value="Contact">
      <div class="field"><label for="c-name">Name</label><input id="c-name" name="contact[name]" required autocomplete="name"></div>
      <div class="field"><label for="c-email">Email</label><input id="c-email" name="contact[email]" type="email" required autocomplete="email"></div>
      <div class="field"><label for="c-order">Order number (optional)</label><input id="c-order" name="contact[Order number]"></div>
      <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="contact[body]" rows="5" required></textarea></div>
      <button class="btn" type="submit">Send message</button>
    {%- endif -%}
  {%- endform -%}
</div></section>
{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Questions about a product, an order or a gift. We reply within 24 hours on weekdays." },
    { "type": "richtext", "id": "info", "label": "Contact details", "default": "<p><strong>Email</strong><br>hello@echobyjmg.com<br><br><strong>Phone</strong><br>+852 3500 3911<br><br><strong>Support hours</strong><br>[Weekdays 9 to 16 CET], in [Danish and English]<br><br><strong>Returns address</strong><br>Parcel Feeder, Brøndby, [street address]</p>" },
    { "type": "text", "id": "ok", "label": "Thank-you message", "default": "Thank you. Your message is with customer support, and we reply within 24 hours." }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
