{%- comment -%} (Shopify section names are limited to 25 characters.) Letter from the founders: photo, long italic letter on a pink panel, and a three-step timeline underneath. {%- endcomment -%}
{%- assign marks = section.blocks | where: 'type', 'milestone' -%}
<style>
  .lt-panel{display:grid;background:#E9E2DA}
  @media(min-width:880px){.lt-panel{grid-template-columns:600fr 680fr}}
  .lt-photo{background:#fff;padding:20px;display:flex}
  .lt-photo .ph{flex:1;min-height:320px;border:0;aspect-ratio:auto!important}
  @media(max-width:879px){.lt-photo .ph{aspect-ratio:560/674!important}}
  .lt-text{background:var(--pink);padding:clamp(28px,5vw,40px) clamp(24px,5vw,60px);display:flex;flex-direction:column;gap:24px;position:relative}
  .lt-q{font:italic 300 20px/normal var(--display);color:var(--wine)}
  .lt-q p{margin:0 0 1.4em}
  .lt-q p:last-child{margin:0}
  .lt-hr{border:0;border-top:1px solid rgba(56,15,28,.22);margin:0}
  .lt-by{margin:0;font-size:14px;color:#7C7E64}
  .lt-ico{align-self:flex-end;width:109px;height:120px;margin-top:auto}
  .lt-time{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding-block:40px 0}
  .lt-col{display:flex;flex-direction:column;gap:24px}
  .lt-year{font:italic 300 clamp(24px,2.4vw,32px)/normal var(--display);color:var(--wine);text-align:center}
  .lt-bar{display:flex;align-items:center}
  .lt-bar i{flex:1;height:0;border-top:2px solid #ABA499}
  .lt-bar b{flex:none;width:12px;height:12px;border-radius:50%;background:var(--wine)}
  .lt-col p{margin:0;padding-left:clamp(16px,5.5vw,80px);padding-right:12px;font-size:16px;line-height:1.6;color:#332C2A}
  @media(max-width:719px){.lt-time{grid-template-columns:1fr;gap:32px}.lt-year{text-align:left}.lt-bar{display:none}.lt-col{gap:8px}.lt-col p{padding-left:0}}
</style>
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap stack" style="gap:40px">
    {%- if section.settings.heading != blank -%}<h2 class="h2 lt-title" style="text-align:{{ section.settings.heading_align }}">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="lt-panel">
      <div class="lt-photo{% if section.settings.show_thread %} ethr-host{% endif %}">
        {%- if section.settings.show_thread -%}<img class="ethr l" src="{{ 'echo-thread-letter-blue.png' | asset_url }}" alt="" width="642" height="626" style="--x:-177;--y:-249;--w:642;--W:600" aria-hidden="true">{%- endif -%}
        {%- render 'echo-pic', image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: 'Founder photo', ar: '560/674', sizes: '(min-width: 880px) 560px, 100vw' -%}
        {%- if section.settings.show_thread -%}<div class="ethr-clip"><img class="ethr l" src="{{ 'echo-thread-letter-white.png' | asset_url }}" alt="" width="373" height="441" style="--x:227;--y:300;--w:373;--W:600" aria-hidden="true"></div>{%- endif -%}
      </div>
      <div class="lt-text">
        <div class="lt-q">{{ section.settings.letter | newline_to_br | replace: '<br /><br />', '</p><p>' | prepend: '<p>' | append: '</p>' }}</div>
        <hr class="lt-hr">
        {%- if section.settings.caption != blank -%}<p class="lt-by">{{ section.settings.caption }}</p>{%- endif -%}
        {%- if section.settings.icon_file != blank -%}<img class="lt-ico" src="{{ section.settings.icon_file | asset_url }}" alt="" width="109" height="120" loading="lazy">{%- endif -%}
      </div>
    </div>
    {%- if marks.size > 0 -%}
    <div class="lt-time">
      {%- for b in marks -%}
        <div class="lt-col" {{ b.shopify_attributes }}><span class="lt-year">({{ b.settings.year }})</span><div class="lt-bar" aria-hidden="true"><i></i><b></b><i></i></div><p>{{ b.settings.text }}</p></div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Founder letter",
  "settings": [
    { "type": "checkbox", "id": "show_thread", "label": "Show the thread lines around the photo", "default": true },
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}], "default": "paper" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Letter From Our Founders" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "right" },
    { "type": "textarea", "id": "letter", "label": "Letter", "info": "Leave an empty line between paragraphs." },
    { "type": "text", "id": "caption", "label": "Signature", "default": "Ming, Founder of EchoByJMG" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "photo", "label": "Bundled photo file", "info": "Used when no photo is picked. File name in assets.", "default": "echo-ming-portrait.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description" },
    { "type": "text", "id": "icon_file", "label": "Icon file", "info": "File name in assets. Empty = no icon.", "default": "echo-yarnknitting-ourstory.png" }
  ],
  "blocks": [
    { "type": "milestone", "name": "Milestone", "settings": [
      { "type": "text", "id": "year", "label": "Year", "default": "1946" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Founder letter" }]
}
{% endschema %}
