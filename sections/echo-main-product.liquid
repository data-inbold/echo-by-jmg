{%- comment -%}
  Product page top: gallery + buy box. Colours are separate linked products (custom.linked_products),
  so the colour swatches link to the sibling product. The gift card product gets the amount picker.
{%- endcomment -%}
{%- liquid
  capture raw
    render 'echo-pinfo', product: product
  endcapture
  assign i = raw | strip | split: '~'
  assign cat = i[0]
  capture u_home
    render 'echo-url', key: 'home'
  endcapture
  capture u_all
    render 'echo-url', key: 'shop-all'
  endcapture
  case cat
    when 'blankets'
      assign catcol = settings.echo_col_blankets
      assign catname = 'echo.common.blankets' | t
    when 'cushions'
      assign catcol = settings.echo_col_cushions
      assign catname = 'echo.common.cushion_covers' | t
    when 'bags'
      assign catcol = settings.echo_col_bags
      assign catname = 'echo.common.bags' | t
    else
      assign catcol = settings.echo_col_accessories
      assign catname = 'echo.common.accessories' | t
  endcase
  capture caturl
    render 'echo-url', key: cat
  endcapture
  if catcol != blank
    assign caturl = catcol.url
    assign catname = catcol.title
  endif
  assign variant = product.selected_or_first_available_variant
  assign comp = product.metafields.custom.composition.value | default: ''
  assign care = product.metafields.custom.care_guide.value | default: ''
  assign dims = product.metafields.custom.dimensions.value | default: ''
  assign compl = comp | downcase
  if care == ''
    if compl contains 'wool'
      assign care = section.settings.care_wool
    elsif compl contains 'cotton'
      assign care = section.settings.care_cotton
    endif
  endif
-%}

{%- if product.gift_card? -%}
  {%- capture u_gifts -%}{%- render 'echo-url', key: 'gifts' -%}{%- endcapture -%}
  {%- assign t_home = 'echo.common.home' | t -%}{%- assign t_gifts = 'echo.common.gifts' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_gifts | append: '::' | append: u_gifts | append: '||' | append: product.title -%}
  {%- render 'echo-crumbs', list: cl -%}
  <div class="wrap pdp">
    <div class="gallery">
      {%- if product.featured_media -%}{%- render 'echo-pic', image: product.featured_media.preview_image, alt: product.title, cls: 'main', eager: true -%}{%- else -%}{%- render 'echo-ph', label: 'eGift card visual', cls: 'main' -%}{%- endif -%}
    </div>
    {%- form 'product', product, class: 'stack', style: 'gap:16px', data-pdp-form: '' -%}
      <h1 class="h2">{{ product.title }}</h1>
      <div style="font-size:22px;font-weight:600" data-gc-price>{% render 'echo-money', price: variant.price %}</div>
      <div class="muted rte" style="margin:0">{{ product.description | default: section.settings.gc_text }}</div>
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <div><div style="font-size:14px;margin-bottom:10px">{{ 'echo.main_product.amount' | t }}</div><div class="row" style="gap:6px">
        {%- for v in product.variants -%}
          {%- capture lbl -%}{%- render 'echo-money', price: v.price -%}{%- endcapture -%}
          <button type="button" class="chip" data-amount="{{ v.id }}" data-label="{{ lbl | strip }}" aria-pressed="{% if v.id == variant.id %}true{% else %}false{% endif %}"{% unless v.available %} disabled{% endunless %}>{{ lbl | strip }}</button>
        {%- endfor -%}
      </div></div>
      <button class="btn" type="submit">{{ 'echo.main_product.add_to_bag' | t }}</button>
      <ul class="ticks"><li>{{ 'echo.main_product.sent_instantly_by_email' | t }}</li><li>{{ 'echo.main_product.no_expiry' | t }}</li></ul>
    {%- endform -%}
  </div>
{%- else -%}
  {%- assign t_home = 'echo.common.home' | t -%}{%- assign t_shop = 'echo.common.shop' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_shop | append: '::' | append: u_all | append: '||' | append: catname | append: '::' | append: caturl | append: '||' | append: i[8] -%}
  {%- render 'echo-crumbs', list: cl -%}
  <div class="wrap pdp">
    <div class="gallery">
      {%- liquid
        assign media = product.media | where: 'media_type', 'image'
        assign labels = section.settings.ph_labels | split: '|'
        assign total = media.size
        if total < 5
          assign total = 5
        endif
        comment
          Packshot first: the square catalogue photo ending in -01 leads the gallery, the other photos keep their order.
        endcomment
        assign pick_i = -1
        for m in media
          if m.preview_image.width == m.preview_image.height
            assign mname = m.preview_image.src | split: '?' | first | downcase
            if mname contains '-01.'
              assign pick_i = forloop.index0
              break
            endif
          endif
        endfor
      -%}
      {%- for k in (1..total) -%}
        {%- assign idx = forloop.index0 -%}
        {%- liquid
          assign sidx = idx
          assign mcls = 'main'
          if pick_i >= 0 and idx == 0
            assign mcls = 'main pack'
          endif
          if pick_i >= 0
            if idx == 0
              assign sidx = pick_i
            elsif idx <= pick_i
              assign sidx = idx | minus: 1
            endif
          endif
        -%}
        <div data-main="{{ idx }}"{% if idx > 0 %} hidden{% endif %}>
          {%- if media[sidx] -%}
            {%- assign malt = media[sidx].alt | default: i[8] -%}
            {%- render 'echo-pic', image: media[sidx].preview_image, alt: malt, cls: mcls, eager: forloop.first, sizes: '(min-width: 900px) 55vw, 100vw' -%}
          {%- else -%}
            {%- assign li = idx | minus: media.size -%}
            {%- if media.size > 0 -%}{%- assign li = li | plus: 1 -%}{%- endif -%}
            {%- assign lbl = labels[li] | strip | replace: '[N]', i[2] | append: '<br><br>' | append: i[5] -%}
            {%- render 'echo-ph', label: lbl, tint: i[6], cls: 'main' -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
      <div class="thumbs">
        {%- for k in (1..total) -%}
          {%- assign idx = forloop.index0 -%}
        {%- liquid
          assign sidx = idx
          if pick_i >= 0
            if idx == 0
              assign sidx = pick_i
            elsif idx <= pick_i
              assign sidx = idx | minus: 1
            endif
          endif
        -%}
          <button type="button" data-img="{{ idx }}" aria-pressed="{% if idx == 0 %}true{% else %}false{% endif %}" aria-label="Photo {{ forloop.index }}">
            {%- if media[sidx] -%}{%- render 'echo-pic', image: media[sidx].preview_image, alt: '', sizes: '120px' -%}{%- else -%}{%- render 'echo-ph', label: forloop.index, tint: i[6] -%}{%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="stack" style="gap:16px">
      <h1 class="h2">{{ i[8] }}</h1>
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- assign rcount = product.metafields.reviews.rating_count | default: 0 -%}
      {%- if rating != blank -%}
        <a href="#reviews" class="muted" style="font-size:14px;text-decoration:none">★★★★★ {{ rating.rating | round: 1 }} · {{ 'echo.common.reviews_count' | t: count: rcount }}</a>
      {%- endif -%}
      <div style="font-size:22px;font-weight:600">{% render 'echo-money', price: variant.price %} <span class="muted" style="font-size:13px;font-weight:400">{{ 'echo.main_product.incl_vat_free_delivery' | t }}</span></div>
      <div>
        <div style="font-size:14px;margin-bottom:10px">{{ 'echo.main_product.colour' | t }} <b>{{ i[5] }}</b></div>
        <div class="row">
          {%- assign sibs = product.metafields.custom.linked_products.value -%}
          {%- if sibs != blank -%}
            {%- for s in sibs -%}
              {%- capture sraw -%}{%- render 'echo-pinfo', product: s -%}{%- endcapture -%}
              {%- assign si = sraw | strip | split: '~' -%}
              <a class="swatch-btn" href="{{ s.url }}" style="background:{{ si[6] }};display:inline-block" aria-pressed="{% if s.id == product.id %}true{% else %}false{% endif %}" aria-label="{{ si[5] | escape }}" title="{{ si[5] | escape }}"></a>
            {%- endfor -%}
          {%- else -%}
            <span class="swatch-btn" style="background:{{ i[6] }};display:inline-block" aria-pressed="true" aria-label="{{ i[5] | escape }}"></span>
          {%- endif -%}
        </div>
      </div>

      {%- if i[4] == 'sold' -%}
        <div class="edition">{{ 'echo.product.sold_out_html' | t: total: i[2] }}</div>
        {%- form 'contact', class: 'stack', style: 'gap:8px' -%}
          {%- if form.posted_successfully? -%}
            <div class="ok" role="status">{{ 'echo.main_product.thank_you_we_will_email_you_when_the' | t }}</div>
          {%- else -%}
            <input type="hidden" name="contact[Request]" value="Notify me: {{ product.title }}">
            <input type="hidden" name="contact[tags]" value="notify-next-edition">
            <label for="n-email" style="font-size:14px;font-weight:600">{{ 'echo.main_product.get_an_email_when_a_new_edition_from' | t }}</label>
            <div class="inline-form"><input id="n-email" type="email" name="contact[email]" required placeholder="{{ 'echo.common.your_email' | t | escape }}"><button class="btn" type="submit">{{ 'echo.main_product.notify_me' | t }}</button></div>
          {%- endif -%}
        {%- endform -%}
        <a class="btn ghost block" href="{{ caturl }}">{% assign catname_l = catname | downcase %}{{ 'echo.product.see_current' | t: name: catname_l }}</a>
      {%- else -%}
        <div class="edition">{{ 'echo.product.edition_left_html' | t: total: i[2], left: i[3] }}</div>
        {%- form 'product', product, class: 'stack', style: 'gap:12px', data-pdp-form: '' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <div class="row">
            <div class="qty"><button type="button" data-qty="-1" aria-label="{{ 'echo.common.fewer' | t | escape }}">−</button><span data-qty-out>1</span><button type="button" data-qty="1" aria-label="{{ 'echo.common.more' | t | escape }}">+</button></div>
            <button class="btn" style="flex:1" type="submit"{% unless variant.available %} disabled{% endunless %}>{{ 'echo.main_product.add_to_bag' | t }}</button>
          </div>
          {%- if section.settings.show_mobilepay -%}
            <button class="btn mp block" type="submit" name="return_to" value="/checkout" data-buynow>{{ 'echo.main_product.pay_with_mobilepay' | t }}</button>
          {%- endif -%}
        {%- endform -%}
        <ul class="ticks">
          {%- assign ticks = section.settings.ticks | split: '|' -%}
          {%- for t in ticks -%}<li>{{ t | strip | replace: '[cut-off time]', settings.echo_cutoff }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      <div>
        <details class="acc" open><summary>{{ 'echo.main_product.description' | t }}</summary><div class="body rte">{{ product.description | default: '[Product description]' }}</div></details>
        <details class="acc"><summary>{{ 'echo.main_product.material_and_care' | t }}</summary><div class="body">{{ comp | default: '[Composition]' | newline_to_br }}{% if care != blank %}<br>{{ care | newline_to_br }}{% endif %}</div></details>
        <details class="acc"><summary>{{ 'echo.main_product.dimensions' | t }}</summary><div class="body">{{ dims | default: '[Size]' | newline_to_br }}</div></details>
        <details class="acc"><summary>{{ 'echo.main_product.delivery_and_returns' | t }}</summary><div class="body">{{ section.settings.delivery }} <a class="link" href="{% render 'echo-url', key: 'help' %}#topic-Delivery%20and%20returns">{{ 'echo.main_product.more_about_delivery' | t }}</a></div></details>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_mobilepay", "label": "Show 'Pay with MobilePay' button", "default": true, "info": "Adds the piece and goes straight to checkout." },
    { "type": "text", "id": "ticks", "label": "Ticks (separate with |)", "default": "Order by [cut-off time] on weekdays for delivery in 1 to 2 working days | Free 14-day returns to our Danish address | No price on the packing slip, ready to give" },
    { "type": "textarea", "id": "delivery", "label": "Delivery and returns text", "default": "Free delivery in Denmark in 1 to 2 working days from our Danish warehouse. Free returns within 14 days." },
    { "type": "textarea", "id": "care_wool", "label": "Care text for wool (when no care guide)", "default": "Hand wash cold. Do not bleach. Dry flat after washing. Iron at low temperature. Professional dry clean." },
    { "type": "textarea", "id": "care_cotton", "label": "Care text for cotton (when no care guide)", "default": "Machine wash cold on a gentle cycle. Do not bleach. Dry flat after washing. Iron at medium temperature. Professional dry clean." },
    { "type": "textarea", "id": "ph_labels", "label": "Gallery placeholder labels (separate with |)", "info": "Shown in empty gallery slots until more photos are added. [N] = edition size.", "default": "In use: on a sofa, someone wrapped in it | Scale: on a double bed | 10 sec clip: this design on the knitting machine | Flat lay: full pattern | Woven label: “7 of [N]”" },
    { "type": "textarea", "id": "gc_text", "label": "Gift card text (when product has no description)", "default": "Give the gift of choice. An EchoByJMG eGift card lets your loved one explore our limited-edition collection and choose the piece that speaks to them: a cushion cover, a blanket, a bag or an accessory, all crafted from rescued premium yarns. Delivered instantly by email, redeemable at checkout. No expiry." }
  ]
}
{% endschema %}
