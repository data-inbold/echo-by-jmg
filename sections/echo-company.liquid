<section class="section tight"><div class="wrap grid g2" style="align-items:start">
  <div class="stack" style="gap:14px"><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead" style="margin:0">{{ section.settings.lead }}</p></div>
  <div class="review stack" style="gap:12px;font-size:14px">
    {%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><b>{{ b.settings.label }}</b><br>{{ b.settings.value }}</div>{%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Company details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Company details" },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "EchoByJMG is a brand owned and run by JM Group Limited, a family knitwear maker founded in Hong Kong in 1946." }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Seller" },
      { "type": "inline_richtext", "id": "value", "label": "Value", "default": "JM Group Limited" }
    ] }
  ],
  "presets": [{ "name": "Company details" }]
}
{% endschema %}
