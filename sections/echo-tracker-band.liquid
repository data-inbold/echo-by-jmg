{%- capture echo_out -%}
{%- comment -%}
  Dark band with the headline numbers and the latest batches. Summary of the Rescued yarn tracker, used on About us.
  {kg} and {batches} in a number are calculated from the Yarn Passport fields on the products plus older batches in the
  Yarn batch list (same as the Numbers section and the Rescued yarn tracker page; assets/echo-tracker.js refreshes them in the browser).
{%- endcomment -%}
{%- capture tot -%}{%- render 'echo-batch-totals' -%}{%- endcapture -%}
{%- assign totp = tot | strip | split: '|' -%}
{%- liquid
  assign tok_kg = '{' | append: 'kg' | append: '}'
  assign tok_ed = '{' | append: 'batches' | append: '}'
  assign kg_out = '<span data-yarn-total="kg">' | append: totp[0] | append: '</span>'
  assign ed_out = '<span data-yarn-total="batches">' | append: totp[1] | append: '</span>'
  assign stats = section.blocks | where: 'type', 'stat'
  assign batches = section.blocks | where: 'type', 'batch'
-%}
<style>
  .echo-tband-head{display:flex;justify-content:space-between;align-items:center;gap:16px 40px;flex-wrap:wrap}
  .echo-tband-head .h2{margin:0}
  .echo-tband .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 24px}
  @media(min-width:900px){.echo-tband .stats{grid-template-columns:repeat(4,minmax(0,1fr))}}
  .echo-tband .stat{display:flex;flex-direction:column;align-items:center;text-align:center}
  .echo-tband .stat-img{display:block;width:68px;height:68px;object-fit:contain}
  .echo-tband .stat .n{font:italic 300 clamp(30px,3vw,40px)/1.2 var(--display);color:var(--wine)}
  .echo-tband .stat p{margin:0;font-size:14px;line-height:1.6;color:#332C2A}
  .echo-tband hr{border:0;border-top:1px solid #ABA499;margin:0;width:100%}
  .echo-tband-logl{margin:0 0 12px;font:600 16px/normal var(--body);letter-spacing:.04em;text-transform:uppercase;color:var(--wine)}
  .echo-tband-log{width:100%}
  .echo-tband-log .r{display:grid;grid-template-columns:150px minmax(0,1fr) 100px 120px;align-items:center;border-bottom:1px solid #ABA499;font-size:16px;line-height:1.6;color:#2E2D2C}
  .echo-tband-log .r:last-child{border-bottom:0}
  .echo-tband-log .r>*{padding:8px;text-align:left}
  .echo-tband-log .r>*:first-child{padding-left:0}
  .echo-tband-log .r>*:nth-child(3),.echo-tband-log .r>*:nth-child(4){text-align:right}
  .echo-tband-log .r>*:last-child{padding-right:0}
  .echo-tband-log .r .dt{font-weight:300;color:#7C7E64}
  @media (max-width:749px){.echo-tband-log .r{grid-template-columns:90px minmax(0,1fr) 64px;font-size:14px}.echo-tband-log .r .dt{display:none}.echo-tband-log .r>*{padding:8px 4px}.echo-tband-log .r>*:first-child{padding-left:0}.echo-tband-log .r>*:nth-child(3){padding-right:0}}
</style>
<section class="section {{ section.settings.spacing }} band echo-tband">
  <div class="wrap stack" style="gap:40px">
    <div class="echo-tband-head">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.btn_label != blank -%}<a class="btn ghost arrow" href="{{ section.settings.btn_link | default: 'echo:tracker' }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
    <div class="stack" style="gap:24px">
      {%- if stats.size > 0 -%}
        <div class="stats">
          {%- for b in stats -%}
            {%- assign n = b.settings.n | replace: tok_kg, kg_out | replace: tok_ed, ed_out -%}
            <div class="stat" {{ b.shopify_attributes }}>{% if b.settings.icon_file != blank %}<img class="stat-img" src="{{ b.settings.icon_file | asset_url }}" alt="" width="68" height="68" loading="lazy">{% endif %}<div class="n">{{ n }}</div><p>{{ b.settings.text }}</p></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if batches.size > 0 -%}
        <hr>
        <div style="width:100%">
          {%- if section.settings.log_label != blank -%}<p class="echo-tband-logl">{{ section.settings.log_label }}</p>{%- endif -%}
          <div class="echo-tband-log">
            {%- for b in batches -%}
              <div class="r" {{ b.shopify_attributes }}><span class="id">{{ b.settings.id }}</span><span>{{ b.settings.fibre }}</span><span class="kg">{{ b.settings.kg }}</span><span class="dt">{{ b.settings.date }}</span></div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{%- render 'echo-yarn-history' -%}
{% schema %}
{
  "name": "Tracker band (dark)",
  "settings": [
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "03 · Rescued yarn tracker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every batch we have saved, in the open" },
    { "type": "text", "id": "btn_label", "label": "Button text", "default": "Open the tracker" },
    { "type": "text", "id": "btn_link", "label": "Button link", "default": "echo:tracker" },
    { "type": "text", "id": "log_label", "label": "Label above the batches", "default": "Latest batches" }
  ],
  "blocks": [
    { "type": "stat", "name": "Number", "settings": [
      { "type": "text", "id": "n", "label": "Number", "default": "{kg}", "info": "{kg} = total yarn rescued, {batches} = number of batches, calculated from the Yarn Passport fields on the products plus older batches in the Yarn batch list." },
      { "type": "text", "id": "text", "label": "Text", "default": "yarn rescued" },
      { "type": "text", "id": "icon_file", "label": "Icon file", "info": "File name in assets, for example echo-stat-yarn.png. Empty = no icon." }
    ] },
    { "type": "batch", "name": "Batch", "settings": [
      { "type": "text", "id": "id", "label": "Batch ID", "default": "HV-2417" },
      { "type": "text", "id": "fibre", "label": "Fibre", "default": "80% lambswool, 20% nylon" },
      { "type": "text", "id": "kg", "label": "Weight", "default": "14 kg" },
      { "type": "text", "id": "date", "label": "Month", "default": "Sep 2026" }
    ] }
  ],
  "presets": [{ "name": "Tracker band (dark)" }]
}
{% endschema %}
