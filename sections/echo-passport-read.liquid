{%- comment -%} (Shopify section names are limited to 25 characters.) "How to read your Yarn Passport": a photo on the left and a list of four labelled rows on the right, inside a stone panel. {%- endcomment -%}
<style>
  .pr{background:#F0DFD8;padding:{{ section.settings.pad }}px 16px}
  @media(min-width:720px){.pr{padding-inline:max(80px,calc((100vw - var(--wrap)) / 2 + 80px))}}
  .pr-box{background:#F2EEEA;display:grid;grid-template-columns:1fr;gap:24px;align-items:stretch}
  @media(min-width:960px){.pr-box{grid-template-columns:minmax(0,519px) minmax(0,1fr)}}
  .pr-photo{position:relative;min-height:320px;background:#d8d0c6}
  @media(min-width:960px){.pr-photo{min-height:620px}}
  .pr-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focus }}}
  .pr-body{padding:32px 20px;display:flex;flex-direction:column;gap:24px;justify-content:center}
  @media(min-width:960px){.pr-body{padding:40px 20px}}
  .pr-h{margin:0;font:300 clamp(28px,2.8vw,40px)/normal var(--display);color:var(--wine)}
  .pr-list{display:flex;flex-direction:column;gap:24px;padding-block:20px}
  .pr-row{display:flex;align-items:center;gap:24px}
  .pr-ic{flex:none;width:68px;height:68px;object-fit:contain}
  .pr-txt{display:flex;flex-direction:column;gap:8px;min-width:0}
  @media(min-width:720px){.pr-txt{flex-direction:row;align-items:center;gap:24px}}
  .pr-lb{margin:0;font:italic 300 clamp(24px,2.2vw,32px)/normal var(--display);color:var(--wine)}
  @media(min-width:720px){.pr-lb{flex:none;width:210px}}
  .pr-tx{margin:0;font:400 14px/1.6 var(--body);color:#332C2A}
  @media(min-width:720px){.pr-tx{flex:none;width:min(302px,100%)}}
  .pr-hr{height:0;border:0;border-top:1px solid #CFC9C0;margin:0}
</style>
<section class="pr">
  <div class="pr-box">
    <div class="pr-photo">
      {%- if section.settings.photo != blank -%}
        {{ section.settings.photo | image_url: width: 1100 | image_tag: alt: section.settings.alt, loading: 'lazy', widths: '519, 780, 1038, 1100', sizes: '(min-width: 960px) 519px, 100vw' }}
      {%- elsif section.settings.photo_file != blank -%}
        <img src="{{ section.settings.photo_file | asset_url }}" alt="{{ section.settings.alt | escape }}" width="1038" height="1240" loading="lazy">
      {%- endif -%}
    </div>
    <div class="pr-body">
      <h2 class="pr-h">{{ section.settings.heading }}</h2>
      <div class="pr-list">
        {%- for b in section.blocks -%}
          <div class="pr-row" {{ b.shopify_attributes }}>
            {%- if b.settings.icon_file != blank -%}<img class="pr-ic" src="{{ b.settings.icon_file | asset_url }}" alt="" width="68" height="68" loading="lazy">{%- endif -%}
            <div class="pr-txt"><p class="pr-lb">{{ b.settings.label }}</p><p class="pr-tx">{{ b.settings.text }}</p></div>
          </div>
          {%- unless forloop.last -%}<hr class="pr-hr">{%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Read your passport",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How To Read Your Yarn Passport" },
    { "type": "image_picker", "id": "photo", "label": "Photo", "info": "About 1040 x 1240 px. Empty = the file named below." },
    { "type": "text", "id": "photo_file", "label": "Photo file in assets", "default": "echo-hv-cushion-oat.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A knitted cushion cover with its Yarn Passport" },
    { "type": "text", "id": "focus", "label": "Photo focus", "info": "For example 50% 50%.", "default": "50% 50%" },
    { "type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "icon_file", "label": "Icon file", "info": "File name in assets, for example echo-stat-yarn.png." },
      { "type": "text", "id": "label", "label": "Label", "default": "Origin" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Where the rescued yarn came from." }
    ] }
  ],
  "presets": [{ "name": "Read your passport", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
