{%- capture echo_out -%}
{%- comment -%} Home hero, option 2: text on a photo (left) and a product slider (right). {%- endcomment -%}
<style>
  .hd{display:grid;grid-template-columns:1fr;background:#fff}
  @media(min-width:980px){.hd{grid-template-columns:800fr 640fr;min-height:620px}}
  .hd-l{position:relative;overflow:hidden;background:#EDEAE1;min-height:420px;display:flex;align-items:center}
  .hd-l .ph{position:absolute;inset:0;border:0;background:transparent}
  .hd-l .ph img{object-position:{{ section.settings.focus }}}
  .hd-l::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(246,245,241,.88) 0%,rgba(246,245,241,.55) 55%,rgba(246,245,241,.1) 100%);pointer-events:none}
  .hd-thread{position:absolute;right:-60px;top:-60px;width:340px;height:340px;z-index:1;pointer-events:none}
  .hd-in{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;gap:22px;padding:clamp(32px,6vw,80px);max-width:640px}
  .hd-h{font:400 clamp(36px,3.9vw,56px)/1.36 var(--display);color:var(--olive);margin:0}
  .hd-in p{margin:0;max-width:437px;font-size:14px;line-height:1.6;color:var(--ink)}
  .hd-r{position:relative;background:#fff;padding:20px 20px 24px;display:flex;flex-direction:column;gap:12px;min-width:0}
  .hd-stage{position:relative;aspect-ratio:600/480;overflow:hidden;background:var(--soft)}
  .hd-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s ease;pointer-events:none}
  .hd-slide.on{opacity:1;pointer-events:auto}
  .hd-slide .ph{position:absolute;inset:0;border:0;min-height:0!important;aspect-ratio:auto!important;height:100%}
  .hd-slide a{position:absolute;inset:0;z-index:2}
  .hd-bar{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}
  .hd-cap{display:flex;flex-direction:column;gap:8px;align-items:flex-start;min-width:0}
  .hd-cap .t{font-size:16px;color:var(--muted)}
  .hd-cap a{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:#252729;border-bottom:1px solid #2E2D2C;padding:4px 0}
  .hd-pager{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink);white-space:nowrap}
  .hd-dots{display:flex;gap:4px;align-items:center}
  .hd-dots button{border:0;padding:0;width:4px;height:4px;border-radius:30px;background:#D7D5CB;cursor:pointer;transition:width .25s ease,background .25s ease}
  .hd-dots button[aria-current="true"]{width:30px;background:#777873}
  .hd-pager .tot{color:#A8A99B}
  @media(prefers-reduced-motion:reduce){.hd-slide{transition:none}}
  @media(max-width:979px){.hd-thread{display:none}}
</style>
<section class="hd" data-hd>
  <div class="hd-l">
    {%- render 'echo-pic', image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: 'Hero photo', eager: true, sizes: '(min-width: 980px) 56vw, 100vw' -%}
    <svg class="hd-thread" viewBox="0 0 340 340" fill="none" aria-hidden="true"><path d="M40 20C120 -10 300 30 310 130 320 230 210 300 130 270 50 240 90 120 190 110" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity=".9"/></svg>
    <div class="hd-in">
      <h1 class="hd-h">{{ section.settings.heading }}</h1>
      {%- if section.settings.lead != blank -%}<p>{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
      <div class="row">
        {%- if section.settings.btn1_label != blank -%}<a class="btn" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="btn sec" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="hd-r">
    <div class="hd-stage" aria-roledescription="carousel" aria-label="Featured pieces">
      {%- for b in section.blocks -%}
        <div class="hd-slide{% if forloop.first %} on{% endif %}" data-slide data-title="{{ b.settings.title | escape }}" data-link="{{ b.settings.link }}" {{ b.shopify_attributes }}>
          {%- render 'echo-pic', image: b.settings.image, asset: b.settings.photo, alt: b.settings.title, label: b.settings.title, sizes: '(min-width: 980px) 600px, 100vw', eager: forloop.first -%}
          <a href="{{ b.settings.link }}" tabindex="-1" aria-label="{{ b.settings.title | escape }}"></a>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="hd-bar">
        <div class="hd-cap"><span class="t" data-cap>{{ section.blocks.first.settings.title }}</span><a data-cap-link href="{{ section.blocks.first.settings.link }}">{{ section.settings.link_label }}</a></div>
        <div class="hd-pager" aria-live="off"><span class="hd-dots">{% for b in section.blocks %}<button type="button" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</span><span><span data-n>1</span><span class="tot">/{{ section.blocks.size }}</span></span></div>
      </div>
    {%- endif -%}
  </div>
</section>
<script>
(function(){
  var root=document.currentScript.previousElementSibling;
  if(!root||!root.hasAttribute('data-hd'))return;
  var slides=[].slice.call(root.querySelectorAll('[data-slide]'));
  if(slides.length<2)return;
  var dots=[].slice.call(root.querySelectorAll('.hd-dots button'));
  var cap=root.querySelector('[data-cap]'),lnk=root.querySelector('[data-cap-link]'),num=root.querySelector('[data-n]');
  var i=0,t=null,reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  function go(n){
    i=(n+slides.length)%slides.length;
    slides.forEach(function(s,k){s.classList.toggle('on',k===i)});
    dots.forEach(function(d,k){if(k===i)d.setAttribute('aria-current','true');else d.removeAttribute('aria-current')});
    cap.textContent=slides[i].getAttribute('data-title');lnk.setAttribute('href',slides[i].getAttribute('data-link'));num.textContent=i+1;
  }
  function play(){if(reduce)return;stop();t=setInterval(function(){go(i+1)},5500)}
  function stop(){if(t){clearInterval(t);t=null}}
  dots.forEach(function(d,k){d.addEventListener('click',function(){go(k);play()})});
  root.addEventListener('mouseenter',stop);root.addEventListener('mouseleave',play);
  root.addEventListener('focusin',stop);root.addEventListener('focusout',play);
  play();
})();
</script>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Hero split with slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where luxury yarn finds a second life." },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Zero waste, 100% luxury quality. Discover limited-edition pieces born from surplus designer yarn." },
    { "type": "text", "id": "btn1_label", "label": "Button 1", "default": "Shop now" },
    { "type": "text", "id": "btn1_link", "label": "Button 1 link", "default": "echo:shop-all" },
    { "type": "text", "id": "btn2_label", "label": "Button 2", "default": "How it works" },
    { "type": "text", "id": "btn2_link", "label": "Button 2 link", "default": "#how" },
    { "type": "image_picker", "id": "image", "label": "Left photo" },
    { "type": "text", "id": "photo", "label": "Bundled left photo file", "info": "Used when no photo is picked. File name in assets.", "default": "echo-v2-hero.jpg" },
    { "type": "text", "id": "alt", "label": "Left photo description", "default": "Cones of green, mustard, cream and pink yarn resting on a knitted blanket" },
    { "type": "text", "id": "focus", "label": "Left photo focus (CSS position)", "default": "75% 85%" },
    { "type": "text", "id": "link_label", "label": "Slide link text", "default": "View products" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Twisted Rope Knitted Blanket" },
        { "type": "text", "id": "link", "label": "Link", "default": "echo:shop-all", "info": "Page address or echo:shop-all" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "photo", "label": "Bundled photo file", "default": "echo-twister-outdoor.jpg" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Hero split with slider", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
