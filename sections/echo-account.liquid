{%- capture u_home -%}{%- render 'echo-url', key: 'home' -%}{%- endcapture -%}
{%- assign t_home = 'echo.common.home' | t -%}{%- assign t_account = 'echo.common.account' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_account -%}
{%- render 'echo-crumbs', list: cl -%}
<section class="section tight"><div class="wrap stack" style="gap:28px">
  <div class="row" style="justify-content:space-between"><h1 class="h1">{%- assign c_name = customer.first_name | default: customer.name | escape -%}{{ 'echo.account.hello_html' | t: name: c_name }}</h1><a class="btn ghost" href="{{ routes.account_logout_url }}">{{ 'echo.account.log_out' | t }}</a></div>
  <div><h2 class="h3" style="margin-bottom:12px">{{ 'echo.account.your_orders' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      {%- paginate customer.orders by 20 -%}
      <div class="tablewrap"><table class="plain" style="min-width:560px">
        <thead><tr><th>{{ 'echo.account.order' | t }}</th><th>{{ 'echo.account.date' | t }}</th><th>{{ 'echo.account.items' | t }}</th><th style="text-align:right">{{ 'echo.account.total' | t }}</th><th>{{ 'echo.common.status' | t }}</th><th></th></tr></thead><tbody>
        {%- for o in customer.orders -%}
          <tr><td>{{ o.name }}</td><td>{% render 'echo-date', d: o.created_at %}</td><td>{{ o.line_items.first.title }}{% if o.line_items.size > 1 %}{% assign more_n = o.line_items.size | minus: 1 %} {{ 'echo.account.more_items' | t: count: more_n }}{% endif %}</td><td style="text-align:right;font-variant-numeric:tabular-nums">{% render 'echo-money', price: o.total_price %}</td><td>{{ o.fulfillment_status_label }}</td><td style="text-align:right"><a class="link" href="{{ o.customer_url }}">{{ 'echo.account.view' | t }}</a></td></tr>
        {%- endfor -%}
        </tbody></table></div>
      {%- endpaginate -%}
    {%- else -%}
      <div class="review muted">{{ 'echo.account.no_orders_yet' | t }} <a class="link" href="{% render 'echo-url', key: 'shop-all' %}">{{ 'echo.common.shop_the_editions' | t }}</a></div>
    {%- endif -%}
  </div>
  <div class="grid g3">
    <div class="review stack" style="gap:8px"><h2 class="h3">{{ 'echo.common.address' | t }}</h2><span class="muted">{%- assign no_addr = 'echo.account.no_address' | t -%}{{ customer.default_address | format_address | default: no_addr }}</span><a class="textbtn" style="align-self:flex-start" href="{{ routes.account_addresses_url }}">{{ 'echo.account.edit' | t }}</a></div>
    <div class="review stack" style="gap:8px"><h2 class="h3">{{ 'echo.account.your_yarn_passports' | t }}</h2><span class="muted">{{ 'echo.account.every_piece_you_own_with_its_batch_and' | t }}</span>{% if customer.orders.size > 0 %}<a class="link" style="align-self:flex-start" href="{{ customer.orders.first.customer_url }}">{{ 'echo.account.see_passports' | t }}</a>{% endif %}</div>
    <div class="review stack" style="gap:8px"><h2 class="h3">{{ 'echo.account.cozy_club' | t }}</h2><span class="muted">{% if customer.accepts_marketing %}{{ 'echo.account.you_get_emails_about_new_editions' | t }}{% else %}{{ 'echo.account.join_for_first_access_to_new_editions' | t }}{% endif %}</span><a class="link" style="align-self:flex-start" href="{% render 'echo-url', key: 'returns' %}">{{ 'echo.account.start_a_return' | t }}</a></div>
  </div>
</div></section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
