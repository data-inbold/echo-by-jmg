<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap grid g2">
    <div class="stack"><h2 class="h3">{{ section.settings.heading }}</h2><p class="muted" style="margin:0">{{ section.settings.text }}</p>
      <div class="certrow">{% render 'echo-cert-logo', k: 'bsci', h: 64, cls: 'mb' %}{% render 'echo-cert-logo', k: 'ocs', h: 64, cls: 'mb' %}{% render 'echo-cert-logo', k: 'rcs', h: 64, cls: 'mb' %}</div>
      <div><a class="link" href="{% render 'echo-url', key: 'factory' %}">Factory and certificates</a></div></div>
    <div class="row"><a class="btn" href="{% render 'echo-url', key: 'shop-all' %}">Shop the current editions</a>
      {%- if section.settings.film_url != blank -%}<a class="btn ghost" href="{{ section.settings.film_url }}" target="_blank" rel="noopener">{{ section.settings.film_label }}</a>{%- else -%}<button class="btn ghost" data-toast="The factory film is coming soon.">{{ section.settings.film_label }}</button>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Where it is made",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Black"}], "default": "paper"},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where and how it is made" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Made in our own factory in [city], China, owned and run by the family since [year]. Audited under BSCI, with RCS and OCS certified materials where they apply." },
    { "type": "text", "id": "film_label", "label": "Film button", "default": "Watch the factory film (3 min)" },
    { "type": "url", "id": "film_url", "label": "Film link (YouTube)" }
  ],
  "presets": [{ "name": "Where it is made" }]
}
{% endschema %}
