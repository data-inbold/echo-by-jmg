{%- comment -%} Policy page (returns, shipping, privacy ...): breadcrumbs (Home / this page), then a centred column with a heading, an intro and open/close questions separated by thin lines. {%- endcomment -%}
{%- liquid
  capture u_home
    render 'echo-url', key: 'home'
  endcapture
  assign t_home = 'echo.common.home' | t
  assign crumb_list = t_home | append: '::' | append: u_home | append: '||' | append: section.settings.crumb_current
-%}
<style>
  .pp{padding-block:{{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px}
  .pp .crumbs{padding:0 0 40px}
  .pp .wrap>.crumbs{max-width:none;margin:0}
  .pp-col{max-width:628px;margin-inline:auto;display:flex;flex-direction:column;gap:24px}
  .pp-h{margin:0;font:300 clamp(30px,2.8vw,40px)/normal var(--display);color:var(--wine)}
  .pp-intro{margin:0;font:400 14px/1.6 var(--body);color:#332C2A}
  .pp-list{border-top:1px solid #ABA499}
  .pp-list details{border-bottom:1px solid #ABA499;padding:16px 0 24px}
  .pp-list details:last-child{border-bottom:0}
  .pp-list summary{display:flex;align-items:center;justify-content:space-between;gap:16px;list-style:none;cursor:pointer;padding:8px 0;font:500 16px/26px var(--body);color:#332C2A}
  .pp-list summary::-webkit-details-marker{display:none}
  .pp-list summary::after{content:none!important}
  .pp-list .pp-ic{flex:none;width:24px;height:24px}
  .pp-list .pp-x{display:none}
  .pp-list details[open] .pp-x{display:block}
  .pp-list details[open] .pp-p{display:none}
  .pp-body{max-width:519px;padding-top:8px;font:400 14px/1.6 var(--body);color:#332C2A}
  .pp-body p{margin:0 0 1.6em}
  .pp-body p:last-child{margin-bottom:0}
  .pp-body a,.pp-body strong{font-weight:600;color:#332C2A}
</style>
<section class="pp">
  <div class="wrap">
    {%- render 'echo-crumbs', list: crumb_list -%}
    <div class="pp-col">
      <h1 class="pp-h">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<p class="pp-intro">{{ section.settings.intro }}</p>{%- endif -%}
      <div class="pp-list">
        {%- for b in section.blocks -%}
          <details {{ b.shopify_attributes }}{% if section.settings.open_all %} open{% endif %}><summary>{{ b.settings.q }}<svg class="pp-ic pp-p" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224 128a8 8 0 0 1-8 8h-80v80a8 8 0 0 1-16 0v-80H40a8 8 0 0 1 0-16h80V40a8 8 0 0 1 16 0v80h80a8 8 0 0 1 8 8Z"/></svg><svg class="pp-ic pp-x" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128 50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/></svg></summary><div class="pp-body rte">{{ b.settings.a }}</div></details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "text", "id": "crumb_current", "label": "Breadcrumb: this page", "default": "Returns" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Return Policy" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "checkbox", "id": "open_all", "label": "Show all answers open", "default": true },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" }
  ],
  "blocks": [
    { "type": "item", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ],
  "presets": [{ "name": "Policy page", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
