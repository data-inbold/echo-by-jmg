{%- capture echo_out -%}
{%- comment -%} Questions and answers with live search and topic chips. Add a "Topic" block, then its questions below it. {%- endcomment -%}
{%- liquid
  assign topics = section.blocks | where: 'type', 'topic'
-%}
<style>
  .hp{padding:24px 0 0}
  .hp-top{display:grid;gap:24px;align-items:end;padding-bottom:32px;border-bottom:1px solid var(--line)}
  @media(min-width:960px){.hp-top{grid-template-columns:737fr 519fr;gap:24px}}
  .hp-search{display:flex;align-items:center;gap:12px;border-bottom:1px solid #332C2A;padding:10px 0}
  .hp-search input{flex:1;border:0;background:transparent;font:400 16px/1.5 var(--body);padding:4px 0;min-height:32px;outline-offset:4px}
  .hp-search svg{flex:none;width:20px;height:20px}
  .hp-main{display:grid;gap:32px;padding:40px 0 20px}
  @media(min-width:960px){.hp-main{grid-template-columns:216px 1fr;gap:34px}}
  .hp-tags{display:flex;flex-wrap:wrap;gap:8px;align-content:flex-start}
  @media(min-width:960px){.hp-tags{flex-direction:column;align-items:flex-start;position:sticky;top:120px;align-self:start}}
  .hp-tags .chip{border-radius:999px}
  .hp-tags .chip[aria-pressed="true"]{background:#332C2A;color:#fff;border-color:#332C2A}
  .hp-res{max-width:950px}
  .hp-res [data-topic-group]{counter-reset:q;margin-bottom:40px}
  .hp-res h2{font:400 clamp(26px,2.6vw,32px)/1.2 var(--display);color:var(--wine);margin:0;padding-bottom:16px;border-bottom:1px solid var(--line)}
  .hp-res details.acc{counter-increment:q}
  .hp-res details.acc summary{font:500 16px/26px var(--body);justify-content:flex-start;gap:6px}
  .hp-res details.acc summary::before{content:counter(q) ".";flex:none}
  .hp-res details.acc summary::after{content:"";margin-left:auto;width:16px;height:16px;flex:none;align-self:center;background:linear-gradient(currentColor,currentColor) center/16px 1.2px no-repeat,linear-gradient(currentColor,currentColor) center/1.2px 16px no-repeat;transition:transform .2s}
  .hp-res details.acc[open] summary::after{content:"";transform:rotate(45deg)}
  .hp-res details.acc .body{max-width:734px}
</style>
<section class="hp"><div class="wrap">
  <div class="hp-top">
    {%- assign hh = section.settings.heading -%}{%- if hh == blank -%}{%- assign hh = 'echo.help.questions_and_answers' | t -%}{%- endif -%}
    <h1 class="h1" style="margin:0">{{ hh }}</h1>
    <label class="hp-search" for="faq-q">
      <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72 72.08 72.08 0 0 1-72-72Z"/></svg>
      <span class="visually-hidden">{{ 'echo.help.search_the_answers' | t }}</span>
      <input id="faq-q" type="search" placeholder="{{ 'echo.help.for_example_delivery_wash_gift' | t | escape }}">
      <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z"/></svg>
    </label>
  </div>
  <div class="hp-main">
    <div class="hp-tags"><button class="chip" data-topic="" aria-pressed="true">{{ 'echo.help.all_topics' | t }}</button>{% for t in topics %}<button class="chip" data-topic="{{ t.settings.title | escape }}" aria-pressed="false">{{ t.settings.title }}</button>{% endfor %}</div>
    <div id="faq-results" class="hp-res">
    {%- liquid
      assign open = false
      for b in section.blocks
        if b.type == 'topic'
          if open
            echo '</div>'
          endif
          assign tt = b.settings.title | escape
          echo '<div data-topic-group="' | append: tt | append: '" ' | append: b.shopify_attributes | append: '><h2>' | append: b.settings.title | append: '</h2>'
          assign open = true
          assign is_first = true
        else
          assign ans = b.settings.a | replace: '[cut-off time]', settings.echo_cutoff
          assign op = ''
          if is_first
            assign op = ' open'
          endif
          assign is_first = false
          echo '<details class="acc"' | append: op | append: ' ' | append: b.shopify_attributes | append: '><summary>' | append: b.settings.q | append: '</summary><div class="body">' | append: ans | append: '</div></details>'
        endif
      endfor
      if open
        echo '</div>'
      endif
    -%}
    <div class="review" data-faq-none hidden>{%- capture u_contact -%}{%- render 'echo-url', key: 'contact' -%}{%- endcapture -%}{{ 'echo.help.no_match_html' | t: contact_url: u_contact }}</div>
    </div>
  </div>
</div></section>
{%- if section.settings.show_alt -%}
<section class="section alt"><div class="wrap grid g2">
  <div class="stack"><h2 class="h3">{{ 'echo.help.did_not_find_it' | t }}</h2><p class="muted" style="margin:0">{{ section.settings.contact_text }}</p><div><a class="btn" href="{% render 'echo-url', key: 'contact' %}">{{ 'echo.help.contact_us' | t }}</a></div></div>
  <div class="stack"><h2 class="h3">{{ 'echo.help.guides' | t }}</h2>
    {%- if section.settings.g1_label != blank -%}<a class="link" href="{{ section.settings.g1_link }}" style="align-self:flex-start">{{ section.settings.g1_label }}</a>{%- endif -%}
    {%- if section.settings.g2_label != blank -%}<a class="link" href="{{ section.settings.g2_link }}" style="align-self:flex-start">{{ section.settings.g2_label }}</a>{%- endif -%}
    {%- if section.settings.g3_label != blank -%}<a class="link" href="{{ section.settings.g3_link }}" style="align-self:flex-start">{{ section.settings.g3_label }}</a>{%- endif -%}
  </div>
</div></section>
{%- endif -%}
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Questions and answers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the translated heading." },
    { "type": "checkbox", "id": "show_alt", "label": "Show 'Did not find it?' band", "default": false },
    { "type": "textarea", "id": "contact_text", "label": "Contact text", "default": "Write to hello@echobyjmg.com. We reply within 24 hours on weekdays." },
    { "type": "text", "id": "g1_label", "label": "Guide 1", "default": "How to wash a lambswool blanket" },
    { "type": "text", "id": "g1_link", "label": "Guide 1 link", "default": "echo:journal/how-to-wash-a-lambswool-blanket" },
    { "type": "text", "id": "g2_label", "label": "Guide 2", "default": "How to choose a knitted blanket" },
    { "type": "text", "id": "g2_link", "label": "Guide 2 link", "default": "echo:journal/how-to-choose-a-knitted-blanket" },
    { "type": "text", "id": "g3_label", "label": "Guide 3", "default": "The Yarn Passport explained" },
    { "type": "text", "id": "g3_link", "label": "Guide 3 link", "default": "echo:passport" }
  ],
  "blocks": [
    { "type": "topic", "name": "Topic", "settings": [ { "type": "text", "id": "title", "label": "Topic", "default": "Delivery and returns" } ] },
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "How fast do you deliver?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Free delivery across Denmark, usually within 2 working days.</p>" }
    ] }
  ],
  "presets": [{ "name": "Questions and answers" }]
}
{% endschema %}
