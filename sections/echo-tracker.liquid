{%- comment -%}
  Rescued yarn tracker.
  1. Server side: rows come from the "Yarn batch" list (Content > Metaobjects), newest first. This is the history
     (closed batches whose products are gone). Until that list has entries, the blocks below are used instead.
  2. Browser side (assets/echo-tracker.js): the Yarn Passport metafields on the products are read through the
     feed templates/collection.yarn-data.liquid, grouped by batch (kg and pieces added up per product, status from live stock),
     and shown instead of any list row with the same batch ID. The four numbers at the top are recalculated.
  If the script cannot run, the server-rendered rows stay.
{%- endcomment -%}
{%- liquid
  assign total_pieces = 0
  assign open_count = 0
  assign total_kg = 0
  assign batch_count = 0
  assign vals = shop.metaobjects.yarn_batch.values
  assign use_list = false
  if vals.size > 0
    assign use_list = true
  endif
  capture rows
    if use_list
      assign keys = ''
      for yb in vals
        assign dk = yb.logged.value | date: '%Y-%m-%d' | default: '0000-00-00'
        assign keys = keys | append: dk | append: '#' | append: forloop.index0 | append: ','
      endfor
      assign keys = keys | split: ',' | sort | reverse
      for k in keys
        assign idx = k | split: '#' | last | plus: 0
        comment
          Shopify's metaobject list can only be looped over, not indexed (vals[idx] is empty), so find the entry by position.
        endcomment
        assign yb = nil
        for cand in vals
          if forloop.index0 == idx
            assign yb = cand
            break
          endif
        endfor
        if yb == nil
          continue
        endif
        assign kgv = yb.kg.value | default: 0
        assign kgr = kgv | round
        if kgr == kgv
          assign kgv = kgr
        endif
        assign total_kg = total_kg | plus: kgv
        assign batch_count = batch_count | plus: 1
        assign dstr = yb.logged.value | date: '%Y-%m'
        assign is_closed = false
        if yb.closed.value == true
          assign is_closed = true
        endif
        assign po = 0
        assign row_bid = yb.batch_id.value | escape
        assign row_logged = yb.logged.value | date: '%Y-%m-%d'
        assign row_attrs = 'data-src="mo" data-bid="' | append: row_bid | append: '" data-logged="' | append: row_logged | append: '"'
        capture out
          render 'echo-tracker-row', bid: yb.batch_id.value, dstr: dstr, fibre: yb.fibre.value, kg: kgv, prods: yb.products.value, closed: is_closed, closed_name: yb.closed_name.value, closed_pieces: yb.closed_pieces.value, pieces_override: po, attrs: row_attrs
        endcapture
        assign parts = out | strip | split: '@@'
        assign total_pieces = total_pieces | plus: parts[0]
        if parts[1] != '0'
          assign open_count = open_count | plus: 1
        endif
        echo parts[2]
      endfor
    else
      for b in section.blocks
        assign block_attrs = 'data-src="block" ' | append: b.shopify_attributes
        capture out
          render 'echo-tracker-row', bid: b.settings.id, dstr: b.settings.date, fibre: b.settings.fibre, kg: b.settings.kg, prods: b.settings.products, closed: b.settings.closed, closed_name: b.settings.closed_name, closed_pieces: b.settings.closed_pieces, pieces_override: b.settings.pieces_override, attrs: block_attrs
        endcapture
        assign parts = out | strip | split: '@@'
        assign total_pieces = total_pieces | plus: parts[0]
        if parts[1] != '0'
          assign open_count = open_count | plus: 1
        endif
        echo parts[2]
      endfor
    endif
  endcapture
  if use_list
    assign tkr = total_kg | round
    if tkr == total_kg
      assign total_kg = tkr
    endif
    assign kg_label = total_kg | append: ' kg'
    assign ed_label = batch_count
  else
    assign kg_label = settings.echo_rescued_kg
    assign ed_label = settings.echo_editions
  endif
-%}
<section class="section tight"><div class="wrap stack" style="gap:14px"><span class="mono">{{ section.settings.eyebrow }}</span><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead" style="margin:0">{{ section.settings.lead }}</p></div></section>
<section class="section band tight"><div class="wrap stats">
  <div class="stat"><div class="n" data-stat="kg">{{ kg_label }}</div><p>yarn rescued to date</p></div>
  <div class="stat"><div class="n" data-stat="batches">{{ ed_label }}</div><p>batches and editions</p></div>
  <div class="stat"><div class="n" data-stat="pieces">{{ total_pieces }}</div><p>numbered pieces made</p></div>
  <div class="stat"><div class="n" data-stat="open">{{ open_count }}</div><p>editions still open</p></div>
</div></section>
<section class="section"><div class="wrap stack" style="gap:16px" id="yarn-tracker" data-src="{{ routes.all_products_collection_url }}?view=yarn-data">
  <div class="row" style="justify-content:space-between"><h2 class="h2">The batch log</h2><a class="btn" href="{% render 'echo-url', key: 'open' %}">Shop open editions</a></div>
  <div class="tablewrap"><table class="tracker"><thead><tr><th>Batch</th><th>Logged</th><th>Fibre</th><th class="num">Yarn</th><th>Became</th><th class="num">Pieces</th><th>Status</th></tr></thead><tbody>{{ rows }}</tbody></table></div>
  {%- if section.settings.note != blank -%}<p class="muted" style="font-size:13px;margin:0">{{ section.settings.note }}</p>{%- endif -%}
</div></section>{% schema %}
{
  "name": "Rescued yarn tracker",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Updated each time a batch is logged" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rescued yarn tracker" },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Every batch of leftover yarn we have saved, what it became and whether you can still buy it. Each row matches the batch ID on a Yarn Passport." },
    { "type": "text", "id": "note", "label": "Note under table", "default": "[Example figures. The real log is kept by the factory team and updated per batch.]" },
    { "type": "paragraph", "content": "Batches with products come from the Yarn Passport fields on each product (batch ID, kg, pieces, fibre; optional Logged date), added up per batch and shown live. Older batches whose products are gone are kept in Shopify admin › Content › Metaobjects › Yarn batch. The batch blocks below are only used while that list is empty." }
  ],
  "blocks": [
    { "type": "batch", "name": "Batch", "settings": [
      { "type": "text", "id": "id", "label": "Batch ID", "default": "HV-2417" },
      { "type": "text", "id": "date", "label": "Logged (YYYY-MM)", "default": "2026-09" },
      { "type": "text", "id": "fibre", "label": "Fibre", "default": "80% lambswool, 20% nylon" },
      { "type": "number", "id": "kg", "label": "Yarn (kg)", "default": 14 },
      { "type": "product_list", "id": "products", "label": "Became (products)", "limit": 10 },
      { "type": "number", "id": "pieces_override", "label": "Pieces made (optional override)", "default": 0 },
      { "type": "checkbox", "id": "closed", "label": "Edition closed (no longer sold)", "default": false },
      { "type": "text", "id": "closed_name", "label": "Closed: what it became" },
      { "type": "number", "id": "closed_pieces", "label": "Closed: pieces made", "default": 12 }
    ] }
  ],
  "presets": [{ "name": "Rescued yarn tracker" }]
}
{% endschema %}
