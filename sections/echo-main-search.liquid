{%- capture u_home -%}{%- render 'echo-url', key: 'home' -%}{%- endcapture -%}
{%- assign t_home = 'echo.common.home' | t -%}{%- assign t_search = 'echo.common.search' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_search -%}
{%- render 'echo-crumbs', list: cl -%}
<section class="section tight">
  <div class="wrap stack" style="gap:20px">
    <span class="mono">{{ 'echo.common.search' | t }}</span>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search" style="position:static;background:none;overflow:visible">
      <input type="hidden" name="type" value="product">
      <input name="q" type="search" value="{{ search.terms | escape }}" placeholder="{{ 'echo.main_search.search_blankets_bags_colours' | t | escape }}" aria-label="{{ 'echo.common.search' | t | escape }}">
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted">{{ 'echo.common.results_count' | t: count: search.results_count }}</p>
        <div class="grid g4">
          {%- for r in search.results -%}
            {%- if r.object_type == 'product' -%}{%- render 'echo-card', product: r -%}
            {%- else -%}<a class="card" href="{{ r.url }}">{%- render 'echo-ph', label: r.object_type, ar: '4/3' -%}<div class="meta"><span class="name">{{ r.title }}</span></div></a>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
