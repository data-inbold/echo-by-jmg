{%- capture echo_out -%}
{%- comment -%}
  Factory clips: big vertical film cards in a snap-scrolling row, frosted play button, hover preview, full-screen player on click,
  scroll progress bar. Optional article cards underneath. Used on About us and Stories.
{%- endcomment -%}
{%- assign clips = section.blocks | where: 'type', 'clip' -%}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
<style>
  .cl-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}
  .cl-tools{display:flex;align-items:center;gap:14px;font-size:13px;color:var(--muted)}
  .cl-arrows{display:flex;gap:8px}
  .cl-arrows button{width:44px;height:44px;border:1px solid var(--line);background:#fff;border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:background-color .18s,color .18s,border-color .18s}
  .cl-arrows button:hover:not(:disabled){background:var(--wine);color:#fff;border-color:var(--wine)}
  .cl-arrows button:disabled{opacity:.35;cursor:default}
  .cl-row{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:2px;padding:4px 2px 6px;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 56px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 56px),transparent)}
  .cl-row.at-end{-webkit-mask-image:none;mask-image:none}
  .cl-row::-webkit-scrollbar{display:none}
  .cl-card{flex:0 0 clamp(248px,25vw,340px);scroll-snap-align:start;display:flex;flex-direction:column;gap:10px}
  .cl-frame{position:relative;aspect-ratio:9/16;border-radius:26px;overflow:hidden;background:var(--g,#380F1C);color:#fff;isolation:isolate;cursor:pointer;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s;box-shadow:0 1px 2px rgba(56,15,28,.12),0 12px 30px -14px rgba(56,15,28,.45)}
  .cl-frame:hover,.cl-frame:focus-visible{transform:translateY(-4px) scale(1.012);box-shadow:0 2px 4px rgba(56,15,28,.12),0 24px 44px -16px rgba(56,15,28,.55)}
  .cl-frame video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .cl-ph{position:absolute;inset:0;z-index:0;background:radial-gradient(120% 70% at 20% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(165deg,var(--g,#380F1C),#1d0810)}
  .cl-ph span{position:absolute;left:0;right:0;top:36%;text-align:center;font:500 11px/1.6 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.55);white-space:pre-line}
  .cl-frame::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.35) 0%,transparent 22%,transparent 48%,rgba(0,0,0,.78) 100%);pointer-events:none}
  .cl-top{position:absolute;z-index:2;top:14px;left:14px;right:14px;display:flex;justify-content:space-between;gap:8px}
  .cl-pill{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:13px;background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);font:600 11px/1 var(--body);letter-spacing:.06em;color:#fff}
  .cl-pill i{width:7px;height:7px;border-radius:50%;background:#FF5A5F;animation:cl-pulse 1.6s ease-in-out infinite}
  @keyframes cl-pulse{50%{opacity:.35}}
  .cl-play{position:absolute;z-index:2;left:50%;top:44%;width:68px;height:68px;margin:-34px 0 0 -34px;border-radius:50%;border:0;display:grid;place-items:center;background:rgba(255,255,255,.22);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);color:#fff;cursor:pointer;transition:transform .25s,background-color .25s}
  .cl-play svg{width:24px;height:24px;margin-left:3px}
  .cl-frame:hover .cl-play{transform:scale(1.1);background:rgba(255,255,255,.34)}
  .cl-cap{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:0 18px 18px;display:flex;flex-direction:column;gap:6px}
  .cl-cap strong{font:400 clamp(22px,2vw,27px)/1.12 var(--display)}
  .cl-cap span{font-size:14px;line-height:1.45;color:rgba(255,255,255,.88)}
  .cl-cap small{font-size:12px;letter-spacing:.02em;color:rgba(255,255,255,.62)}
  .cl-bar{height:3px;border-radius:2px;background:var(--line);overflow:hidden}
  .cl-bar i{display:block;height:100%;width:30%;background:var(--wine);border-radius:2px;transition:width .15s linear}
  .cl-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .cl-dlg{border:0;padding:0;background:transparent;max-width:min(94vw,520px);width:100%;overflow:visible}
  .cl-dlg::backdrop{background:rgba(20,8,12,.88);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .cl-dlg video{display:block;width:100%;max-height:88vh;border-radius:22px;background:#000;margin:auto}
  .cl-dlg button{position:absolute;right:-6px;top:-52px;height:40px;padding:0 16px;border-radius:20px;border:0;background:rgba(255,255,255,.16);color:#fff;font:600 12px var(--body);letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
  @media (max-width:749px){.cl-cards{grid-template-columns:1fr}.cl-card{flex-basis:76vw}.cl-arrows{display:none}.cl-play{width:58px;height:58px;margin:-29px 0 0 -29px}}
  @media (prefers-reduced-motion:reduce){.cl-frame,.cl-play{transition:none}.cl-pill i{animation:none}}
</style>
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}" id="clips-{{ section.id }}">
  <div class="wrap stack" style="gap:24px">
    <div class="cl-head">
      <div class="stack" style="gap:8px">
        {%- if section.settings.eyebrow != blank -%}<span class="mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="link arrow" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="cl-head">
      <div class="stack" style="gap:8px;max-width:64ch">
        {%- if section.settings.kicker != blank -%}<span class="mono">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="lead" style="margin:0">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if clips.size > 0 -%}
        <div class="cl-tools">{{ section.settings.note }}<span class="cl-arrows"><button type="button" data-dir="-1" aria-label="Previous clips"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button><button type="button" data-dir="1" aria-label="Next clips"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></span></div>
      {%- endif -%}
    </div>
    {%- if clips.size > 0 -%}
      {%- assign grads = '#380F1C,#4B5233,#7A4A3A,#8A5C6E,#2F3A44' | split: ',' -%}
      <div class="cl-row" data-row>
        {%- for b in clips -%}
          {%- liquid
            assign vsrc = ''
            assign vposter = ''
            if b.settings.video != blank
              assign mp4 = b.settings.video.sources | where: 'format', 'mp4' | first
              assign vsrc = mp4.url | default: b.settings.video.sources[0].url
            elsif b.settings.file != blank
              assign vsrc = b.settings.file | asset_url
              assign vposter = b.settings.file | replace: '.mp4', '-poster.jpg' | asset_url
            endif
            assign gi = forloop.index0 | modulo: 5
          -%}
          <article class="cl-card" {{ b.shopify_attributes }}>
            <div class="cl-frame" style="--g:{{ grads[gi] }}" data-src="{{ vsrc }}" tabindex="0" role="button" aria-label="Play {{ b.settings.title | escape }}">
              {%- if b.settings.video != blank -%}{{ b.settings.video | video_tag: image_size: '600x', controls: false, muted: true, loop: true, playsinline: true, preload: 'metadata' }}{%- elsif b.settings.file != blank -%}<video src="{{ vsrc }}" poster="{{ vposter }}" muted loop playsinline preload="metadata"></video>{%- else -%}<div class="cl-ph"><span>{{ b.settings.placeholder }}</span></div>{%- endif -%}
              <div class="cl-top"><span class="cl-pill"><i></i>REC{% if b.settings.time != blank %} · {{ b.settings.time }}{% endif %}</span>{% if b.settings.duration != blank %}<span class="cl-pill">{{ b.settings.duration }}</span>{% endif %}</div>
              <span class="cl-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15a1 1 0 0 0 1.53.85l12-7.5a1 1 0 0 0 0-1.7l-12-7.5A1 1 0 0 0 7 4.5z"/></svg></span>
              <div class="cl-cap"><strong>{{ b.settings.title }}</strong><span>{{ b.settings.text }}</span>{% if b.settings.by != blank %}<small>{{ b.settings.by }}</small>{% endif %}</div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="cl-bar" aria-hidden="true"><i data-bar></i></div>
      <dialog class="cl-dlg" data-dlg><button type="button" data-close>Close</button><video controls playsinline></video></dialog>
    {%- endif -%}
    {%- if cards.size > 0 -%}
      {%- if section.settings.cards_label != blank -%}<span class="mono">{{ section.settings.cards_label }}</span>{%- endif -%}
      <div class="cl-cards">
        {%- for b in cards -%}
          <a class="card" href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
            {%- render 'echo-pic', image: b.settings.image, alt: b.settings.title, label: b.settings.kind, ar: '4/3' -%}
            <div class="meta"><span class="mono">{{ b.settings.kind }}</span><span class="name" style="font-size:18px">{{ b.settings.title }}</span><span class="muted">{{ b.settings.dek }}</span></div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('clips-{{ section.id }}');
    if (!root) return;
    var row = root.querySelector('[data-row]');
    if (!row) return;
    var bar = root.querySelector('[data-bar]');
    var prev = root.querySelector('[data-dir="-1"]'), next = root.querySelector('[data-dir="1"]');
    function update() {
      var max = row.scrollWidth - row.clientWidth;
      var pct = row.scrollWidth ? Math.min(100, ((row.scrollLeft + row.clientWidth) / row.scrollWidth) * 100) : 100;
      if (bar) bar.style.width = pct + '%';
      row.classList.toggle('at-end', row.scrollLeft >= max - 4);
      if (prev) prev.disabled = row.scrollLeft <= 4;
      if (next) next.disabled = row.scrollLeft >= max - 4;
    }
    function step() { var c = row.querySelector('.cl-card'); return c ? c.getBoundingClientRect().width + 18 : 300; }
    [prev, next].forEach(function (b) { if (b) b.addEventListener('click', function () { row.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' }); }); });
    row.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
    var canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
    var dlg = root.querySelector('[data-dlg]'), dv = dlg ? dlg.querySelector('video') : null;
    root.querySelectorAll('.cl-frame').forEach(function (f) {
      var v = f.querySelector('video');
      if (v && canHover) {
        f.addEventListener('mouseenter', function () { v.play().catch(function () {}); });
        f.addEventListener('mouseleave', function () { v.pause(); v.currentTime = 0; });
      }
      function open() {
        var src = f.getAttribute('data-src');
        if (!src || !dlg || !dv) return;
        dv.src = src;
        if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
        dv.play().catch(function () {});
      }
      f.addEventListener('click', open);
      f.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });
    function close() { if (!dv) return; dv.pause(); dv.removeAttribute('src'); dv.load(); if (dlg.close) dlg.close(); else dlg.removeAttribute('open'); }
    if (dlg) {
      dlg.querySelector('[data-close]').addEventListener('click', close);
      dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
      dlg.addEventListener('close', function () { if (dv) { dv.pause(); } });
    }
  })();
</script>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Clips (phone films)",
  "settings": [
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}], "default": "paper" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "From the factory floor" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Filmed on the floor, on a phone" },
    { "type": "text", "id": "link_label", "label": "Link text (top right)" },
    { "type": "text", "id": "link", "label": "Link", "info": "Page address or echo:story, echo:tracker, echo:journal" },
    { "type": "text", "id": "kicker", "label": "Small label above text" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "These clips are shot by the people who make our pieces, during the working day. Handheld, a little shaky, with the sound as it was. We share them as they are, so you can see the machines, the yarn and the hands behind every edition." },
    { "type": "text", "id": "note", "label": "Note next to the arrows", "default": "New clips most weeks [cadence to confirm]" },
    { "type": "text", "id": "cards_label", "label": "Label above article cards", "default": "Read" }
  ],
  "blocks": [
    { "type": "clip", "name": "Clip", "settings": [
      { "type": "text", "id": "time", "label": "Time stamp", "default": "07:32" },
      { "type": "text", "id": "title", "label": "Title", "default": "Morning start-up" },
      { "type": "text", "id": "text", "label": "Text", "default": "The knitting machines warm up before the first shift." },
      { "type": "text", "id": "duration", "label": "Length", "default": "0:14" },
      { "type": "text", "id": "by", "label": "Credit", "default": "Filmed by [name], knitting hall" },
      { "type": "video", "id": "video", "label": "Clip", "info": "Upload the real film here. Empty = the bundled file below, then a placeholder." },
      { "type": "text", "id": "file", "label": "Bundled video file", "info": "File name in assets (mp4). A poster named like clip-poster.jpg goes with it." },
      { "type": "textarea", "id": "placeholder", "label": "Placeholder text", "default": "Phone clip\nMorning start-up" }
    ] },
    { "type": "card", "name": "Article card", "settings": [
      { "type": "text", "id": "kind", "label": "Label", "default": "Guide" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "dek", "label": "Text" },
      { "type": "text", "id": "link", "label": "Link", "info": "Page address or echo:story, echo:tracker, echo:journal" },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "presets": [{ "name": "Clips (phone films)" }]
}
{% endschema %}
