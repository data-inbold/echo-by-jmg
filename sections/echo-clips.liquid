{%- capture echo_out -%}
{%- comment -%}
  "Filmed on the floor, on a phone": a row of phone-shaped clip cards with arrows, and an optional row of article cards below it.
  Used on About us and on Stories (wireframes 10 and 14).
{%- endcomment -%}
{%- assign clips = section.blocks | where: 'type', 'clip' -%}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
<style>
  .echo-clips-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}
  .echo-clips-note{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted)}
  .echo-clips-arrows{display:flex;gap:8px}
  .echo-clips-arrows button{width:36px;height:36px;border:1px solid var(--line);background:var(--white);border-radius:50%;font-size:16px;cursor:pointer;line-height:1}
  .echo-clips-row{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 2px 10px;scrollbar-width:none}
  .echo-clips-row::-webkit-scrollbar{display:none}
  .echo-clip{flex:0 0 190px;scroll-snap-align:start;display:flex;flex-direction:column;gap:8px}
  .echo-phone{position:relative;aspect-ratio:9/16;background:#3a3834;border:5px solid #121110;border-radius:22px;overflow:hidden;color:#fff}
  .echo-phone video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .echo-phone .rec{position:absolute;top:10px;left:12px;right:12px;display:flex;justify-content:space-between;font:600 9px/1 var(--mono);letter-spacing:.08em;z-index:2}
  .echo-phone .rec b{color:#E5484D}
  .echo-phone .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:0 14px;font:500 10px/1.5 var(--mono);color:#cfc9bf;white-space:pre-line}
  .echo-phone .play{position:absolute;left:50%;top:44%;width:42px;height:42px;margin:-21px 0 0 -21px;border-radius:50%;background:rgba(255,255,255,.88);color:#121110;border:0;font-size:14px;cursor:pointer;z-index:2}
  .echo-phone.playing .play{display:none}
  .echo-phone .cap{position:absolute;left:0;right:0;bottom:0;padding:34px 12px 12px;background:linear-gradient(transparent,rgba(0,0,0,.82));z-index:1}
  .echo-phone .cap strong{display:block;font:600 italic 15px/1.2 var(--display)}
  .echo-phone .cap span{display:block;font-size:10px;line-height:1.4;margin-top:4px;color:#e6e3dc}
  .echo-phone .cap em{position:absolute;right:12px;bottom:12px;font:600 10px/1 var(--mono);font-style:normal}
  .echo-phone.playing .cap{display:none}
  .echo-clip .by{font-size:12px;color:var(--muted)}
  .echo-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media (max-width:749px){.echo-cards{grid-template-columns:1fr}.echo-clip{flex-basis:160px}}
</style>
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}" id="clips-{{ section.id }}">
  <div class="wrap stack" style="gap:22px">
    <div class="echo-clips-head">
      <div class="stack" style="gap:8px">
        {%- if section.settings.eyebrow != blank -%}<span class="mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="echo-clips-head">
      <div class="stack" style="gap:8px;max-width:70ch">
        {%- if section.settings.kicker != blank -%}<span class="mono">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="lead" style="margin:0">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if clips.size > 0 -%}
        <div class="echo-clips-note">{{ section.settings.note }}<span class="echo-clips-arrows"><button type="button" data-dir="-1" aria-label="Previous clips">←</button><button type="button" data-dir="1" aria-label="Next clips">→</button></span></div>
      {%- endif -%}
    </div>
    {%- if clips.size > 0 -%}
      <div class="echo-clips-row" data-clips-row>
        {%- for b in clips -%}
          <div class="echo-clip" {{ b.shopify_attributes }}>
            <div class="echo-phone">
              {%- if b.settings.video != blank -%}{{ b.settings.video | video_tag: image_size: '400x', controls: false, muted: true, loop: true, playsinline: true, preload: 'metadata' }}{%- else -%}<div class="ph">{{ b.settings.placeholder }}</div>{%- endif -%}
              <div class="rec"><b>● REC</b><span>{{ b.settings.time }}</span></div>
              <button type="button" class="play" aria-label="Play {{ b.settings.title | escape }}">▶</button>
              <div class="cap"><strong>{{ b.settings.title }}</strong><span>{{ b.settings.text }}</span>{% if b.settings.duration != blank %}<em>{{ b.settings.duration }}</em>{% endif %}</div>
            </div>
            {%- if b.settings.by != blank -%}<span class="by">{{ b.settings.by }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if cards.size > 0 -%}
      {%- if section.settings.cards_label != blank -%}<span class="mono">{{ section.settings.cards_label }}</span>{%- endif -%}
      <div class="echo-cards">
        {%- for b in cards -%}
          <a class="card" href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
            {%- render 'echo-pic', image: b.settings.image, alt: b.settings.title, label: b.settings.kind, ar: '4/3' -%}
            <div class="meta"><span class="mono">{{ b.settings.kind }}</span><span class="name" style="font-size:18px">{{ b.settings.title }}</span><span class="muted">{{ b.settings.dek }}</span></div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('clips-{{ section.id }}');
    if (!root) return;
    var row = root.querySelector('[data-clips-row]');
    root.querySelectorAll('.echo-clips-arrows button').forEach(function (b) {
      b.addEventListener('click', function () { if (row) row.scrollBy({ left: 210 * Number(b.dataset.dir), behavior: 'smooth' }); });
    });
    root.querySelectorAll('.echo-phone .play').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var ph = btn.closest('.echo-phone'), v = ph.querySelector('video');
        if (!v) return;
        v.controls = true; v.muted = false; v.play(); ph.classList.add('playing');
      });
    });
  })();
</script>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Clips (phone films)",
  "settings": [
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}], "default": "paper" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "From the factory floor" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Filmed on the floor, on a phone" },
    { "type": "text", "id": "link_label", "label": "Link text (top right)" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "kicker", "label": "Small label above text" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "These clips are shot by the people who make our pieces, during the working day. Handheld, a little shaky, with the sound as it was. We share them as they are, so you can see the machines, the yarn and the hands behind every edition." },
    { "type": "text", "id": "note", "label": "Note next to the arrows", "default": "New clips most weeks [cadence to confirm]" },
    { "type": "text", "id": "cards_label", "label": "Label above article cards", "default": "Read" }
  ],
  "blocks": [
    { "type": "clip", "name": "Clip", "settings": [
      { "type": "text", "id": "time", "label": "Time stamp", "default": "07:32" },
      { "type": "text", "id": "title", "label": "Title", "default": "Morning start-up" },
      { "type": "text", "id": "text", "label": "Text", "default": "The knitting machines warm up before the first shift." },
      { "type": "text", "id": "duration", "label": "Length", "default": "0:14" },
      { "type": "text", "id": "by", "label": "Credit", "default": "Filmed by [name], knitting hall" },
      { "type": "video", "id": "video", "label": "Clip", "info": "Empty = placeholder" },
      { "type": "textarea", "id": "placeholder", "label": "Placeholder text", "default": "Phone clip\nMorning start-up" }
    ] },
    { "type": "card", "name": "Article card", "settings": [
      { "type": "text", "id": "kind", "label": "Label", "default": "Guide" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "dek", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "presets": [{ "name": "Clips (phone films)" }]
}
{% endschema %}
