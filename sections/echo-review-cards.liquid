{%- capture echo_out -%}
{%- comment -%} "Our customers" (Collab design): customer photo next to a review card with the product they bought. {%- endcomment -%}
<style>
  .rv-grid{display:grid;gap:24px;grid-template-columns:1fr}
  @media(min-width:980px){.rv-grid{grid-template-columns:1fr 1fr}}
  .rv{display:grid;grid-template-columns:minmax(0,312px) minmax(0,1fr);gap:0;align-items:stretch}
  .rv .ph{min-height:0;height:100%;aspect-ratio:auto!important;min-height:320px;border:0}
  .rv-card{background:#fff;padding:20px;display:flex;flex-direction:column;gap:16px;min-height:320px}
  .rv-who{display:flex;align-items:flex-start;gap:12px;padding-bottom:16px;border-bottom:1px solid var(--line)}
  .rv-av{width:48px;height:48px;flex:none;border-radius:50%;background:var(--soft);display:flex;align-items:center;justify-content:center;font:400 20px var(--display);color:var(--wine-2)}
  .rv-who b{display:block;font:400 20px/1.3 var(--display);color:var(--ink)}
  .rv-who span{font-size:12px;font-weight:300;letter-spacing:.04em;color:var(--muted)}
  .rv-stars{color:#C9AE6D;letter-spacing:.2em;font-size:17px}
  .rv-card p{margin:0;font-size:16px;font-weight:300;letter-spacing:.04em;line-height:1.5;color:#000}
  .rv-prod{margin-top:auto;display:flex;gap:12px;align-items:center;background:var(--paper);padding:8px;font-size:14px;font-weight:600;color:var(--ink);text-decoration:none}
  .rv-prod .ph{width:60px;height:60px;min-height:0!important;aspect-ratio:1!important;flex:none}
  .rv-prod b{display:block;font-weight:400;font-size:12px;line-height:1.3;margin-bottom:2px;color:var(--muted)}
  @media (max-width:559px){.rv{grid-template-columns:1fr}.rv .ph{aspect-ratio:4/3!important;min-height:0;height:auto}}
</style>
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap stack" style="gap:28px">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rv-grid">
      {%- for b in section.blocks -%}
        {%- assign p = b.settings.product -%}
        <div class="rv" {{ b.shopify_attributes }}>
          {%- render 'echo-pic', image: b.settings.image, asset: b.settings.photo, alt: b.settings.alt, label: 'Customer photo', ar: '3/4' -%}
          <div class="rv-card">
            <div class="rv-who"><span class="rv-av">{{ b.settings.name | slice: 0 }}</span><div><b>{{ b.settings.name }}</b><span>{{ b.settings.country }}</span></div></div>
            <div class="rv-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p>{{ b.settings.quote }}</p>
            {%- if p != blank -%}
              <a class="rv-prod" href="{{ p.url }}">{%- render 'echo-pack-pic', product: p, alt: p.title, sizes: '56px' -%}<span><b>{{ p.title }}</b>{% render 'echo-money', price: p.price %}</span></a>
            {%- elsif b.settings.product_name != blank -%}
              <span class="rv-prod"><span class="ph" aria-hidden="true"></span><span><b>{{ b.settings.product_name }}</b>{{ b.settings.product_price }}</span></span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Review cards",
  "settings": [
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Cream"}, {"value": "alt", "label": "Blush"}, {"value": "band", "label": "Sand band"}], "default": "paper" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Customers" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Jane Doe" },
      { "type": "text", "id": "country", "label": "Country", "default": "Denmark" },
      { "type": "textarea", "id": "quote", "label": "Review", "default": "So soft, you felt it immediately. It feels like it’s always belonged in the room." },
      { "type": "image_picker", "id": "image", "label": "Customer photo" },
      { "type": "text", "id": "photo", "label": "Bundled photo file", "info": "Used when no photo is picked.", "default": "echo-v2-review-1.jpg" },
      { "type": "text", "id": "alt", "label": "Photo description" },
      { "type": "product", "id": "product", "label": "Product bought" },
      { "type": "text", "id": "product_name", "label": "Product name (when no product is picked)" },
      { "type": "text", "id": "product_price", "label": "Price text (when no product is picked)" }
    ] }
  ],
  "presets": [{ "name": "Review cards", "blocks": [{ "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
