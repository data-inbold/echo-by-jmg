{%- comment -%}
  Track your order. Shopify keeps live tracking on each order's status page (linked in the confirmation email)
  and in the customer account. This form sends a tracking request to support for anyone who cannot find it.
{%- endcomment -%}
<section class="section tight"><div class="wrap grid g2" style="align-items:start">
  {%- form 'contact', class: 'stack', style: 'gap:14px' -%}
    <h1 class="h2">{{ section.settings.heading }}</h1><p class="muted" style="margin:0">{{ section.settings.text }}</p>
    {%- if form.posted_successfully? -%}
      <div class="ok" role="status">{{ section.settings.ok }}</div>
    {%- else -%}
      <input type="hidden" name="contact[Form]" value="Tracking request">
      <input type="hidden" name="contact[body]" value="Please send me the tracking link for my order.">
      <div class="field"><label for="t-no">Order number</label><input id="t-no" name="contact[Order number]" required placeholder="#1003"></div>
      <div class="field"><label for="t-email">Email</label><input id="t-email" name="contact[email]" type="email" required autocomplete="email"></div>
      <button class="btn" type="submit">Track</button>
    {%- endif -%}
  {%- endform -%}
  <div><div class="review stack" style="gap:10px">
    <b>The fastest way</b>
    <span class="muted">{{ section.settings.side }}</span>
    <ol class="stack" style="list-style:none;margin:0;padding:0;gap:0">
      {%- assign st = 'Order received,Packed in Denmark,On its way,Delivered' | split: ',' -%}
      {%- for t in st -%}<li class="row" style="gap:12px;padding:10px 0;border-bottom:1px solid var(--line)"><span class="dot" style="width:18px;height:18px;border-color:var(--ink)"></span><span>{{ t }}</span></li>{%- endfor -%}
    </ol>
    <div><a class="btn ghost" href="{{ routes.account_url }}">Log in to see your orders</a></div>
  </div></div>
</div></section>
{% schema %}
{
  "name": "Track your order",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use the order number from your confirmation email." },
    { "type": "textarea", "id": "side", "label": "Side text", "default": "Your confirmation and shipping emails have a “View your order” button with live status and the carrier’s tracking. You can also log in to see every order." },
    { "type": "text", "id": "ok", "label": "Thank-you message", "default": "Thank you. We will email you the latest tracking link for this order within 24 hours." }
  ],
  "presets": [{ "name": "Track your order" }]
}
{% endschema %}
