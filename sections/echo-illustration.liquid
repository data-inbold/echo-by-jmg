{%- comment -%} A small centred illustration between two sections (the sofa above the Cozy Club band). {%- endcomment -%}
<style>
  .illus{display:flex;justify-content:center;padding-inline:16px;padding-top:{{ section.settings.space_above }}px;padding-bottom:{{ section.settings.space_below }}px}
  .illus img{display:block;width:{{ section.settings.width }}px;max-width:100%;height:auto}
</style>
<section class="illus"{% if section.settings.bg == 'blush' %} style="background:#F0DFD8"{% endif %}>
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 600 | image_tag: alt: section.settings.alt, loading: 'lazy', widths: '126, 252, 378, 504, 600', sizes: '(min-width: 720px) 300px, 50vw' }}
  {%- elsif section.settings.photo != blank and section.settings.photo != 'none' -%}
    <img src="{{ section.settings.photo | asset_url }}" alt="{{ section.settings.alt | escape }}" width="252" height="240" loading="lazy">
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Illustration",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "text", "id": "photo", "label": "Bundled file", "info": "Used when no illustration is picked. File name in assets.", "default": "echo-sofa-icon.png" },
    { "type": "text", "id": "alt", "label": "Description", "info": "Leave empty for a purely decorative illustration." },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "none", "label": "Page colour"}, {"value": "blush", "label": "Blush"}], "default": "none" },
    { "type": "range", "id": "width", "label": "Width", "min": 60, "max": 300, "step": 6, "default": 126, "unit": "px" },
    { "type": "range", "id": "space_above", "label": "Space above", "min": 0, "max": 120, "step": 4, "default": 20, "unit": "px" },
    { "type": "range", "id": "space_below", "label": "Space below", "min": 0, "max": 120, "step": 4, "default": 20, "unit": "px" }
  ],
  "presets": [{ "name": "Illustration" }]
}
{% endschema %}
