<section class="section"><div class="wrap" style="max-width:640px">
  {%- form 'contact', class: 'stack', style: 'gap:14px' -%}
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if form.posted_successfully? -%}
      <div class="ok" role="status">{{ section.settings.ok }}</div>
    {%- else -%}
      <input type="hidden" name="contact[Form]" value="Corporate gifts">
      <div class="field"><label for="co-name">Name</label><input id="co-name" name="contact[name]" required></div>
      <div class="field"><label for="co-company">Company</label><input id="co-company" name="contact[Company]" required></div>
      <div class="field"><label for="co-email">Email</label><input id="co-email" name="contact[email]" type="email" required></div>
      <div class="row" style="gap:12px"><div class="field" style="flex:1 1 160px"><label for="co-qty">Number of gifts</label><input id="co-qty" name="contact[Number of gifts]" type="number" min="1"></div><div class="field" style="flex:1 1 160px"><label for="co-date">Needed by</label><input id="co-date" name="contact[Needed by]" type="date"></div></div>
      <div class="field"><label for="co-msg">Anything else</label><textarea id="co-msg" name="contact[body]" rows="4"></textarea></div>
      <button class="btn" type="submit">Send request</button>
    {%- endif -%}
  {%- endform -%}
</div></section>
{% schema %}
{
  "name": "Corporate request form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask for an offer" },
    { "type": "text", "id": "ok", "label": "Thank-you message", "default": "Thank you. We will reply with an offer within 2 working days." }
  ],
  "presets": [{ "name": "Corporate request form" }]
}
{% endschema %}
