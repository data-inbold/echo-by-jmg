{%- capture u_home -%}{%- render 'echo-url', key: 'home' -%}{%- endcapture -%}
{%- assign t_home = 'echo.common.home' | t -%}{%- assign t_account = 'echo.common.account' | t -%}{%- assign t_addresses = 'echo.addresses.crumb' | t -%}{%- assign cl = t_home | append: '::' | append: u_home | append: '||' | append: t_account | append: '::' | append: routes.account_url | append: '||' | append: t_addresses -%}
{%- render 'echo-crumbs', list: cl -%}
<section class="section tight"><div class="wrap grid g2" style="align-items:start">
  <div class="stack" style="gap:14px"><h1 class="h2">{{ 'echo.addresses.your_addresses' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
    {%- for a in customer.addresses -%}
      <div class="review stack" style="gap:8px"><span>{{ a | format_address }}</span>{% if a == customer.default_address %}<span class="badge" style="align-self:flex-start">{{ 'echo.addresses.default' | t }}</span>{% endif %}
        {%- form 'customer_address', a -%}<input type="hidden" name="_method" value="delete"><button class="textbtn" type="submit">{{ 'echo.addresses.delete' | t }}</button>{%- endform -%}
      </div>
    {%- endfor -%}
    {%- endpaginate -%}
  </div>
  {%- form 'customer_address', customer.new_address, class: 'stack', style: 'gap:14px' -%}
    <h2 class="h3">{{ 'echo.addresses.add_an_address' | t }}</h2>
    {%- if form.errors -%}<div class="err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="a-first">{{ 'echo.addresses.first_name' | t }}</label><input id="a-first" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
    <div class="field"><label for="a-last">{{ 'echo.addresses.last_name' | t }}</label><input id="a-last" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
    <div class="field"><label for="a-addr">{{ 'echo.common.address' | t }}</label><input id="a-addr" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
    <div class="row" style="gap:12px"><div class="field" style="flex:1 1 120px"><label for="a-zip">{{ 'echo.addresses.postcode' | t }}</label><input id="a-zip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div><div class="field" style="flex:2 1 180px"><label for="a-city">{{ 'echo.addresses.city' | t }}</label><input id="a-city" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div></div>
    <div class="field"><label for="a-country">{{ 'echo.addresses.country' | t }}</label><select id="a-country" name="address[country]">{{ all_country_option_tags }}</select></div>
    <div class="field"><label for="a-phone">{{ 'echo.addresses.phone' | t }}</label><input id="a-phone" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
    <label class="row" style="gap:8px;font-size:14px">{{ form.set_as_default_checkbox }} {{ 'echo.addresses.use_as_default' | t }}</label>
    <button class="btn" type="submit">{{ 'echo.addresses.save_address' | t }}</button>
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
