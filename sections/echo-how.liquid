{%- capture echo_out -%}
{%- comment -%} "How it works" (option 2): accordion of steps on the left, photo or video on the right. {%- endcomment -%}
<style>
  .how-panel{display:grid;background:#fff;align-items:stretch}
  @media(min-width:880px){.how-panel{grid-template-columns:600fr 680fr}}
  .how-acc{padding:clamp(24px,4.5vw,40px) clamp(20px,4.5vw,60px);display:flex;flex-direction:column;gap:24px;justify-content:center}
  .how-i{border:0;margin:0;padding:0}
  .how-i+.how-i{border-top:1px solid #D7D5CB;padding-top:24px}
  .how-i summary{list-style:none;cursor:pointer;font:300 clamp(24px,2.3vw,32px)/1.3 var(--display);color:var(--faint);transition:color .2s ease}
  .how-i summary::-webkit-details-marker{display:none}
  .how-i summary:hover{color:var(--ink)}
  .how-i[open] summary{font-style:italic;color:var(--olive);cursor:default}
  .how-i .b{margin-top:24px}
  .how-i p{margin:0;font-size:14px;line-height:1.6;color:var(--ink);max-width:480px}
  .how-i p a{color:var(--olive);text-decoration:underline;text-underline-offset:3px}
  .how-media{position:relative;min-height:320px}
  .how-media .ph{position:absolute;inset:0;border:0;min-height:0!important;aspect-ratio:auto!important;height:100%}
  @media(max-width:879px){.how-media{min-height:0}.how-media .ph{position:relative;aspect-ratio:4/3!important;height:auto}}
  .how-media .lbl{position:absolute;left:0;right:0;bottom:22%;text-align:center;color:rgba(255,255,255,.85);font:700 clamp(24px,2.5vw,36px)/1.6 var(--body);pointer-events:none}
</style>
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="wrap stack" style="gap:40px">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="how-panel">
      <div class="how-acc">
        {%- for b in section.blocks -%}
          {%- liquid
            assign t = b.settings.text
            if b.settings.link_word != blank and b.settings.link != blank
              capture a_html
                echo '<a href="' | append: b.settings.link | append: '">' | append: b.settings.link_word | append: '</a>'
              endcapture
              assign t = t | replace: b.settings.link_word, a_html
            endif
          -%}
          <details class="how-i" name="how-steps"{% if forloop.first %} open{% endif %} {{ b.shopify_attributes }}><summary>{{ b.settings.title }}</summary><div class="b"><p>{{ t }}</p></div></details>
        {%- endfor -%}
      </div>
      <div class="how-media">
        {%- render 'echo-media', video: section.settings.video, image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: section.settings.media_label, ar: '680/556' -%}
        {%- if section.settings.overlay != blank -%}<span class="lbl">{{ section.settings.overlay }}</span>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Cream"}, {"value": "alt", "label": "Blush"}, {"value": "band", "label": "Sand band"}], "default": "paper" },
    { "type": "text", "id": "anchor", "label": "Anchor (for #links)", "default": "how" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "photo", "label": "Bundled photo file", "info": "Used when no video or photo is picked.", "default": "echo-v2-process.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A JM Group yarn label lying on a knitted fair-isle piece" },
    { "type": "text", "id": "overlay", "label": "Text over the media", "default": "Video process" },
    { "type": "text", "id": "media_label", "label": "Placeholder text", "default": "Process video" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "We rescue the yarn" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Unused yarn left after fashion production runs in our own factory. Never worn, never recycled fibre." },
      { "type": "text", "id": "link_word", "label": "Word to link (optional)", "info": "A word in the text that becomes a link, for example Yarn Passport." },
      { "type": "text", "id": "link", "label": "Link", "info": "Page address or echo:passport" }
    ] }
  ],
  "presets": [{ "name": "How it works", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
