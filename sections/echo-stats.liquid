<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap stats">
    {%- for b in section.blocks -%}
      <div class="stat" {{ b.shopify_attributes }}><div class="n">{{ b.settings.n }}</div><p>{{ b.settings.text }}</p></div>
    {%- endfor -%}
  </div>
  {%- if section.settings.link_label != blank -%}
    <div class="wrap" style="margin-top:18px"><a class="link" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}{% render 'echo-url', key: 'tracker' %}{% endif %}">{{ section.settings.link_label }}</a></div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Numbers",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "tight"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Black"}], "default": "band"},
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See every batch in the rescued yarn tracker" },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty = Rescued yarn tracker page" }
  ],
  "blocks": [
    { "type": "stat", "name": "Number", "settings": [
      { "type": "text", "id": "n", "label": "Number", "default": "250 kg" },
      { "type": "text", "id": "text", "label": "Text", "default": "yarn rescued to date" }
    ] }
  ],
  "presets": [{ "name": "Numbers", "blocks": [
    { "type": "stat", "settings": { "n": "250 kg", "text": "yarn rescued to date" } },
    { "type": "stat", "settings": { "n": "28", "text": "numbered editions released" } },
    { "type": "stat", "settings": { "n": "1946", "text": "family knitwear since" } },
    { "type": "stat", "settings": { "n": "0", "text": "restocks. When an edition is gone, it is gone." } }
  ] }]
}
{% endschema %}
