{%- capture tot -%}{%- render 'echo-batch-totals' -%}{%- endcapture -%}
{%- assign totp = tot | strip | split: '|' -%}
<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}{% if section.settings.icons %} stats-icons{% endif %}">
  <div class="wrap stats">
    {%- comment -%} The {kg} / {batches} tokens are built with append: a "}" inside an output tag ends the tag early in Shopify's parser. {%- endcomment -%}
    {%- liquid
      assign tok_kg = '{' | append: 'kg' | append: '}'
      assign tok_ed = '{' | append: 'batches' | append: '}'
      assign kg_out = '<span data-yarn-total="kg">' | append: totp[0] | append: '</span>'
      assign ed_out = '<span data-yarn-total="batches">' | append: totp[1] | append: '</span>'
    -%}
    {%- for b in section.blocks -%}
      {%- assign n = b.settings.n | replace: tok_kg, kg_out | replace: tok_ed, ed_out -%}
      <div class="stat" {{ b.shopify_attributes }}>{% if section.settings.icons %}<svg class="stat-ic" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="24" cy="31" r="18"/><path d="M8 24c10 6 22 6 32 0M7 33c11 6 24 6 35 0M12 44c8 3 16 3 24 0M18 15c6 8 6 24 0 32M30 14c-5 8-5 25 0 33"/><path d="M42 6 30 22M48 12 36 24" /><circle cx="42" cy="5" r="2"/><circle cx="48" cy="11" r="2"/></svg>{% endif %}<div class="stat-t"><div class="n">{{ n }}</div><p>{{ b.settings.text }}</p></div></div>
    {%- endfor -%}
  </div>
  {%- if section.settings.link_label != blank -%}
    <div class="wrap{% if section.settings.icons %} stats-cta{% endif %}" style="margin-top:18px"><a class="{% if section.settings.icons %}btn ghost arrow{% else %}link{% endif %}" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}{% render 'echo-url', key: 'tracker' %}{% endif %}">{{ section.settings.link_label }}</a></div>
  {%- endif -%}
  {%- render 'echo-yarn-history' -%}
</section>
{% schema %}
{
  "name": "Numbers",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "tight"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Wine"}], "default": "band"},
    { "type": "checkbox", "id": "icons", "label": "Yarn icon next to each number (and a button for the link)", "default": false },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See every batch in the rescued yarn tracker" },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty = Rescued yarn tracker page" }
  ],
  "blocks": [
    { "type": "stat", "name": "Number", "settings": [
      { "type": "text", "id": "n", "label": "Number", "default": "{kg}", "info": "{kg} = total yarn rescued, {batches} = number of batches, both calculated from the Yarn Passport fields on the products plus older batches in the Yarn batch list." },
      { "type": "text", "id": "text", "label": "Text", "default": "yarn rescued to date" }
    ] }
  ],
  "presets": [{ "name": "Numbers", "blocks": [
    { "type": "stat", "settings": { "n": "250 kg", "text": "yarn rescued to date" } },
    { "type": "stat", "settings": { "n": "28", "text": "numbered editions released" } },
    { "type": "stat", "settings": { "n": "1946", "text": "family knitwear since" } },
    { "type": "stat", "settings": { "n": "0", "text": "restocks. When an edition is gone, it is gone." } }
  ] }]
}
{% endschema %}
