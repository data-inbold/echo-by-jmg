{%- comment -%} Top of a listing page: breadcrumbs, big heading and a thin line. {%- endcomment -%}
{%- liquid
  capture u_home
    render 'echo-url', key: 'home'
  endcapture
  assign t_home = 'echo.common.home' | t
  assign crumb_list = t_home | append: '::' | append: u_home | append: '||' | append: section.settings.crumb_current
-%}
<style>
  .pt{padding-block:{{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px}
  .pt .crumbs{padding:0 0 20px}
  .pt .wrap>.crumbs{max-width:none;margin:0}
  .pt-h{margin:0;font:300 clamp(34px,3.9vw,56px)/1.36 var(--display);color:var(--wine)}
  .pt-hr{height:0;border:0;border-top:1px solid #ABA499;margin:40px 0 0}
</style>
<section class="pt">
  <div class="wrap">
    {%- render 'echo-crumbs', list: crumb_list -%}
    <h1 class="pt-h">{{ section.settings.heading | default: page_title }}</h1>
    <hr class="pt-hr">
  </div>
</section>
{% schema %}
{
  "name": "Page top",
  "settings": [
    { "type": "text", "id": "crumb_current", "label": "Breadcrumb: this page", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty = the page title.", "default": "Shop Overview" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 160, "step": 10, "default": 40, "unit": "px" },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 160, "step": 10, "default": 0, "unit": "px" }
  ],
  "presets": [{ "name": "Page top" }]
}
{% endschema %}
