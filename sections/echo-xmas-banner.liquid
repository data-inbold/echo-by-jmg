{%- capture echo_out -%}
{%- comment -%} Seasonal horizontal banner: wide photo strip with a heading band below. {%- endcomment -%}
<style>
  .xbn{--xb:{{ section.settings.bg }};--xt:{{ section.settings.fg }};--xs:{{ section.settings.sub }};background:var(--xb);color:var(--xt)}
  .xbn .ph{aspect-ratio:8/3;border:0;border-radius:0;background:var(--xb)}
  .xbn .ph img{width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focus }}}
  .xbn-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 32px;padding-block:24px 28px}
  @media (min-width:750px){.xbn .ph{aspect-ratio:auto;height:min(37.5vw,calc(100svh - 330px));min-height:280px;background:{{ section.settings.photo_bg | default: section.settings.bg }}}.xbn .ph img{object-fit:contain}}
  .xbn-h{font:400 clamp(30px,4vw,52px)/1.1 var(--display);margin:0;color:var(--xt)}
  .xbn-in p{margin:6px 0 0;max-width:60ch;font-size:16px;line-height:1.6;color:var(--xs)}
  .xbn .btn{background:var(--xt);color:var(--xb);border-color:var(--xt)}
  @media (max-width:749px){.xbn .ph{aspect-ratio:4/3}}
</style>
<section class="xbn">
  {%- render 'echo-pic', image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: 'Banner photo', eager: true, sizes: '100vw' -%}
  <div class="wrap xbn-in">
    <div>
      <h1 class="xbn-h">{{ section.settings.heading }}</h1>
      {%- if section.settings.lead != blank -%}<p>{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    {%- if section.settings.btn_label != blank -%}<a class="btn" href="{{ section.settings.btn_link | default: '#products' }}"{% if section.settings.btn_link == blank or section.settings.btn_link == '#products' %} data-xbn-jump{% endif %}>{{ section.settings.btn_label }}</a>{%- endif -%}
  </div>
</section>
<script>
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-xbn-jump]');
    if (!a) return;
    var items = document.querySelectorAll('[data-shop-grid] > *');
    var first = null;
    for (var i = 0; i < items.length; i++) { if (items[i].offsetParent !== null) { first = items[i]; break; } }
    if (!first) first = document.querySelector('[data-shop-grid]');
    if (!first) return;
    e.preventDefault();
    var hd = document.querySelector('header, .echo-header, [data-header]');
    var off = 16;
    if (hd) { var st = getComputedStyle(hd).position; if (st === 'sticky' || st === 'fixed') off += hd.getBoundingClientRect().height; }
    window.scrollTo({ top: first.getBoundingClientRect().top + window.scrollY - off, behavior: 'smooth' });
  });
</script>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Seasonal banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner photo", "info": "About 2400 x 900 px. Empty = the bundled photo." },
    { "type": "text", "id": "photo", "label": "Bundled photo file", "default": "echo-xmas-banner.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "Festive knitted throws and cushion covers in front of a Christmas tree" },
    { "type": "text", "id": "focus", "label": "Photo focus (CSS position)", "default": "50% 50%" },
    { "type": "color", "id": "bg", "label": "Band colour", "default": "#7A1E28" },
    { "type": "color", "id": "fg", "label": "Heading and button colour", "default": "#FBF6F1" },
    { "type": "color", "id": "sub", "label": "Text colour", "default": "#F1E7E0" },
    { "type": "color", "id": "photo_bg", "label": "Photo side fill (desktop)", "info": "Fills the space beside the photo on wide screens. Empty = band colour." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The X'mas Collection" },
    { "type": "textarea", "id": "lead", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button" },
    { "type": "text", "id": "btn_link", "label": "Button link", "info": "Empty = scroll to the first product below." }
  ],
  "presets": [{ "name": "Seasonal banner" }]
}
{% endschema %}
