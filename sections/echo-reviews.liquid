<section class="section {{ section.settings.spacing }} {{ section.settings.bg }}">
  <div class="wrap stack" style="gap:20px">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <div class="grid g3">
      {%- for b in section.blocks -%}
        <div class="review" {{ b.shopify_attributes }}>{{ b.settings.stars }}<p>“{{ b.settings.quote }}”</p><span class="muted">{{ b.settings.name }}</span></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.app_note != blank -%}<p class="muted" style="font-size:13px;margin:0">{{ section.settings.app_note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Customer quotes",
  "settings": [
    {"type": "select", "id": "spacing", "label": "Spacing", "options": [{"value": "normal", "label": "Normal"}, {"value": "tight", "label": "Tight"}], "default": "normal"},
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}, {"value": "dark", "label": "Black"}], "default": "paper"},
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "app_note", "label": "Note under quotes" }
  ],
  "blocks": [
    { "type": "review", "name": "Quote", "settings": [
      { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "So soft, you felt it immediately. It feels like it’s always belonged in the room." },
      { "type": "text", "id": "name", "label": "Name", "default": "Aija" }
    ] },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Customer quotes", "blocks": [{ "type": "review" }] }]
}
{% endschema %}
