{%- comment -%} Row of small text cards that link somewhere ("Edits" on the shop overview). {%- endcomment -%}
<style>
  .echo-lcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:8px}
  .echo-lcard{background:var(--white,#fff);border:1px solid var(--line);padding:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:4px;transition:border-color .15s}
  .echo-lcard:hover,.echo-lcard:focus-visible{border-color:var(--ink)}
  .echo-lcard b{font-size:14px}.echo-lcard span{font-size:13px;line-height:1.5}
</style>
<section class="section tight {{ section.settings.bg }}">
  <div class="wrap stack" style="gap:16px">
    {%- if section.settings.heading != blank -%}<h2 class="h3" style="margin:0">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="echo-lcards">
      {%- for b in section.blocks -%}
        {%- liquid
          capture href
            render 'echo-url', key: b.settings.key
          endcapture
          if b.settings.link != blank
            assign href = b.settings.link
          endif
        -%}
        <a class="echo-lcard" href="{{ href }}" {{ b.shopify_attributes }}><b>{{ b.settings.title }}</b>{% if b.settings.text != blank %}<span class="muted">{{ b.settings.text }}</span>{% endif %}</a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Link cards",
  "settings": [
    {"type": "select", "id": "bg", "label": "Background", "options": [{"value": "paper", "label": "Off-white"}, {"value": "alt", "label": "White"}, {"value": "band", "label": "Grey band"}], "default": "band"},
    { "type": "text", "id": "heading", "label": "Heading", "default": "Edits" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "select", "id": "key", "label": "Link to", "options": [
        { "value": "open", "label": "Open editions" }, { "value": "last-pieces", "label": "Last pieces" },
        { "value": "sets", "label": "Pillow Talk sets" }, { "value": "happy-habitat", "label": "Happy Habitat" },
        { "value": "gift-card", "label": "Gift card" }, { "value": "gifts", "label": "Gifts" }, { "value": "shop-all", "label": "Shop all" }
      ], "default": "open" },
      { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides \"Link to\"." }
    ] }
  ],
  "presets": [{ "name": "Link cards" }]
}
{% endschema %}
