{%- comment -%} (Shopify section names are limited to 25 characters.) Page top: breadcrumbs (Home / this page), big heading with a short text on the right, a divider and a wide photo. {%- endcomment -%}
{%- liquid
  capture u_home
    render 'echo-url', key: 'home'
  endcapture
  assign t_home = 'echo.common.home' | t
  assign crumb_list = t_home | append: '::' | append: u_home | append: '||' | append: section.settings.crumb_current
-%}
<style>
  .ph-top{padding-block:{{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px}
  .ph-top .crumbs{padding:0 0 20px}
  .ph-top .wrap>.crumbs{max-width:none;margin:0}
  .ph-t{display:grid;grid-template-columns:1fr;gap:20px;align-items:center}
  @media(min-width:900px){.ph-t{grid-template-columns:minmax(0,1fr) minmax(0,519px);gap:40px}}
  .ph-h{margin:0;font:300 clamp(34px,3.9vw,56px)/1.36 var(--display);color:var(--wine)}
  .ph-t p{margin:0;font:400 14px/1.6 var(--body);color:#332C2A}
  .ph-hr{height:0;border:0;border-top:1px solid #ABA499;margin:40px 0}
  .ph-img{position:relative;height:{{ section.settings.img_h_mobile }}px;overflow:hidden;background:#d8d0c6}
  @media(min-width:720px){.ph-img{height:{{ section.settings.img_h }}px}}
  .ph-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focus }}}
</style>
<section class="ph-top">
  <div class="wrap">
    {%- render 'echo-crumbs', list: crumb_list -%}
    <div class="ph-t">
      <h1 class="ph-h">{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
    </div>
    <hr class="ph-hr">
    <div class="ph-img">
      {%- if section.settings.photo != blank -%}
        {{ section.settings.photo | image_url: width: 2560 | image_tag: alt: section.settings.alt, widths: '640, 1280, 1920, 2560', sizes: '(min-width: 1440px) 1280px, 100vw', loading: 'eager' }}
      {%- elsif section.settings.photo_file != blank -%}
        <img src="{{ section.settings.photo_file | asset_url }}" alt="{{ section.settings.alt | escape }}" width="1400" height="810" loading="eager">
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "crumb_current", "label": "Breadcrumb: this page", "default": "Gifts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From cozy blankets to everyday accessories, discover beautifully knitted gifts that bring comfort to the people who mean the most to you." },
    { "type": "image_picker", "id": "photo", "label": "Wide photo", "info": "About 2560 x 720 px (shown at 1280 x 360). Empty = the file named below." },
    { "type": "text", "id": "photo_file", "label": "Photo file in assets", "info": "Stand-in until the real photo is uploaded.", "default": "echo-v2-gift.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A wrapped EchoByJMG gift with a handwritten card" },
    { "type": "text", "id": "focus", "label": "Photo focus", "default": "50% 50%" },
    { "type": "range", "id": "img_h", "label": "Photo height (desktop)", "min": 200, "max": 640, "step": 20, "default": 360, "unit": "px" },
    { "type": "range", "id": "img_h_mobile", "label": "Photo height (phone)", "min": 160, "max": 400, "step": 20, "default": 240, "unit": "px" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 160, "step": 10, "default": 80, "unit": "px" },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 160, "step": 10, "default": 0, "unit": "px" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
