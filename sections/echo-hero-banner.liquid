{%- capture echo_out -%}
{%- comment -%} Home hero (Collab design): full-width photo, centred wine heading, two buttons. {%- endcomment -%}
<style>
  .hbn{position:relative;overflow:hidden;background:#F1E7E0;min-height:clamp(480px,46vw,640px);display:flex;justify-content:center}
  .hbn .ph{position:absolute;inset:0;border:0;background:transparent}
  .hbn .ph img{object-position:{{ section.settings.focus }}}
  .hbn::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(241,231,224,.92) 0%,rgba(241,231,224,.55) 45%,rgba(241,231,224,0) 70%);pointer-events:none}
  .hbn-thread{position:absolute;left:-40px;top:70px;width:340px;height:300px;z-index:1;pointer-events:none}
  .hbn-in{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;padding-block:clamp(48px,6vw,92px) clamp(120px,14vw,200px);max-width:880px}
  .hbn-h{font:400 clamp(38px,5.6vw,72px)/1.1 var(--display);color:var(--wine-2);margin:0;letter-spacing:-.01em}
  .hbn-in p{margin:0;max-width:56ch;font-size:17px;line-height:1.6;color:var(--ink)}
  .hbn .btn.sec{background:#FBF6F1;color:var(--wine);border-color:var(--wine)}
  @media (max-width:749px){.hbn::after{background:linear-gradient(180deg,rgba(241,231,224,.9) 0%,rgba(241,231,224,.6) 60%,rgba(241,231,224,0) 100%)}.hbn-thread{display:none}}
</style>
<section class="hbn">
  {%- render 'echo-pic', image: section.settings.image, asset: section.settings.photo, alt: section.settings.alt, label: 'Hero photo', eager: true, sizes: '100vw' -%}
  <svg class="hbn-thread" viewBox="0 0 340 300" fill="none" aria-hidden="true"><path d="M30 60C-10 120 10 230 90 260 150 282 300 240 292 90 288 20 310 -10 330 -20" stroke="#E2CFA8" stroke-width="2.5" stroke-linecap="round"/></svg>
  <div class="hbn-in">
    <h1 class="hbn-h">{{ section.settings.heading }}</h1>
    {%- if section.settings.lead != blank -%}<p>{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
    <div class="row" style="justify-content:center">
      {%- if section.settings.btn1_label != blank -%}<a class="btn" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a class="btn sec" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
  </div>
  {%- if section.settings.feat_title != blank -%}
    <a class="hbn-feat" href="{{ section.settings.feat_link | default: '#' }}">
      {%- render 'echo-pic', image: section.settings.feat_image, asset: section.settings.feat_photo, alt: section.settings.feat_title, label: 'Featured photo', ar: '4/3', sizes: '(min-width: 980px) 45vw, 100vw' -%}
      <span class="hbn-feat-t">{{ section.settings.feat_title }}</span>
      {%- if section.settings.feat_cta != blank -%}<span class="hbn-feat-c">{{ section.settings.feat_cta }}</span>{%- endif -%}
    </a>
  {%- endif -%}
</section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where Luxury Material Finds A Second Life." },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "We rescue leftover yarns from luxury fashion and turn them into limited-edition pieces for your home. Three generations of craft. Nothing wasted." },
    { "type": "text", "id": "btn1_label", "label": "Button 1", "default": "Shop now" },
    { "type": "text", "id": "btn1_link", "label": "Button 1 link", "default": "echo:shop-all" },
    { "type": "text", "id": "btn2_label", "label": "Button 2", "default": "How it works" },
    { "type": "text", "id": "btn2_link", "label": "Button 2 link", "default": "#how" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "photo", "label": "Bundled photo file", "info": "Used when no photo is picked. File name in assets.", "default": "echo-v2-hero.jpg" },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "Cones of green, mustard, cream and pink yarn resting on a knitted blanket" },
    { "type": "text", "id": "focus", "label": "Photo focus (CSS position)", "default": "75% 85%" },
    { "type": "header", "content": "Featured product card (optional, right side)" },
    { "type": "text", "id": "feat_title", "label": "Card title", "info": "Leave empty to hide the card." },
    { "type": "text", "id": "feat_cta", "label": "Card link text", "default": "View products" },
    { "type": "text", "id": "feat_link", "label": "Card link" },
    { "type": "image_picker", "id": "feat_image", "label": "Card photo" },
    { "type": "text", "id": "feat_photo", "label": "Bundled card photo file", "info": "Used when no card photo is picked. File name in assets." }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
