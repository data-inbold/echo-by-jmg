{%- capture echo_out -%}
<section class="section tight"><div class="wrap" style="max-width:860px">
  <div class="stack" style="gap:14px"><span class="mono">Last updated {{ section.settings.updated }}</span><h1 class="h1">{{ section.settings.heading | default: page.title }}</h1><p class="lead" style="margin:0">{{ section.settings.lead }}</p>
    {%- if section.settings.note != blank -%}<div class="review" style="font-size:13px">{{ section.settings.note }}</div>{%- endif -%}
  </div>
  <nav class="stack" style="gap:6px;margin:28px 0;font-size:14px" aria-label="On this page">
    {%- for b in section.blocks -%}<a class="link" style="align-self:flex-start" href="#s{{ forloop.index0 }}">{{ forloop.index }}. {{ b.settings.title }}</a>{%- endfor -%}
  </nav>
  {%- for b in section.blocks -%}
    <section id="s{{ forloop.index0 }}" style="padding-top:18px;border-top:1px solid var(--line);margin-top:18px" {{ b.shopify_attributes }}><h2 class="h3">{{ forloop.index }}. {{ b.settings.title }}</h2><div class="article muted legal-body rte" style="margin-top:10px">{{ b.settings.text }}</div></section>
  {%- endfor -%}
  {%- if page.content != blank and section.settings.show_page_content -%}<div class="article rte" style="margin-top:28px">{{ page.content }}</div>{%- endif -%}
</div></section>
{%- endcapture -%}
{%- render 'echo-links', html: echo_out -%}
{% schema %}
{
  "name": "Legal page",
  "settings": [
    { "type": "text", "id": "updated", "label": "Last updated", "default": "[date]" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty = page title" },
    { "type": "textarea", "id": "lead", "label": "Intro" },
    { "type": "text", "id": "note", "label": "Draft note (remove when final)", "default": "Draft structure. Final wording to be written and checked by a lawyer." },
    { "type": "checkbox", "id": "show_page_content", "label": "Also show the page content from Shopify admin", "default": true }
  ],
  "blocks": [
    { "type": "part", "name": "Section", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Who you buy from" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Legal page" }]
}
{% endschema %}
