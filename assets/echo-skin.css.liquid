body.skin-quiet-gallery .step .num,body.skin-quiet-gallery .step .mono{grid-area:n;font:italic 300 34px/1 var(--display);color:var(--gold);letter-spacing:0;text-transform:none}
body.skin-quiet-gallery .steps.counted .num::before{content:counter(st,lower-roman) "."}
body.skin-quiet-gallery .step .step-ic{grid-area:i;padding-top:8px}
body.skin-quiet-gallery .step .step-ic .ic{width:34px;height:34px}
body.skin-quiet-gallery .step b{grid-area:t;font:600 15px/1.4 var(--body);color:var(--char)}
body.skin-quiet-gallery .step .muted{grid-area:x;line-height:1.65}
/* shop by */
body.skin-quiet-gallery .shop-by .grid{gap:28px}
body.skin-quiet-gallery .shop-by .tile .ph{border:0}
body.skin-quiet-gallery .shop-by .tile .meta{flex-direction:row;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line);padding-top:10px}
body.skin-quiet-gallery .shop-by .tile .name{font:400 22px/1.2 var(--display);color:var(--char)}
body.skin-quiet-gallery .shop-by .tile .muted{font-size:12px;color:var(--faint)}
/* current editions on Linen with the chart behind, museum labels */
body.skin-quiet-gallery .editions{background:#F1E9DA;position:relative;isolation:isolate;padding-block:88px}
body.skin-quiet-gallery .editions::before{content:"";position:absolute;inset:0;z-index:-1;background-color:#E8DECC;-webkit-mask:url({{ tx_chart }}) 0 0/120px 120px repeat;mask:url({{ tx_chart }}) 0 0/120px 120px repeat}
body.skin-quiet-gallery .editions .grid{gap:32px}
body.skin-quiet-gallery .pcard{gap:14px}
body.skin-quiet-gallery .pcard .card-img{padding:28px}
body.skin-quiet-gallery .editions .pcard .card-img{--card-ground:#FAF6EE}
body.skin-quiet-gallery .pcard .card-img>.ph{inset:28px;height:auto}
body.skin-quiet-gallery .pcard .card-img>.ph.hover{inset:0}
body.skin-quiet-gallery .pcard .meta{border-top:1px solid var(--gold);padding-top:12px;gap:4px}
body.skin-quiet-gallery .pcard .lab{display:flex;align-items:center;font:500 11px/1.5 var(--body);letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
body.skin-quiet-gallery .pcard[data-state="last"] .lab{color:#A3402D}
body.skin-quiet-gallery .pcard .name{font:400 22px/1.15 var(--display);color:var(--char)}
body.skin-quiet-gallery .pcard .sub{color:var(--muted)}
body.skin-quiet-gallery .pcard .price-row .ed{display:none}
body.skin-quiet-gallery .pcard .price{font-weight:400}
/* story: quiet, no band */
body.skin-quiet-gallery .story{background:var(--paper)}
body.skin-quiet-gallery .story .eyebrow-row{flex-direction:column;align-items:flex-start;gap:22px}
body.skin-quiet-gallery .story .eyebrow-row .ic{width:40px;height:40px}
body.skin-quiet-gallery .story .lead{font-weight:300;font-size:26px;color:var(--wine)}
body.skin-quiet-gallery .story .ph{background:repeating-linear-gradient(135deg,#ECE3D3 0 8px,#F3ECDF 8px 16px);border:0;color:var(--faint)}
body.skin-quiet-gallery .story .thread{color:var(--wine)}
/* quotes: no boxes */
body.skin-quiet-gallery .quotes .h2{font:500 11px/1.5 var(--body);letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
body.skin-quiet-gallery .quotes .grid{gap:40px}
body.skin-quiet-gallery .quotes .quote{border:0;padding:0}
body.skin-quiet-gallery .quotes blockquote{font:300 26px/1.35 var(--display);font-style:normal;color:var(--char)}
body.skin-quiet-gallery .quotes figcaption{font:500 11px/1.5 var(--body);letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
/* gifts + Cozy Club: two columns between hairlines */
body.skin-quiet-gallery .promo .grid{gap:0;border-top:1px solid var(--char)}
body.skin-quiet-gallery .promo .review{background:none;padding:40px 0}
@media(min-width:720px){body.skin-quiet-gallery .promo-l{padding-right:40px!important;border-right:1px solid var(--line)!important}body.skin-quiet-gallery .promo-r{padding-left:40px!important}}
body.skin-quiet-gallery .promo .review>.ic{width:22px;height:22px;order:0}
body.skin-quiet-gallery .promo .review .h3{font:300 40px/1.05 var(--display);color:var(--char)}
body.skin-quiet-gallery .promo .muted{color:var(--muted)}
body.skin-quiet-gallery .promo .btn.ghost{color:var(--wine)}
body.skin-quiet-gallery .promo .inline-form{border-bottom:1px solid var(--char);gap:0;max-width:460px}
body.skin-quiet-gallery .promo .inline-form input{border:0;background:transparent;padding:0}
body.skin-quiet-gallery .promo .inline-form .btn{background:none;border:0;color:var(--wine);padding:0 0 0 12px;min-height:48px}
/* brand promise: icons above, the Echo thread on top */
body.skin-quiet-gallery .promise{padding-block:24px 96px}
body.skin-quiet-gallery .promise .thread{display:block;color:var(--wine);margin-bottom:44px}
body.skin-quiet-gallery .promise-grid{gap:40px}
body.skin-quiet-gallery .promise-it{flex-direction:column;gap:12px}
body.skin-quiet-gallery .promise-it .ic{width:38px;height:38px}
body.skin-quiet-gallery .promise-tx .pt{font:500 11px/1.5 var(--body);letter-spacing:.2em;color:var(--char)}
body.skin-quiet-gallery .promise-tx .pd{color:var(--muted)}
/* footer: Linen, charcoal text, Wine emblem */
body.skin-quiet-gallery footer.site{background:#F1E9DA;color:var(--char)}
body.skin-quiet-gallery footer.site a{color:var(--char)}
body.skin-quiet-gallery footer .knit-divider{display:none}
body.skin-quiet-gallery .fcols h4{font:500 11px/1.5 var(--body);letter-spacing:.2em;color:var(--faint)}
body.skin-quiet-gallery .fbrand{color:var(--muted)}
body.skin-quiet-gallery .fbrand .emblem{width:76px;height:76px;color:var(--wine)}
body.skin-quiet-gallery .legal{border-top-color:#DCCFB9;color:var(--muted)}
body.skin-quiet-gallery .payments span{border-color:#CDBFA8;color:var(--char)}
body.skin-quiet-gallery .payments span.first{color:#fff}
body.skin-quiet-gallery .certrow a:has(.certlogo){background:var(--paper)}
/* product page */
body.skin-quiet-gallery .gallery .main{background:#F1E9DA;padding:clamp(20px,3vw,40px)}
body.skin-quiet-gallery .gallery .main.pic img{position:absolute;inset:clamp(20px,3vw,40px);width:calc(100% - 2*clamp(20px,3vw,40px));height:calc(100% - 2*clamp(20px,3vw,40px))}
body.skin-quiet-gallery .crumbs{font:500 11px/1.5 var(--body);letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
body.skin-quiet-gallery .buybox{gap:22px!important}
body.skin-quiet-gallery .buybox h1.h2{font:300 clamp(44px,4.8vw,64px)/.98 var(--display);color:var(--char)}
body.skin-quiet-gallery .csw{color:var(--muted)}
body.skin-quiet-gallery .csw[aria-current] .csw-img{outline-color:var(--char)}
body.skin-quiet-gallery .edition{background:none;border:0;border-top:1px solid var(--gold);border-bottom:1px solid var(--line);padding:14px 0;font-size:14px}
body.skin-quiet-gallery .edition>.ic{width:20px;height:20px}
body.skin-quiet-gallery .ticks{font-size:13px}
body.skin-quiet-gallery .ticks .ic{width:20px;height:20px}
body.skin-quiet-gallery .qty{border-color:var(--char)}
body.skin-quiet-gallery details.acc summary{color:var(--char);font-weight:500}
body.skin-quiet-gallery .care-ic{gap:18px}
body.skin-quiet-gallery .care-ic .ic{width:26px;height:26px}
body.skin-quiet-gallery .passport-band{background:#F1E9DA;color:var(--char);position:relative;isolation:isolate}
body.skin-quiet-gallery .passport-band::before{content:"";position:absolute;inset:0;z-index:-1;background-color:#E8DECC;-webkit-mask:url({{ tx_chart }}) 0 0/120px 120px repeat;mask:url({{ tx_chart }}) 0 0/120px 120px repeat}
body.skin-quiet-gallery .passport-band .knit-divider{display:none}
body.skin-quiet-gallery .passport-band h2{color:var(--char)!important;font-weight:300!important;font-style:normal!important}
body.skin-quiet-gallery .passport-band .mono{color:var(--faint)}
body.skin-quiet-gallery .passport-band .ic{color:var(--wine)}
body.skin-quiet-gallery .passport-band .passport b{color:var(--faint)}
body.skin-quiet-gallery .passport-band .passport span{color:var(--muted)}
body.skin-quiet-gallery .passport-band a{color:var(--wine)!important}
