/* ==========================================================================
   EchoByJMG · Round 1 design directions (22 Oct 2026)
   Loaded after echo.css. The body carries skin-heritage-ink, skin-swatch-studio
   or skin-quiet-gallery (Theme settings › EchoByJMG › Design direction).
   Palette (creative direction): Heritage Wine #35101D, Golden Yarn #98780D
   (#7A600A for small text), Buttercream #EFE4D0, Soft Sage #A8B9A1,
   Playful Coral #F47D68, Cornflower #86A9DB, Warm Charcoal #322C2A.
   Type: Cormorant Garamond (headings), Manrope (navigation, body).
   ========================================================================== */

{%- assign tx_st = 'echo-tx-stockinette.svg' | asset_url -%}
{%- assign tx_cable = 'echo-tx-cable.svg' | asset_url -%}
{%- assign tx_garter = 'echo-tx-garter.svg' | asset_url -%}
{%- assign tx_chart = 'echo-tx-chart.svg' | asset_url -%}
{%- assign tx_thread = 'echo-tx-thread.svg' | asset_url -%}
{%- assign tx_stitch = 'echo-tx-stitch.svg' | asset_url -%}
{%- assign tx_rib = 'echo-tx-rib.svg' | asset_url -%}

/* ---------- shared by all three directions ---------- */
body[class*="skin-"]{
  --wine:#35101D; --wine-deep:#250A14; --wine-2:#4A1A2A; --gold:#98780D; --gold-s:#7A600A; --gold-l:#D9C08A; --gold-b:#E4C46A;
  --cream:#EFE4D0; --sage:#A8B9A1; --coral:#F47D68; --corn:#86A9DB; --char:#322C2A;
  --display:'Cormorant Garamond',Georgia,serif; --head:var(--display); --body:'Manrope',system-ui,sans-serif; --mono:'Manrope',system-ui,sans-serif;
  --text:var(--char); --ink:var(--wine); --clay:var(--wine);
  --card-ground:var(--cream);
  background:var(--paper); color:var(--text);
  font:15px/1.6 var(--body);
}
body[class*="skin-"] h1,body[class*="skin-"] h2,body[class*="skin-"] h3{color:inherit}
body[class*="skin-"] .mono,body[class*="skin-"] .eyebrow{font:600 11px/1.4 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--gold-s)}
body[class*="skin-"] .h1{font:500 clamp(44px,5.6vw,80px)/1 var(--display);letter-spacing:-.005em}
body[class*="skin-"] .h2{font:500 clamp(32px,4vw,48px)/1.05 var(--display);color:var(--wine)}
body[class*="skin-"] .h3{font:600 17px/1.35 var(--body)}
body[class*="skin-"] .h1 em,body[class*="skin-"] .h2 em{font-style:italic}
body[class*="skin-"] .lead{font-size:17px;line-height:1.65;color:var(--muted)}
body[class*="skin-"] .section.alt{background:var(--white)}
body[class*="skin-"] .section.band{background:var(--soft)}
body[class*="skin-"] .section.dark{background:var(--wine);color:var(--cream)}
body[class*="skin-"] .section.dark .h2,body[class*="skin-"] .section.dark h2{color:var(--cream)}
body[class*="skin-"] .section.dark .muted{color:#D8CCB6}
body[class*="skin-"] .section.dark .mono{color:var(--gold-l)}
body[class*="skin-"] .link{color:var(--wine)}
body[class*="skin-"] .ph{background:repeating-linear-gradient(135deg,#E8DDC8 0 8px,var(--cream) 8px 16px);border-color:var(--line);color:#5A514C;font-family:var(--body)}
body[class*="skin-"] .ph.pic{background:var(--card-ground)}
body[class*="skin-"] .chip{border-color:var(--line);background:var(--white);font-size:13px}
body[class*="skin-"] .chip[aria-pressed="true"]{background:var(--wine);border-color:var(--wine);color:var(--cream)}
body[class*="skin-"] .badge{background:var(--wine);color:var(--cream);font-family:var(--body)}
body[class*="skin-"] .btn{background:var(--wine);border-color:var(--wine);color:var(--cream);font:600 12px/1 var(--body);letter-spacing:.14em;min-height:50px;padding:0 28px}
body[class*="skin-"] .btn:hover,body[class*="skin-"] .btn:focus-visible{background:transparent;color:var(--wine);box-shadow:inset 0 0 0 1px var(--wine)}
body[class*="skin-"] .btn.ghost{background:transparent;color:var(--wine)}
body[class*="skin-"] .btn.ghost:hover,body[class*="skin-"] .btn.ghost:focus-visible{background:var(--wine);color:var(--cream)}
body[class*="skin-"] .btn.mp{background:var(--mobile);border-color:var(--mobile);color:#fff}
body[class*="skin-"] :focus-visible{outline-color:var(--wine)}
body[class*="skin-"] .review{background:var(--white);border-color:var(--line)}
body[class*="skin-"] .field input,body[class*="skin-"] .field textarea,body[class*="skin-"] .field select,body[class*="skin-"] .inline-form input{border-color:var(--line);background:var(--white)}
body[class*="skin-"] .ed{color:var(--muted)}
body[class*="skin-"] .ok{background:#EEF2EB;border-color:var(--sage)}
body[class*="skin-"] .toast{background:var(--wine);color:var(--cream)}
body[class*="skin-"] .search{background:var(--paper)}
body[class*="skin-"] .search input{font-family:var(--display);border-bottom-color:var(--wine)}
body[class*="skin-"] .drawer{background:var(--white)}
body[class*="skin-"] .pagination .current{background:var(--wine);border-color:var(--wine);color:var(--cream)}
body[class*="skin-"] .tstat{border-color:var(--wine)}
body[class*="skin-"] .tstat.last{background:var(--wine);color:var(--cream)}
body[class*="skin-"] .tracker th{color:var(--gold-s);border-bottom-color:var(--wine);font-family:var(--body)}
body[class*="skin-"] .ypno,body[class*="skin-"] .ypname,body[class*="skin-"] .timeline b,body[class*="skin-"] .stat .n{font-family:var(--display)}
body[class*="skin-"] .yptop,body[class*="skin-"] .ypcard dt,body[class*="skin-"] .passport b,body[class*="skin-"] .mega h4{font-family:var(--body)}

/* header */
body[class*="skin-"] .logo .logo-ink{height:var(--logo-h,28px);width:calc(var(--logo-h,28px) * var(--logo-ar,3))}
@media(min-width:980px){body[class*="skin-"] .logo .logo-ink{height:var(--logo-h-d,40px);width:calc(var(--logo-h-d,40px) * var(--logo-ar,3))}}
body[class*="skin-"] .nav .tools .ic{width:20px;height:20px;margin-right:7px}
body[class*="skin-"] .nav .tools button,body[class*="skin-"] .nav .tools a{gap:0}
@media(max-width:719px){body[class*="skin-"] .nav .tools [data-act="search"] span:not(.ic){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}body[class*="skin-"] .nav .tools [data-act="search"] .ic{margin-right:0}}
body[class*="skin-"] .nav .main>a,body[class*="skin-"] .nav .main>button,body[class*="skin-"] .nav .tools button,body[class*="skin-"] .nav .tools a{font:600 12px/1.2 var(--body);letter-spacing:.14em;text-transform:uppercase}
body[class*="skin-"] .nav .tools b{font-weight:600}
body[class*="skin-"] .mega{background:var(--paper);color:var(--text);border-bottom-color:var(--line)}
body[class*="skin-"] .mtile .mname{font:500 21px/1.15 var(--display);color:var(--wine)}
body[class*="skin-"] .mega a{color:inherit}

/* hero */
.hero-grid{display:grid;gap:32px;align-items:center}
@media(min-width:880px){.hero-grid{grid-template-columns:1fr 1.15fr;gap:56px}}
.hero-text{gap:20px}
.hero-side{position:relative;min-width:0}
.hero .shown{justify-content:space-between;font-size:13px;text-decoration:none;margin-top:10px}
.hero-tabs{display:flex;flex-wrap:wrap}
.hero-tabs a{flex:1 1 110px;padding:14px 16px;text-decoration:none;font-size:13px}
.hero-tabs .num{display:none}
.hero .trust{gap:8px}
.hero .trust .chip{gap:7px}
.hero .trust .ic{width:20px;height:20px}
.knit-divider{display:none}

/* numbers */
.numbers>.tx{color:transparent}
.numbers .stat .ic{display:block;width:38px;height:38px;color:var(--wine);margin-bottom:14px}
.numbers .stat .n{color:var(--gold)}
.numbers .stat p{color:var(--text)}

/* steps */
.steps .step-ic{display:block;color:var(--wine)}
.steps .step-ic .ic{width:64px;height:64px;display:block}
.steps.counted{counter-reset:st}
.steps.counted .step{counter-increment:st}
.steps .num{display:block;font:italic 500 26px/1 var(--display);color:var(--gold)}
.steps.counted .num::before{content:counter(st,decimal-leading-zero)}
.step b{font:600 17px/1.35 var(--body);color:var(--wine)}

/* shop by product tiles */
.shop-by .tile .name{font:500 26px/1.1 var(--display);color:var(--wine)}
.shop-by .tile .meta{font-size:13px}

/* product card (one card per product; studio shot over the card ground) */
.pcard{gap:12px;position:relative}
.pcard .card-img{position:relative;background:var(--card-ground);aspect-ratio:4/5;overflow:hidden}
.pcard .card-img>.ph{position:absolute;inset:0;aspect-ratio:auto;min-height:0;height:100%;border:0}
.pcard .card-img .studio img{mix-blend-mode:multiply}
.pcard .card-img .hover{opacity:0;transition:opacity .25s ease}
.pcard:hover .card-img .hover,.pcard:focus-visible .card-img .hover{opacity:1}
@media(prefers-reduced-motion:reduce){.pcard .card-img .hover{transition:none}}
.pcard[data-sold] .card-img{opacity:.6}
.pcard .meta{gap:5px;font-size:13px}
.pcard .name{font:500 22px/1.15 var(--display);color:var(--wine)}
.pcard:hover .name{text-decoration:none;text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:4px}
.pcard .sub{color:var(--muted)}
.pcard .colour{white-space:nowrap}
.pcard .price-row{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.pcard .price{font-weight:700;white-space:nowrap}
.pcard .edot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--coral);margin-right:6px;vertical-align:middle}
.pcard .sticker,.pcard .lab{display:none}
.pcard .lab .ic{width:18px;height:18px;color:var(--wine);margin-right:8px}

/* story band */
.split-sec .eyebrow-row{display:flex;align-items:center;gap:12px}
.split-sec .eyebrow-row .ic{width:34px;height:34px;color:var(--wine)}
.split-sec .thread{color:var(--gold);max-width:340px}
.story .lead{font:italic 400 clamp(21px,2.2vw,25px)/1.4 var(--display);color:inherit;max-width:none}

/* quotes */
.quotes .quote{margin:0;display:flex;flex-direction:column;gap:12px;padding:20px 0 0;background:none;border:0;border-top:1px solid var(--gold)}
.quotes blockquote{margin:0;font:italic 400 22px/1.4 var(--display);color:var(--wine)}
.quotes figcaption{font-size:13px;color:var(--text)}
.quotes .stars{display:none;color:var(--gold);letter-spacing:2px}

/* gifts + Cozy Club */
.promo .review{padding:36px;display:flex;flex-direction:column;align-items:flex-start;gap:10px;border:0;overflow:hidden}
.promo .review>.ic{width:40px;height:40px;color:var(--wine)}
.promo .review .h3{font:500 34px/1.1 var(--display);color:var(--wine);margin:0!important}
.promo .review p{margin:0}
.promo .review .muted{color:var(--text)}
.promo .review form{align-self:stretch}
.promo .review>.tx{color:transparent}

/* brand promise strip */
.promise{padding-block:48px 56px}
.promise>.tx{color:transparent}
.promise .thread{display:none}
.promise-grid{display:grid;gap:32px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));color:var(--wine)}
.promise-it{display:flex;gap:16px;align-items:flex-start}
.promise-it .ic{width:46px;height:46px}
.promise-tx{display:flex;flex-direction:column;gap:6px}
.promise-tx .pt{font:600 11px/1.4 var(--body);letter-spacing:.14em;text-transform:uppercase}
.promise-tx .pd{font-size:14px;line-height:1.55;color:var(--text)}

/* footer */
body[class*="skin-"] footer.site{background:var(--wine);color:#D8CCB6}
body[class*="skin-"] footer.site a{color:var(--cream)}
body[class*="skin-"] .fcols h4{font:600 11px/1.4 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--gold-l)}
.fbrand{display:flex;flex-direction:column;gap:14px;font-size:13px;line-height:1.6}
.fbrand p{margin:0}
.fbrand .emblem{width:88px;height:88px;color:var(--cream)}
body[class*="skin-"] .legal{border-top-color:#5C2A3A;color:#CDBFA8}
body[class*="skin-"] .payments span{border-color:#6B3245;color:var(--cream)}

/* product page */
.buybox .eyebrow{color:var(--gold-s)}
.buybox h1.h2{font:500 clamp(40px,4.4vw,56px)/1.02 var(--display);color:var(--wine)}
.colour-sw{gap:12px;align-items:flex-start}
.csw{display:flex;flex-direction:column;gap:6px;width:64px;text-decoration:none;color:var(--text);font-size:12px;line-height:1.3}
.csw-img{display:block;width:64px;height:80px;background:var(--card-ground);overflow:hidden}
.csw-img img{width:100%;height:100%;object-fit:cover;display:block;mix-blend-mode:multiply}
.csw[aria-current] .csw-img{outline:2px solid var(--wine);outline-offset:2px}
.csw:hover .csw-name{text-decoration:underline}
body[class*="skin-"] .edition{display:flex;gap:14px;align-items:center;border-color:var(--wine);background:#FBF7F0;padding:16px 18px;line-height:1.55}
body[class*="skin-"] .edition>.ic{width:32px;height:32px;color:var(--wine)}
body[class*="skin-"] .qty{border-color:var(--wine)}
body[class*="skin-"] .ticks{display:flex;flex-direction:column;gap:10px;color:#4A423E;line-height:1.5}
body[class*="skin-"] .ticks li{display:flex;gap:12px;align-items:center;padding:0}
body[class*="skin-"] .ticks li::before{content:none}
body[class*="skin-"] .ticks .ic{width:24px;height:24px;color:var(--wine)}
body[class*="skin-"] details.acc{border-top-color:var(--line)}
body[class*="skin-"] details.acc:last-of-type{border-bottom-color:var(--line)}
body[class*="skin-"] details.acc summary{color:var(--wine);font:600 14px/1.4 var(--body)}
body[class*="skin-"] details.acc .body{color:#4A423E}
.care-ic{display:flex;gap:16px;color:var(--wine);margin-top:12px}
.care-ic .ic{width:32px;height:32px}
.care-note{display:block;font-size:12px;color:var(--muted);margin-top:6px}
body[class*="skin-"] .thumbs button[aria-pressed="true"]{outline-color:var(--wine)}
.passport-band .eyebrow-row{display:flex;flex-direction:column;gap:12px}
.passport-band .eyebrow-row .ic.big{width:52px;height:52px}
.passport-band .passport>div{display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--gold);padding-top:14px}
.passport-band .passport>div>.ic{width:32px;height:32px}
.passport-band .passport b{margin-bottom:0}
.passport-band h2{font-family:var(--display)!important}

/* ==========================================================================
   A · HERITAGE INK  (80% elegant / 20% playful)
   Wine header, story bands and footer; Buttercream grounds; Golden Yarn hairlines
   and numerals; square corners; caps navigation; stitch-grid band in Wine.
   ========================================================================== */
body.skin-heritage-ink{--paper:#F6EFE3;--white:#FBF7F0;--soft:#EFE4D0;--line:#DCCDB2;--muted:#5A514C;--faint:#6B625C;--warm:#7A600A;--hatch1:#E8DDC8;--hatch2:#EFE4D0}
body.skin-heritage-ink .util{background:var(--wine-deep);color:#E6DAC4;border-bottom:0}
body.skin-heritage-ink header.site{background:var(--wine);color:var(--cream)}
body.skin-heritage-ink .nav{min-height:84px;gap:28px}
body.skin-heritage-ink .nav .main [aria-current="page"],body.skin-heritage-ink .nav .main [aria-expanded="true"]{border-bottom-color:var(--gold-b)}
body.skin-heritage-ink header.site :focus-visible{outline-color:var(--cream)}
body.skin-heritage-ink .mobile-menu{background:var(--wine);border-top-color:#5C2A3A}
body.skin-heritage-ink .mobile-menu a{border-bottom-color:#5C2A3A;color:var(--cream)}
body.skin-heritage-ink .mobile-menu .sub a{color:#D8CCB6}
/* hero: Wine band, photo right, category bar under it */
body.skin-heritage-ink .hero{background:var(--wine);color:var(--cream);padding-block:clamp(40px,6vw,88px)}
body.skin-heritage-ink .hero .eyebrow{color:var(--gold-l)}
body.skin-heritage-ink .hero .h1 em{color:var(--gold-b)}
body.skin-heritage-ink .hero .lead{color:#E6DAC4;max-width:520px}
body.skin-heritage-ink .hero .btn{background:var(--cream);border-color:var(--cream);color:var(--wine)}
body.skin-heritage-ink .hero .btn:hover,body.skin-heritage-ink .hero .btn:focus-visible{background:transparent;color:var(--cream);box-shadow:inset 0 0 0 1px var(--cream)}
body.skin-heritage-ink .hero .btn.ghost{background:transparent;color:var(--cream)}
body.skin-heritage-ink .hero .btn.ghost:hover{background:var(--cream);color:var(--wine)}
body.skin-heritage-ink .hero :focus-visible{outline-color:var(--cream)}
body.skin-heritage-ink .hero .trust{border-top:1px solid #5C2A3A;padding-top:16px;gap:24px}
body.skin-heritage-ink .hero .trust .chip{background:none;border:0;padding:0;min-height:0;color:#D8CCB6}
body.skin-heritage-ink .hero .trust .ic{color:var(--cream)}
body.skin-heritage-ink .hero .shown .muted,body.skin-heritage-ink .hero .shown .link{color:#D8CCB6}
body.skin-heritage-ink .hero-tabs{background:var(--wine-deep)}
body.skin-heritage-ink .hero-tabs a{color:#CDBFA8;border-top:2px solid transparent}
body.skin-heritage-ink .hero-tabs a[aria-current]{color:var(--cream);border-top-color:var(--gold-b)}
body.skin-heritage-ink .knit-divider{display:block;height:12px;background-color:var(--wine);background-image:url({{ tx_stitch }});background-size:16px 13px}
/* knit row under section headings */
body.skin-heritage-ink .section:not(.dark):not(.hero) h2.h2::after{content:"";display:block;width:66px;height:12px;margin-top:14px;background-color:var(--gold);-webkit-mask:url({{ tx_st }}) 0 0/13.2px 12px repeat-x;mask:url({{ tx_st }}) 0 0/13.2px 12px repeat-x}
body.skin-heritage-ink .section .row>h2.h2::after{display:block}
/* numbers between gold rules */
body.skin-heritage-ink .numbers.band{background:var(--paper)}
body.skin-heritage-ink .numbers .stats{border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);padding-block:32px;gap:32px}
body.skin-heritage-ink .numbers .stat .n{font:500 56px/1 var(--display)}
/* how it works: centred, joined by a running stitch */
body.skin-heritage-ink .steps{position:relative;gap:40px}
body.skin-heritage-ink .step{border-top:0;padding-top:0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;position:relative}
body.skin-heritage-ink .step .muted{max-width:320px;color:var(--text)}
body.skin-heritage-ink .step-ic{background:var(--paper);padding:0 14px;position:relative;z-index:1}
body.skin-heritage-ink .step-ic .ic{width:72px;height:72px}
@media(min-width:760px){body.skin-heritage-ink .steps:has(.has-ic)::before{content:"";position:absolute;left:17%;right:17%;top:36px;border-top:2px dashed var(--gold)}}
body.skin-heritage-ink #how h2,body.skin-heritage-ink .section[id="how"] .h2{text-align:center}
body.skin-heritage-ink .section[id="how"] .h2::after{margin-inline:auto}
/* shop by: Buttercream with stockinette behind */
body.skin-heritage-ink .shop-by{background:var(--cream);position:relative;isolation:isolate;padding-block:72px}
body.skin-heritage-ink .shop-by::before{content:"";position:absolute;inset:0;z-index:-1;background-color:#E6D7BC;-webkit-mask:url({{ tx_st }}) 0 0/22px 20px repeat;mask:url({{ tx_st }}) 0 0/22px 20px repeat}
/* cards */
body.skin-heritage-ink .pcard .card-img{--card-ground:var(--cream)}
/* story band */
body.skin-heritage-ink .story{background:var(--wine);color:var(--cream);padding-block:80px}
body.skin-heritage-ink .story .mono{color:var(--gold-l)}
body.skin-heritage-ink .story .eyebrow-row .ic{color:var(--cream)}
body.skin-heritage-ink .story .h2{color:var(--cream)}
body.skin-heritage-ink .story .caption{color:#D8CCB6}
body.skin-heritage-ink .story .btn.ghost{color:var(--cream);border-color:var(--cream)}
body.skin-heritage-ink .story .btn.ghost:hover{background:var(--cream);color:var(--wine)}
body.skin-heritage-ink .story .ph{background:repeating-linear-gradient(135deg,var(--wine-2) 0 8px,#3F1524 8px 16px);color:#E6DAC4;border:0}
body.skin-heritage-ink .story :focus-visible{outline-color:var(--cream)}
/* quotes */
body.skin-heritage-ink .quotes .h2{text-align:center}
body.skin-heritage-ink .quotes .h2::after{margin-inline:auto}
/* gifts + Cozy Club */
body.skin-heritage-ink .promo-l{background:var(--cream)}
body.skin-heritage-ink .promo-r{background:var(--sage)}
body.skin-heritage-ink .promo-r>.tx{color:rgba(31,42,28,.10);-webkit-mask:url({{ tx_garter }}) 0 0/16px 10px repeat;mask:url({{ tx_garter }}) 0 0/16px 10px repeat}
body.skin-heritage-ink .promo .mono{color:var(--wine)}
body.skin-heritage-ink .promo-l .mono{color:var(--gold-s)}
body.skin-heritage-ink .promo-r .muted{color:#2A2422}
body.skin-heritage-ink .promo-r input{border-color:var(--wine);background:var(--paper)}
/* brand promise */
body.skin-heritage-ink .promise{border-top:1px solid var(--gold)}
/* footer */
body.skin-heritage-ink .knit-divider+.fcols,body.skin-heritage-ink footer .knit-divider{background-color:#2A0C17}
/* product page */
body.skin-heritage-ink .gallery .main{background:var(--wine);padding:16px}
body.skin-heritage-ink .gallery .main.pic img{position:absolute;inset:16px;width:calc(100% - 32px);height:calc(100% - 32px)}
body.skin-heritage-ink .passport-band{padding-top:0}
