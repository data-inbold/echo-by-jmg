{% doc %}
  @prompt
    Just add a space here for an image section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-space-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-space-{{ ai_gen_id }}__frame {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    overflow: hidden;
    background: #f3f1ed;
  }

  .ai-image-space-{{ ai_gen_id }}__image,
  .ai-image-space-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-space-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #77736e;
  }

  .ai-image-space-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    margin: 0;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.94);
    color: #282828;
    text-align: center;
    font-size: 13px;
  }
{% endstyle %}

<div class="ai-image-space-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-space-{{ ai_gen_id }}__frame">
    {% if block.settings.image != blank %}
      <img
        class="ai-image-space-{{ ai_gen_id }}__image"
        src="{{ block.settings.image | image_url: width: 2400 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-image-space-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
      <p class="ai-image-space-{{ ai_gen_id }}__empty-state">Add an image in the block settings to fill this space.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image space",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" },
        { "value": "3 / 4", "label": "Portrait" }
      ],
      "default": "4 / 3"
    }
  ],
  "presets": [
    {
      "name": "Image space"
    }
  ],
  "tag": null,
  "class": "image-space-block"
}
{% endschema %}